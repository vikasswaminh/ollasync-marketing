---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
interface Props { title: string; description: string; updated: string; crumb: string; noindex?: boolean; }
const { title, description, updated, crumb, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <PageHero eyebrow="Legal" eyebrowIcon="doc" crumbs={[{ label: crumb }]} title={title} lead={`Last updated ${updated}.`} />
  <section class="section" style="padding-block:36px 64px">
    <div class="container legal panel" data-reveal style="padding:clamp(28px,4vw,48px);border:1.5px solid #e2e8f0;border-radius:var(--r-xl);background:#ffffff;box-shadow:0 4px 18px -2px rgba(15,23,42,0.05)">
      <slot />
    </div>
  </section>
</Base>
<style is:global>
  .legal { max-width: 820px; margin-inline: auto; }
  .legal h2 { font-size: 22px; margin-top: 40px; color: var(--ink); font-weight: 800; }
  .legal h2:first-child { margin-top: 0; }
  .legal h3 { font-size: 17px; margin-top: 26px; color: var(--ink); font-weight: 750; }
  .legal p, .legal li { color: var(--ink-2); font-size: 15.5px; line-height: 1.75; }
  .legal p { margin-top: 14px; }
  .legal ul { margin: 14px 0 0 20px; display: grid; gap: 8px; }
  .legal a { color: #0284c7; font-weight: 600; }
  .legal strong { color: var(--ink); font-weight: 700; }
  .legal .note { margin-top: 20px; padding: 16px 20px; border: 1.5px solid #e2e8f0; border-left: 4px solid #0284c7; border-radius: var(--r-sm); background: #f8fafc; font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }
</style>
