---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'blog'>[];
}
const { post, headings, related } = Astro.props;
const d = post.data;
const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const cover = d.cover || d.heroImage || '/og-classroom.jpg';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: new URL(cover, SITE.url).href,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  author: { '@type': /\b(team|ollasync)\b/i.test(d.author) ? 'Organization' : 'Person', name: d.author }, // the visible byline, typed by what it names
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/og-ollasync.png', SITE.url).href } },
  mainEntityOfPage: new URL(`/blog/${post.slug}/`, SITE.url).href, // the canonical form (directory URLs end with a slash)
};
---
<Base title={d.title} description={d.description} ogType="article" ogImage={cover} schema={schema}>
  <article class="post">
    <header class="post__head section" style="padding-block:40px 8px">
      <div class="container">
        <div style="max-width:880px">
          <div style="margin-bottom:18px"><Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: d.category, href: `/blog?category=${d.category}` }, { label: d.title }]} /></div>
          <span class={`chip cat cat--${d.category.toLowerCase()}`}>{d.category}{d.pillar && <> · Pillar guide</>}</span>
          <h1 class="display" style="font-size:clamp(30px,4.4vw,46px);line-height:1.18;margin-top:16px">{d.title}</h1>
          <p class="lead" style="margin-top:16px">{d.description}</p>
          <div class="post__meta">
            <span>{d.author}</span>{d.authorRole && <span class="post__role">({d.authorRole})</span>}<span class="dot">·</span>
            <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>{d.updatedDate && <><span class="dot">·</span><span>updated <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></span></>}<span class="dot">·</span>
            <span>{d.readTime} min read</span>
          </div>
        </div>
      </div>
    </header>

    <div class="container post__cover-wrap">
      <img class="post__cover" src={cover} alt={d.title} width="1600" height="540" loading="eager" />
    </div>

    <div class="container post__grid">
      <aside class="post__sidebar">
        <div class="post__sidebar-inner">
          {toc.length > 0 && (
            <div class="sidebar-card toc-card">
              <details class="post__toc-details" open>
                <summary class="post__toc-summary">
                  <div class="sidebar-header">
                    <span class="sidebar-badge"><Icon name="route" size={13} stroke="var(--blue)" /> Guide Navigation</span>
                    <span class="toc-chevron" aria-hidden="true">▾</span>
                  </div>
                </summary>
                <nav class="sidebar-nav" aria-label="Table of contents">
                  <ul class="sidebar-nav__list">
                    {toc.map((h) => (
                      <li class={`sidebar-nav__item ${h.depth === 3 ? 'sidebar-nav__item--sub' : ''}`}>
                        <a href={`#${h.slug}`} class="sidebar-nav__link">
                          <span class="nav-indicator" aria-hidden="true"></span>
                          <span class="nav-text">{h.text}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </details>
            </div>
          )}

          <div class="sidebar-card promo-card">
            <span class="sidebar-badge sidebar-badge--teal"><Icon name="shield-check" size={13} stroke="var(--teal)" /> Enterprise Alternative</span>
            <h4 class="promo-card__title">Deploy Ollasync AI Meetings</h4>
            <p class="promo-card__desc">Browser-native video meetings with live voice translation, automated meeting minutes, and zero add-on license traps.</p>
            <div class="promo-card__actions">
              <a href={SITE.appUrl} class="btn btn-primary btn-sm promo-btn">Try Ollasync Free <span class="arrow">→</span></a>
              <a href="/vs/microsoft-teams" class="promo-link">Compare Teams vs Ollasync</a>
            </div>
          </div>

          <div class="sidebar-card meta-card">
            <div class="meta-row">
              <span class="meta-label">Author</span>
              <span class="meta-value">{d.author}</span>
            </div>
            {d.authorRole && (
              <div class="meta-row">
                <span class="meta-label">Role</span>
                <span class="meta-value">{d.authorRole}</span>
              </div>
            )}
            <div class="meta-row">
              <span class="meta-label">Published</span>
              <span class="meta-value">{fmt(d.pubDate)}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Est. Read</span>
              <span class="meta-value">{d.readTime} min</span>
            </div>
          </div>
        </div>
      </aside>

      <div class="post__body">
        {d.takeaways.length > 0 && (
          <div class="takeaways">
            <h2 style="font-size:15px;margin:0;display:flex;align-items:center;gap:8px"><Icon name="zap" size={16} stroke="var(--teal)" /> Key takeaways</h2>
            <ul>
              {d.takeaways.map((t) => <li><span class="tick"><Icon name="check" size={11} stroke="var(--teal)" /></span>{t}</li>)}
            </ul>
          </div>
        )}
        <div class="prose-post">
          <slot />
        </div>
        {d.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-h">
            <h2 id="sources-h">Sources</h2>
            <ol>
              {d.sources.map((s) => (
                <li><a href={s.url} rel="noopener">{s.publisher}</a> — {s.claim} <span class="muted">(accessed {s.accessDate})</span></li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-top:40px">
        <div class="container">
          <h2 class="h3" style="margin-bottom:20px">Related reading</h2>
          <div class="related">
            {related.map((r) => (
              <a href={`/blog/${r.slug}/`} class="card card--hover related__card">
                <span class="chip cat" style="align-self:flex-start">{r.data.category}</span>
                <h3 style="font-size:16.5px;font-weight:600;margin-top:12px">{r.data.title}</h3>
                <p class="muted" style="font-size:13.5px;margin-top:6px">{r.data.description.slice(0, 110)}…</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  <Cta
    title={d.category === 'Comparisons' ? 'Cut AI meeting costs by up to 64%.' : undefined}
    sub={d.category === 'Comparisons' ? 'Ollasync delivers browser-based video meetings with real-time translation, transcription, and automated AI summaries without costly add-on license traps.' : undefined}
    primary={d.category === 'Comparisons' ? { label: 'Start free with Ollasync', href: SITE.appUrl } : undefined}
    secondary={d.category === 'Comparisons' ? { label: 'Book an enterprise demo', href: '/contact' } : undefined}
  />
</Base>

<script is:inline>
  // Collapse TOC on small screens initially
  if (window.innerWidth <= 1024) {
    const tocEl = document.querySelector('.post__toc-details');
    if (tocEl) tocEl.removeAttribute('open');
  }

  // Scrollspy observer for active section in TOC
  document.addEventListener('DOMContentLoaded', () => {
    const headings = Array.from(document.querySelectorAll('.prose-post h2, .prose-post h3'));
    const tocLinks = Array.from(document.querySelectorAll('.sidebar-nav__link'));
    if (!headings.length || !tocLinks.length) return;

    const linkMap = new Map();
    tocLinks.forEach((link) => {
      const hash = link.getAttribute('href');
      if (hash && hash.startsWith('#')) {
        linkMap.set(hash.slice(1), link);
      }
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (id && linkMap.has(id)) {
            tocLinks.forEach((l) => l.classList.remove('is-active'));
            linkMap.get(id).classList.add('is-active');
          }
        }
      });
    }, { rootMargin: '-90px 0px -70% 0px' });

    headings.forEach((h) => observer.observe(h));
  });
</script>

<style>
  .cat { font-family: var(--font-mono); font-size: 11.5px; color: var(--blue); border-color: var(--violet-300); background: var(--violet-050); }
  .cat--cryptography { color: var(--blue); }
  .cat--compliance { color: var(--teal); border-color: var(--teal-150); background: var(--teal-050); }
  .cat--self-hosting { color: var(--blue); }
  .post__meta { display: flex; align-items: center; gap: 10px; margin-top: 22px; font-size: 14px; color: var(--muted); }
  .post__meta .dot { color: var(--line-2); }
  .post__role { font-family: var(--font-mono); font-size: 12px; color: var(--muted-2); }
  .post__cover-wrap { margin-top: 24px; }
  .post__cover { width: 100%; border-radius: var(--r-lg); border: 1.5px solid var(--line-2); max-height: 480px; object-fit: cover; }
  
  /* Layout: 2-column with sticky sidebar matching landing page style */
  .post__grid { display: grid; grid-template-columns: 290px 1fr; gap: 40px; margin-top: 40px; align-items: start; }
  .post__sidebar { position: relative; }
  .post__sidebar-inner { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 20px; max-height: calc(100vh - 100px); overflow-y: auto; padding-right: 4px; }
  .post__sidebar-inner::-webkit-scrollbar { width: 4px; }
  .post__sidebar-inner::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 4px; }

  /* Sidebar Cards */
  .sidebar-card { background: var(--panel); border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 18px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04); }
  .toc-card { padding: 0; overflow: hidden; }
  .sidebar-header { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  
  .sidebar-badge { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--blue); padding: 4px 10px; background: var(--violet-050); border: 1px solid var(--violet-300); border-radius: var(--r-pill); }
  .sidebar-badge--teal { color: var(--teal); background: var(--teal-050); border-color: var(--teal-150); }

  .post__toc-summary { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; cursor: pointer; user-select: none; }
  .post__toc-summary::-webkit-details-marker { display: none; }
  .toc-chevron { font-size: 13px; color: var(--muted-2); transition: transform 0.2s ease; }
  .post__toc-details[open] .toc-chevron { transform: rotate(180deg); }

  .sidebar-nav { padding: 4px 14px 18px 14px; border-top: 1px solid var(--line); }
  .sidebar-nav__list { list-style: none; display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
  .sidebar-nav__item { list-style: none; }
  .sidebar-nav__item--sub { padding-left: 12px; }
  .sidebar-nav__link { display: flex; align-items: center; gap: 9px; padding: 6px 10px; border-radius: var(--r-sm); font-size: 13px; color: var(--muted); line-height: 1.4; transition: all 0.15s ease; }
  .sidebar-nav__link:hover { color: var(--ink); background: var(--bg-2); }
  .sidebar-nav__link.is-active { color: var(--blue); background: var(--violet-050); font-weight: 600; }
  .nav-indicator { width: 5px; height: 5px; border-radius: 50%; background: var(--line-2); flex-shrink: 0; transition: all 0.15s ease; }
  .sidebar-nav__link:hover .nav-indicator { background: var(--muted); }
  .sidebar-nav__link.is-active .nav-indicator { background: var(--blue); box-shadow: 0 0 0 2px var(--violet-150); }

  /* Promo Card in Sidebar */
  .promo-card { background: linear-gradient(180deg, var(--panel), var(--bg-2)); border-color: var(--line-2); }
  .promo-card__title { font-size: 15px; font-weight: 700; color: var(--ink); margin-top: 12px; line-height: 1.3; }
  .promo-card__desc { font-size: 13px; color: var(--muted); line-height: 1.5; margin-top: 8px; }
  .promo-card__actions { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
  .promo-btn { width: 100%; justify-content: center; font-size: 13.5px; padding: 8px 14px; }
  .promo-link { font-size: 12.5px; color: var(--muted); text-align: center; text-decoration: underline; text-underline-offset: 3px; }
  .promo-link:hover { color: var(--blue); }

  /* Meta Card in Sidebar */
  .meta-card { display: flex; flex-direction: column; gap: 10px; background: var(--bg-2); border-color: var(--line-2); }
  .meta-row { display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; }
  .meta-label { color: var(--muted-2); font-family: var(--font-mono); font-size: 11.5px; }
  .meta-value { color: var(--ink); font-weight: 600; text-align: right; }

  /* Post Body & Takeaways */
  .post__body { min-width: 0; }
  .takeaways { border: 1.5px solid var(--teal-150); background: var(--teal-050); border-radius: var(--r-lg); padding: 22px 24px; margin-bottom: 34px; box-shadow: 0 1px 2px rgba(15, 138, 95, 0.05); }
  .takeaways ul { list-style: none; display: grid; gap: 10px; margin-top: 14px; }
  .takeaways li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--ink-2); line-height: 1.55; }
  .takeaways .tick { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--teal-150); flex: none; margin-top: 2px; }

  .sources { margin-top: 40px; border-top: 1px solid var(--line); padding-top: 24px; }
  .sources h2 { font-size: 20px; color: var(--ink); }
  .sources ol { padding-left: 20px; display: grid; gap: 8px; margin-top: 12px; font-size: 14.5px; color: var(--ink-2); }
  .sources a { color: var(--iris); }
  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .related__card { display: flex; flex-direction: column; }

  @media (min-width: 1025px) {
    .post__toc-summary { cursor: default; }
    .post__toc-summary .toc-chevron { display: none; }
  }

  @media (max-width: 1024px) {
    .post__grid { grid-template-columns: 1fr; gap: 24px; }
    .post__sidebar { display: block; }
    .post__sidebar-inner { position: static; max-height: none; overflow-y: visible; padding-right: 0; gap: 16px; }
    .post__toc-summary { cursor: pointer; }
    .sidebar-nav__list { max-height: 300px; overflow-y: auto; }
    .related { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .post__head { padding-block: 28px 6px !important; }
    .post__meta { flex-wrap: wrap; row-gap: 6px; font-size: 12.5px; }
    .post__cover-wrap { margin-top: 18px; }
    .prose-post { font-size: 16px; line-height: 1.7; }
    .prose-post > * + * { margin-top: 18px; }
    .prose-post h1 { font-size: 26px; margin-top: 36px; }
    .prose-post h2 { font-size: 22px; margin-top: 32px; }
    .prose-post h3 { font-size: 18px; margin-top: 24px; }
    .prose-post h4 { font-size: 15.5px; margin-top: 20px; }
    .prose-post ul, .prose-post ol { padding-left: 18px; }
    .takeaways { padding: 16px 16px; }
    .sources ol { font-size: 14px; }
  }
</style>

<style is:global>
  /* Long-form article typography */
  .prose-post { font-size: 17px; line-height: 1.75; color: var(--ink-2); }
  .prose-post > * + * { margin-top: 22px; }
  .prose-post h1 { font-size: 32px; letter-spacing: -.025em; color: var(--ink); margin-top: 48px; line-height: 1.25; scroll-margin-top: 96px; }
  .prose-post h2 { font-size: 26px; letter-spacing: -.02em; color: var(--ink); margin-top: 46px; scroll-margin-top: 96px; line-height: 1.3; }
  .prose-post h3 { font-size: 20px; color: var(--ink); margin-top: 32px; scroll-margin-top: 96px; line-height: 1.35; }
  .prose-post h4 { font-size: 17px; font-weight: 600; color: var(--ink); margin-top: 24px; scroll-margin-top: 96px; }
  .prose-post p { color: var(--ink-2); }
  .prose-post a { color: var(--iris); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--violet-300); }
  .prose-post a:hover { text-decoration-color: var(--iris); }
  .prose-post strong { color: var(--ink); font-weight: 600; }
  .prose-post ul, .prose-post ol { padding-left: 22px; display: grid; gap: 10px; }
  .prose-post li { color: var(--ink-2); }
  .prose-post li::marker { color: var(--iris); }
  .prose-post blockquote { border-left: 3px solid var(--iris); padding: 8px 0 8px 20px; margin-left: 0; color: var(--ink); font-size: 17.5px; font-style: italic; background: var(--violet-050); border-radius: 0 var(--r) var(--r) 0; }
  .prose-post code { font-family: var(--font-mono); font-size: .88em; background: var(--bg-2); padding: 2px 6px; border-radius: 5px; color: var(--blue); }
  .prose-post pre { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--r); padding: 18px; overflow-x: auto; }
  .prose-post pre code { background: none; padding: 0; color: var(--ink-2); }
  .prose-post img { border-radius: var(--r); border: 1px solid var(--line); margin-block: 10px; }
  .prose-post hr { border: 0; border-top: 1px solid var(--line); margin-block: 36px; }

  /* Callouts & Comparison cards */
  .prose-post .callout { border: 1px solid var(--line-2); border-left: 4px solid var(--iris); background: var(--violet-050); border-radius: 8px; padding: 18px 20px; font-size: 15.5px; line-height: 1.65; }
  .prose-post .callout-warning { border-left-color: #f59e0b; background: #fffbeb; }
  .prose-post .callout-success { border-left-color: var(--teal); background: var(--teal-050); }
  .prose-post .callout p:last-child { margin-bottom: 0; }

  /* Tables: responsive scroll with zebra-striping */
  .prose-post table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14.5px; display: block; overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; margin-block: 24px; }
  .prose-post th, .prose-post td { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line-soft); padding: 12px 14px; text-align: left; }
  .prose-post th:last-child, .prose-post td:last-child { border-right: none; }
  .prose-post tr:last-child td { border-bottom: none; }
  .prose-post th { background: var(--bg-2); font-weight: 600; color: var(--ink); white-space: nowrap; font-size: 13.5px; }
  .prose-post tbody tr:nth-child(even) { background: rgba(0, 0, 0, 0.015); }
  .prose-post tbody tr:hover { background: rgba(99, 102, 241, 0.04); }
</style>
