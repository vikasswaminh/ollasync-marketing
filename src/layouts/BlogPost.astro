---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'blog'>[];
}
const { post, headings, related } = Astro.props;
const d = post.data;
const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);
const cover = d.cover || '/og-ollasync.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: new URL(cover, SITE.url).href,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/og-ollasync.png', SITE.url).href } },
  mainEntityOfPage: new URL(`/blog/${post.slug}`, SITE.url).href,
};
---
<Base title={d.title} description={d.description} ogType="article" ogImage={cover} schema={schema}>
  <article class="post">
    <header class="post__head section" style="padding-block:48px 16px">
      <div class="container post__head-container">
        <div style="margin-bottom:18px"><Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: d.category, href: `/blog?category=${d.category}` }, { label: d.title }]} /></div>
        <span class={`chip cat cat--${d.category.toLowerCase()}`}>{d.category}{d.pillar && <> · Pillar guide</>}</span>
        <h1 class="display post__title">{d.title}</h1>
        <p class="lead post__desc">{d.description}</p>
        <div class="post__meta">
          <span style="font-weight:650;color:var(--ink)">{d.author}</span><span class="dot">·</span>
          <span>{fmt(d.pubDate)}</span><span class="dot">·</span>
          <span>{d.readTime} min read</span>
        </div>
      </div>
    </header>

    <div class="container post__cover-wrap">
      <img class="post__cover" src={cover} alt={d.title} width="1320" height="560" loading="eager" />
    </div>

    <div class="container post__grid">
      {toc.length > 0 && (
        <aside class="post__toc">
          <div class="post__toc-inner">
            <div class="toc-header">
              <span class="toc-dot"></span>
              <span class="eyebrow-label">On this page</span>
            </div>
            <nav>
              <ul class="toc-list">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? 'sub' : ''}>
                    <a href={`#${h.slug}`} class="toc-link">
                      <span class="toc-bar"></span>
                      <span class="toc-text">{h.text}</span>
                    </a>
                  </li>
                ))}
                {related.length > 0 && (
                  <li>
                    <a href="#related-reading" class="toc-link">
                      <span class="toc-bar"></span>
                      <span class="toc-text">Related reading</span>
                    </a>
                  </li>
                )}
              </ul>
            </nav>
          </div>
        </aside>
      )}

      <div class="post__body">
        {d.takeaways.length > 0 && (
          <div class="takeaways">
            <h2 style="font-size:16.5px;margin:0;display:flex;align-items:center;gap:8px"><Icon name="zap" size={18} stroke="#00bfa5" /> Key takeaways</h2>
            <ul>
              {d.takeaways.map((t) => <li><span class="tick"><Icon name="check" size={12} stroke="#00bfa5" /></span>{t}</li>)}
            </ul>
          </div>
        )}
        <div class="prose-post">
          <slot />
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-top:54px">
        <div class="container post__related-container">
          <h2 class="h3" id="related-reading" style="margin-bottom:24px;scroll-margin-top:96px">Related reading</h2>
          <div class="related">
            {related.map((r) => (
              <a href={`/blog/${r.slug}`} class="card card--hover related__card">
                <span class="chip cat" style="align-self:flex-start">{r.data.category}</span>
                <h3 style="font-size:17.5px;font-weight:700;margin-top:14px;line-height:1.3">{r.data.title}</h3>
                <p class="muted" style="font-size:14px;margin-top:8px;line-height:1.5">{r.data.description.slice(0, 115)}…</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  <Cta />
</Base>

<style>
  .post__head-container {
    max-width: 1080px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .post__title {
    font-size: clamp(32px, 4.6vw, 54px);
    margin-top: 18px;
    max-width: 1040px;
    line-height: 1.12;
    text-align: center;
    text-wrap: balance;
  }
  .post__desc {
    margin-top: 18px;
    max-width: 920px;
    font-size: clamp(16px, 1.4vw, 19.5px);
    line-height: 1.6;
    text-align: center;
    color: var(--muted);
    text-wrap: pretty;
  }
  
  .cat { font-family: var(--font-mono); font-size: 11.5px; color: var(--purple); border-color: rgba(124, 58, 237, 0.25); background: rgba(124, 58, 237, 0.06); }
  .cat--cryptography { color: var(--purple); border-color: rgba(124, 58, 237, 0.25); background: rgba(124, 58, 237, 0.06); }
  .cat--compliance { color: #0f766e; border-color: rgba(0, 191, 165, 0.3); background: rgba(0, 191, 165, 0.08); }
  .cat--self-hosting, .cat--self-hosted { color: #0369a1; border-color: rgba(2, 132, 199, 0.25); background: rgba(2, 132, 199, 0.06); }
  .post__meta { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 22px; font-size: 14px; color: var(--muted); }
  .post__meta .dot { color: var(--border); }
  
  .post__cover-wrap { max-width: 1320px; margin-top: 36px; }
  .post__cover { width: 100%; border-radius: var(--r-lg); border: 1px solid var(--border); box-shadow: 0 10px 36px rgba(15, 23, 42, 0.07); aspect-ratio: 21/9; object-fit: cover; }
  
  /* Grid & Layout - Expanded to 1320px width */
  .post__grid { max-width: 1320px; display: grid; grid-template-columns: 240px 1fr; gap: 52px; margin-top: 52px; align-items: start; }
  .post__body { min-width: 0; width: 100%; }
  
  /* TOC Sticky Sidebar - Compact and Scrollable */
  .post__toc {
    position: sticky;
    top: 96px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-right: 6px;
  }
  .post__toc::-webkit-scrollbar { width: 4px; }
  .post__toc::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  
  .post__toc-inner { background: rgba(255, 255, 255, 0.02); padding: 16px 14px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--r, 12px); }
  
  .toc-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .toc-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 8px rgba(0, 191, 165, 0.7); flex: none; }
  .post__toc .eyebrow-label { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink); }
  
  .toc-list { list-style: none; display: grid; gap: 3px; margin: 0; padding: 0; border-left: 2px solid rgba(255, 255, 255, 0.08); }
  .toc-link { display: block; font-size: 12.5px; font-weight: 550; color: var(--muted); padding: 5px 10px; margin-left: -2px; border-left: 2px solid transparent; border-radius: 0 4px 4px 0; transition: all var(--dur) var(--ease); line-height: 1.4; text-decoration: none; }
  .toc-bar { display: none; }
  .toc-link:hover { background: rgba(0, 191, 165, 0.08); color: var(--cyan); border-left-color: var(--cyan); font-weight: 650; }
  .post__toc .sub .toc-link { padding-left: 18px; font-size: 12px; }

  /* Key takeaways */
  .takeaways { border: 1px solid rgba(0, 191, 165, 0.35); background: rgba(0, 191, 165, 0.05); border-radius: var(--r); padding: 24px 26px; margin-bottom: 38px; }
  .takeaways h2 { color: var(--ink); font-weight: 750; }
  .takeaways ul { list-style: none; display: grid; gap: 12px; margin-top: 14px; }
  .takeaways li { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; color: var(--ink-2); line-height: 1.55; }
  .takeaways .tick { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: rgba(0, 191, 165, 0.18); flex: none; margin-top: 2px; }

  /* Related Reading */
  .post__related-container { max-width: 1320px; }
  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .related__card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--r); padding: 22px; transition: all var(--dur) var(--ease); }
  .related__card:hover { border-color: var(--cyan); transform: translateY(-3px); }

  @media (max-width: 1024px) {
    .post__grid { grid-template-columns: 1fr; gap: 32px; }
    .post__toc { display: none; }
    .related { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  /* Long-form article typography */
  .prose-post { font-size: 17px; line-height: 1.8; color: var(--ink-2); }
  .prose-post > * + * { margin-top: 24px; }
  .prose-post h2 { font-size: 26px; letter-spacing: -.02em; color: var(--ink); margin-top: 48px; scroll-margin-top: 96px; font-weight: 800; }
  .prose-post h3 { font-size: 20px; color: var(--ink); margin-top: 34px; scroll-margin-top: 96px; font-weight: 750; }
  .prose-post h4 { font-size: 17px; color: var(--ink); margin-top: 24px; scroll-margin-top: 96px; font-weight: 700; }
  .prose-post p { color: var(--ink-2); }
  .prose-post a { color: #5b92ff; text-decoration: none; font-weight: 550; transition: color var(--dur) ease; }
  .prose-post a:hover { color: #82adff; text-decoration: underline; }
  .prose-post strong { color: var(--ink); font-weight: 700; }
  .prose-post ul, .prose-post ol { padding-left: 22px; display: grid; gap: 10px; }
  .prose-post li { color: var(--ink-2); }
  .prose-post li::marker { color: var(--cyan); }
  .prose-post blockquote { border-left: 4px solid var(--cyan); padding: 6px 0 6px 20px; margin-left: 0; color: var(--ink); font-size: 18px; font-style: italic; background: rgba(0, 191, 165, 0.04); border-radius: 0 var(--r-sm) var(--r-sm) 0; }
  .prose-post code { font-family: var(--font-mono); font-size: .88em; background: rgba(255,255,255,0.06); padding: 2px 7px; border-radius: 5px; color: var(--purple); border: 1px solid var(--border); }
  .prose-post pre { background: #0f172a; border: 1px solid #1e293b; border-radius: var(--r); padding: 18px; overflow-x: auto; color: #f8fafc; }
  .prose-post pre code { background: none; padding: 0; color: #e2e8f0; border: none; }
  .prose-post img { border-radius: var(--r); border: 1px solid var(--border); margin-block: 14px; }
  .prose-post hr { border: 0; border-top: 1px solid var(--border); margin-block: 36px; }
  .prose-post .callout { border: 1px solid rgba(0, 191, 165, 0.4); border-left: 4px solid var(--cyan); background: rgba(0, 191, 165, 0.07); border-radius: var(--r-sm); padding: 18px 20px; font-size: 16px; color: var(--ink); font-weight: 500; }
  .prose-post table { width: 100%; border-collapse: collapse; font-size: 14.5px; display: block; overflow-x: auto; margin-block: 22px; border-radius: var(--r-sm); border: 1px solid var(--border); }
  .prose-post th, .prose-post td { border: 1px solid var(--border); padding: 12px 14px; text-align: left; }
  .prose-post th { background: rgba(255,255,255,0.04); color: var(--ink); font-weight: 750; }
  .prose-post td { background: transparent; color: var(--ink-2); }
</style>
