---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'blog'>[];
}
const { post, headings, related } = Astro.props;
const d = post.data;
const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);
const cover = d.cover || '/og-ollasync.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: new URL(cover, SITE.url).href,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/og-ollasync.png', SITE.url).href } },
  mainEntityOfPage: new URL(`/blog/${post.slug}`, SITE.url).href,
};
---
<Base title={d.title} description={d.description} ogType="article" ogImage={cover} schema={schema}>
  <article class="post">
    <header class="post__head section" style="padding-block:40px 8px">
      <div class="container" style="max-width:780px">
        <div style="margin-bottom:18px"><Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: d.category, href: `/blog?category=${d.category}` }, { label: d.title }]} /></div>
        <span class={`chip cat cat--${d.category.toLowerCase()}`}>{d.category}{d.pillar && <> · Pillar guide</>}</span>
        <h1 class="display" style="font-size:clamp(30px,4.4vw,46px);margin-top:16px">{d.title}</h1>
        <p class="lead" style="margin-top:16px">{d.description}</p>
        <div class="post__meta">
          <span>{d.author}</span><span class="dot">·</span>
          <span>{fmt(d.pubDate)}</span><span class="dot">·</span>
          <span>{d.readTime} min read</span>
        </div>
      </div>
    </header>

    <div class="container post__cover-wrap" style="max-width:960px">
      <img class="post__cover" src={cover} alt={d.title} width="960" height="420" loading="eager" />
    </div>

    <div class="container post__grid" style="max-width:960px">
      {toc.length > 0 && (
        <aside class="post__toc">
          <div class="post__toc-inner">
            <span class="eyebrow-label">On this page</span>
            <nav>
              <ul>
                {toc.map((h) => <li class={h.depth === 3 ? 'sub' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ul>
            </nav>
          </div>
        </aside>
      )}

      <div class="post__body">
        {d.takeaways.length > 0 && (
          <div class="takeaways">
            <h2 style="font-size:15px;margin:0;display:flex;align-items:center;gap:8px"><Icon name="zap" size={16} stroke="#a9f2d1" /> Key takeaways</h2>
            <ul>
              {d.takeaways.map((t) => <li><span class="tick"><Icon name="check" size={11} stroke="#3ddc97" /></span>{t}</li>)}
            </ul>
          </div>
        )}
        <div class="prose-post">
          <slot />
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-top:40px">
        <div class="container" style="max-width:960px">
          <h2 class="h3" style="margin-bottom:20px">Related reading</h2>
          <div class="related">
            {related.map((r) => (
              <a href={`/blog/${r.slug}`} class="card card--hover related__card">
                <span class="chip cat" style="align-self:flex-start">{r.data.category}</span>
                <h3 style="font-size:16.5px;font-weight:600;margin-top:12px">{r.data.title}</h3>
                <p class="muted" style="font-size:13.5px;margin-top:6px">{r.data.description.slice(0, 110)}…</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  <Cta />
</Base>

<style>
  .cat { font-family: var(--font-mono); font-size: 11.5px; color: #cfc6ff; border-color: var(--violet-300); background: var(--violet-050); }
  .cat--cryptography { color: #cfc6ff; }
  .cat--compliance { color: #a9f2d1; border-color: var(--teal-150); background: var(--teal-050); }
  .cat--self-hosting { color: #9fc6ff; }
  .post__meta { display: flex; align-items: center; gap: 10px; margin-top: 22px; font-size: 14px; color: var(--muted); }
  .post__meta .dot { color: var(--line-2); }
  .post__cover-wrap { margin-top: 30px; }
  .post__cover { width: 100%; border-radius: var(--r-lg); border: 1px solid var(--line); aspect-ratio: 16/7; object-fit: cover; }
  .post__grid { display: grid; grid-template-columns: 220px 1fr; gap: 44px; margin-top: 44px; align-items: start; }
  .post__toc-inner { position: sticky; top: 96px; }
  .post__toc nav ul { list-style: none; display: grid; gap: 9px; margin-top: 12px; border-left: 1px solid var(--line); }
  .post__toc a { font-size: 13.5px; color: var(--muted); display: block; padding-left: 14px; margin-left: -1px; border-left: 2px solid transparent; }
  .post__toc a:hover { color: var(--ink); border-left-color: var(--iris); }
  .post__toc .sub a { padding-left: 26px; font-size: 13px; }

  .takeaways { border: 1px solid var(--teal-150); background: var(--teal-050); border-radius: var(--r); padding: 20px 22px; margin-bottom: 30px; }
  .takeaways ul { list-style: none; display: grid; gap: 10px; margin-top: 14px; }
  .takeaways li { display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; color: var(--ink-2); }
  .takeaways .tick { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--teal-150); flex: none; margin-top: 1px; }

  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .related__card { display: flex; flex-direction: column; }
  @media (max-width: 860px) {
    .post__grid { grid-template-columns: 1fr; gap: 24px; }
    .post__toc { display: none; }
    .related { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  /* Long-form article typography */
  .prose-post { font-size: 17px; line-height: 1.75; color: var(--ink-2); }
  .prose-post > * + * { margin-top: 22px; }
  .prose-post h2 { font-size: 26px; letter-spacing: -.02em; color: var(--ink); margin-top: 46px; scroll-margin-top: 96px; }
  .prose-post h3 { font-size: 20px; color: var(--ink); margin-top: 32px; scroll-margin-top: 96px; }
  .prose-post p { color: var(--ink-2); }
  .prose-post a { color: var(--iris); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--violet-300); }
  .prose-post a:hover { text-decoration-color: var(--iris); }
  .prose-post strong { color: var(--ink); }
  .prose-post ul, .prose-post ol { padding-left: 22px; display: grid; gap: 10px; }
  .prose-post li { color: var(--ink-2); }
  .prose-post li::marker { color: var(--iris); }
  .prose-post blockquote { border-left: 3px solid var(--iris); padding: 4px 0 4px 20px; margin-left: 0; color: var(--ink); font-size: 18px; }
  .prose-post code { font-family: var(--font-mono); font-size: .88em; background: rgba(255,255,255,.06); padding: 2px 6px; border-radius: 5px; color: #cfc6ff; }
  .prose-post pre { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--r); padding: 18px; overflow-x: auto; }
  .prose-post pre code { background: none; padding: 0; color: var(--ink-2); }
  .prose-post img { border-radius: var(--r); border: 1px solid var(--line); margin-block: 10px; }
  .prose-post hr { border: 0; border-top: 1px solid var(--line); margin-block: 34px; }
  .prose-post .callout { border: 1px solid var(--line-2); border-left: 3px solid var(--iris); background: var(--violet-050); border-radius: 8px; padding: 16px 18px; font-size: 15.5px; }
  .prose-post table { width: 100%; border-collapse: collapse; font-size: 14.5px; display: block; overflow-x: auto; }
  .prose-post th, .prose-post td { border: 1px solid var(--line); padding: 10px 12px; text-align: left; }
  .prose-post th { background: rgba(255,255,255,.03); }
</style>
