---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'blog'>[];
}
const { post, headings, related } = Astro.props;
const d = post.data;
const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const toc = headings ? headings.filter((h) => h.depth === 2 || h.depth === 3) : [];
const cover = d.cover || '/og-ollasync.png';
const takeaways = d.takeaways || [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: new URL(cover, SITE.url).href,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/og-ollasync.png', SITE.url).href } },
  mainEntityOfPage: new URL(`/blog/${post.slug}`, SITE.url).href,
};
---
<Base title={d.title} description={d.description} ogType="article" ogImage={cover} schema={schema}>
  <article class="post">
    <!-- HERO HEADER -->
    <header class="post__head section-hero-page">
      <div class="container post__head-container">
        <div class="post__top-nav">
          <Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: d.category, href: `/blog?category=${encodeURIComponent(d.category)}` }, { label: d.title }]} />
          <span class={`chip cat cat--${d.category.toLowerCase().replace(/[^a-z0-9]/g, '')}`}>{d.category}{d.pillar && <> · Pillar guide</>}</span>
        </div>
        <h1 class="display post__title">{d.title}</h1>
        <p class="lead post__desc">{d.description}</p>
        <div class="post__meta">
          <span style="font-weight:700;color:var(--ink)">{d.author}</span>
          <span class="dot">·</span>
          <span>{fmt(d.pubDate)}</span>
          <span class="dot">·</span>
          <span>{d.readTime} min read</span>
        </div>
      </div>
    </header>

    <!-- 3-COLUMN ARTICLE BODY SECTION -->
    <section class="section post__section" style="padding-block: 48px 80px;">
      <div class={`container post__grid-3col ${toc.length === 0 ? 'no-toc' : ''} ${!related || related.length === 0 ? 'no-related' : ''}`}>
        
        <!-- LEFT COLUMN: TABLE OF CONTENTS -->
        {toc.length > 0 && (
          <aside class="post__toc-sidebar" data-lenis-prevent>
            <div class="sidebar-panel sidebar-panel--toc" data-lenis-prevent>
              <div class="pill-badge pill-badge--teal">
                <span>On This Page</span>
              </div>
              <nav aria-label="Table of contents" class="toc-nav" data-lenis-prevent>
                <ul class="toc-list">
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'sub' : ''}>
                      <a href={`#${h.slug}`} class="toc-link" data-toc-slug={h.slug}>
                        <span class="toc-text">{h.text}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>
        )}

        <!-- MIDDLE COLUMN: MAIN ARTICLE TEXT -->
        <main class="post__main-content">
          {cover && (
            <div class="post__cover-wrap">
              <img class="post__cover" src={cover} alt={d.title} width="1200" height="560" loading="eager" />
            </div>
          )}

          {takeaways.length > 0 && (
            <div class="takeaways">
              <h2 class="takeaways__title">
                <Icon name="zap" size={18} stroke="#0d9488" /> Key takeaways
              </h2>
              <ul class="takeaways__list">
                {takeaways.map((t) => (
                  <li>
                    <span class="tick"><Icon name="check" size={12} stroke="#0d9488" /></span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="prose-post">
            <slot />
          </div>
        </main>

        <!-- RIGHT COLUMN: RELATED READING -->
        {related && related.length > 0 && (
          <aside class="post__related-sidebar" data-lenis-prevent>
            <div class="sidebar-panel" data-lenis-prevent>
              <div class="pill-badge pill-badge--purple">
                <span>Related Reading</span>
              </div>
              <div class="related-sidebar-list">
                {related.slice(0, 4).map((r) => (
                  <a href={`/blog/${r.slug}`} class="related-card-mini">
                    <span class="rc-cat">{r.data.category}</span>
                    <h4 class="rc-title">{r.data.title}</h4>
                    <div class="rc-footer">
                      <span class="rc-time">{r.data.readTime} min read</span>
                      <span class="rc-read">Read &rarr;</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </aside>
        )}

      </div>
    </section>
  </article>
  <Cta />
</Base>

<script>
  // Active TOC highlight and scroll observation
  document.addEventListener('DOMContentLoaded', () => {
    const headings = Array.from(document.querySelectorAll('.prose-post h2, .prose-post h3')) as HTMLElement[];
    const tocLinks = Array.from(document.querySelectorAll('.toc-link')) as HTMLAnchorElement[];
    if (!headings.length || !tocLinks.length) return;

    const linkMap = new Map<string, HTMLAnchorElement>();
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-toc-slug');
      if (slug) linkMap.set(slug, link);
    });

    let currentActive: HTMLAnchorElement | null = null;

    const onScroll = () => {
      const scrollY = window.scrollY;
      let activeHeading: HTMLElement | null = null;

      for (let i = 0; i < headings.length; i++) {
        const h = headings[i];
        const top = h.getBoundingClientRect().top + scrollY - 140;
        if (scrollY >= top) {
          activeHeading = h;
        } else {
          break;
        }
      }

      if (!activeHeading && headings.length) {
        activeHeading = headings[0];
      }

      if (activeHeading) {
        const id = activeHeading.getAttribute('id') || activeHeading.id;
        const link = linkMap.get(id);
        if (link && link !== currentActive) {
          if (currentActive) currentActive.classList.remove('active');
          link.classList.add('active');
          currentActive = link;
          // Ensure the active link is visible within the TOC scroll container
          const tocNav = document.querySelector('.toc-nav');
          if (tocNav) {
            const linkRect = link.getBoundingClientRect();
            const navRect = tocNav.getBoundingClientRect();
            if (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom) {
              (link as HTMLElement).scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }
        }
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>

<style>
  .section-hero-page {
    position: relative;
    padding-block: 48px 36px;
    background: linear-gradient(180deg, #f0fdfb 0%, #e0f2fe 35%, #f8f7f4 100%);
    border-bottom: 1px solid #eae7df;
  }
  .post__head-container {
    max-width: 1100px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .post__top-nav {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 14px;
  }
  .post__title {
    font-size: clamp(28px, 4.2vw, 48px);
    margin-top: 0;
    max-width: 960px;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    color: var(--ink);
  }
  .post__desc {
    margin-top: 16px;
    max-width: 820px;
    font-size: clamp(16px, 1.35vw, 18.5px);
    line-height: 1.6;
    text-align: center;
    color: var(--muted);
    text-wrap: pretty;
  }
  
  .cat { font-family: var(--font-mono); font-size: 11px; font-weight: 700; color: #6d28d9; border: 1px solid rgba(124, 58, 237, 0.25); background: rgba(124, 58, 237, 0.08); padding: 4px 12px; border-radius: 100px; }
  .post__meta { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 22px; font-size: 14px; color: var(--muted); font-family: var(--font-mono); font-weight: 550; }
  .post__meta .dot { color: #cbd5e1; }
  
  /* 3-Column Editorial Grid Layout */
  .post__section {
    background: #ffffff;
  }
  .post__grid-3col {
    max-width: 1420px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 290px;
    gap: 44px;
    align-items: start;
  }
  .post__grid-3col.no-toc {
    grid-template-columns: minmax(0, 1fr) 290px;
  }
  .post__grid-3col.no-related {
    grid-template-columns: 240px minmax(0, 1fr);
  }
  .post__grid-3col.no-toc.no-related {
    grid-template-columns: minmax(0, 860px);
    justify-content: center;
  }

  /* Sidebar Panels (TOC & Related Reading) */
  .post__toc-sidebar,
  .post__related-sidebar {
    position: sticky;
    top: 96px;
  }

  .sidebar-panel {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 18px;
    padding: 22px 18px;
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04);
  }

  /* Scrollable TOC Panel */
  .sidebar-panel--toc {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 124px);
    overflow: hidden;
  }

  .toc-nav {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-right: 4px;
    margin-right: -4px;
    flex: 1;
    min-height: 0;
  }
  .toc-nav::-webkit-scrollbar { width: 4px; }
  .toc-nav::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

  /* Pill Badges in Ollasync logo brand gradient (Teal -> Blue) */
  .pill-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-mono);
    margin-bottom: 14px;
    flex-shrink: 0;
  }
  .pill-badge--teal {
    color: #0f766e;
    border: 1.5px solid rgba(0, 191, 165, 0.4);
    background: linear-gradient(135deg, rgba(0, 191, 165, 0.16) 0%, rgba(2, 132, 199, 0.12) 100%);
  }
  .pill-badge--purple {
    color: #0284c7;
    border: 1.5px solid rgba(2, 132, 199, 0.35);
    background: linear-gradient(135deg, rgba(0, 191, 165, 0.12) 0%, rgba(2, 132, 199, 0.14) 100%);
  }

  /* Table of Contents list */
  .toc-list { list-style: none; display: grid; gap: 4px; margin: 0; padding: 0; }
  .toc-link {
    display: block;
    font-size: 13px;
    font-weight: 550;
    color: #475569;
    padding: 7px 12px;
    border-radius: 0 8px 8px 0;
    transition: all 0.18s ease;
    line-height: 1.45;
    text-decoration: none;
    border-left: 3px solid transparent;
  }
  .toc-link:hover {
    background: linear-gradient(135deg, rgba(0, 191, 165, 0.08) 0%, rgba(2, 132, 199, 0.08) 100%);
    color: #0f766e;
    font-weight: 650;
  }
  .toc-link.active {
    background: linear-gradient(135deg, rgba(0, 191, 165, 0.15) 0%, rgba(2, 132, 199, 0.15) 100%);
    color: #0e7490;
    font-weight: 750;
    border-left: 3px solid #00bfa5;
    box-shadow: inset 0 0 0 1px rgba(0, 191, 165, 0.2);
  }
  .toc-list .sub .toc-link {
    padding-left: 20px;
    font-size: 12px;
    color: #64748b;
  }
  .toc-list .sub .toc-link.active {
    color: #0e7490;
  }

  /* Middle Content Column */
  .post__main-content {
    min-width: 0;
    width: 100%;
  }

  .post__cover-wrap {
    width: 100%;
    margin-bottom: 32px;
    border-radius: 14px;
    overflow: hidden;
  }
  .post__cover {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    border-radius: 14px;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.06);
  }

  /* Key Takeaways Box with Teal/Blue Logo Gradient */
  .takeaways {
    border: 1.5px solid rgba(0, 191, 165, 0.4);
    background: linear-gradient(135deg, rgba(0, 191, 165, 0.08) 0%, rgba(2, 132, 199, 0.06) 100%);
    border-radius: 14px;
    padding: 24px 28px;
    margin-bottom: 36px;
  }
  .takeaways__title {
    font-size: 17px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 800;
  }
  .takeaways__list {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 14px;
    padding: 0;
  }
  .takeaways__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
  }
  .takeaways .tick {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(0, 191, 165, 0.25) 0%, rgba(2, 132, 199, 0.2) 100%);
    color: #0d9488;
    flex: none;
    margin-top: 2px;
  }

  /* Related Reading Cards Mini (Right Sidebar) with Teal-Blue Gradient */
  .related-sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .related-card-mini {
    display: flex;
    flex-direction: column;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    background: linear-gradient(145deg, #ffffff 0%, #f0fdfa 100%);
    padding: 16px 18px;
    text-decoration: none;
    transition: all 0.22s ease;
    box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.03);
    position: relative;
    overflow: hidden;
  }
  .related-card-mini::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, #00bfa5 0%, #0284c7 100%);
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .related-card-mini:hover {
    border-color: rgba(0, 191, 165, 0.5);
    background: linear-gradient(145deg, #ffffff 0%, rgba(0, 191, 165, 0.08) 0%, rgba(2, 132, 199, 0.09) 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -4px rgba(0, 191, 165, 0.18);
  }
  .related-card-mini:hover::before {
    opacity: 1;
  }
  .rc-cat {
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0d9488;
    font-family: var(--font-mono);
  }
  .rc-title {
    font-size: 13.5px;
    font-weight: 750;
    line-height: 1.35;
    color: var(--ink);
    margin-top: 6px;
    margin-bottom: 10px;
    transition: color 0.2s ease;
  }
  .related-card-mini:hover .rc-title {
    color: #0f766e;
  }
  .rc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: auto;
  }
  .rc-read {
    color: #0284c7;
    font-weight: 750;
    transition: all 0.2s ease;
  }
  .related-card-mini:hover .rc-read {
    color: #0d9488;
    transform: translateX(3px);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1240px) {
    .post__grid-3col {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 32px;
    }
    .post__related-sidebar {
      grid-column: 1 / -1;
      position: static;
      max-height: none;
      margin-top: 40px;
    }
    .related-sidebar-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 860px) {
    .post__grid-3col {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .post__toc-sidebar {
      display: none;
    }
  }
</style>

<style is:global>
  /* Long-form article typography - clean, readable, no boxed padding */
  .prose-post { font-size: 17px; line-height: 1.8; color: var(--ink-2); }
  .prose-post > * + * { margin-top: 24px; }
  .prose-post h2 { font-size: 26px; letter-spacing: -.02em; color: var(--ink); margin-top: 48px; scroll-margin-top: 96px; font-weight: 800; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px; }
  .prose-post h3 { font-size: 20px; color: var(--ink); margin-top: 36px; scroll-margin-top: 96px; font-weight: 750; }
  .prose-post h4 { font-size: 17px; color: var(--ink); margin-top: 24px; scroll-margin-top: 96px; font-weight: 700; }
  .prose-post p { color: var(--ink-2); font-size: 16.5px; line-height: 1.75; }
  .prose-post a { color: #0284c7; text-decoration: none; font-weight: 600; transition: color var(--dur) ease; border-bottom: 1px solid rgba(2, 132, 199, 0.3); }
  .prose-post a:hover { color: #00bfa5; border-bottom-color: #00bfa5; }
  .prose-post strong { color: var(--ink); font-weight: 700; }
  .prose-post ul, .prose-post ol { padding-left: 24px; display: grid; gap: 10px; margin-block: 16px; }
  .prose-post li { color: var(--ink-2); line-height: 1.65; }
  .prose-post li::marker { color: var(--cyan); font-weight: 700; }
  .prose-post blockquote { border-left: 4px solid var(--cyan); padding: 12px 20px; margin-left: 0; color: var(--ink); font-size: 17.5px; font-style: italic; background: rgba(0, 191, 165, 0.05); border-radius: 0 var(--r-sm) var(--r-sm) 0; }
  .prose-post code { font-family: var(--font-mono); font-size: .88em; background: #f1f5f9; padding: 3px 8px; border-radius: 6px; color: #0f766e; border: 1px solid #e2e8f0; font-weight: 600; }
  .prose-post pre { background: #0f172a; border: 1px solid #1e293b; border-radius: var(--r-lg); padding: 20px; overflow-x: auto; color: #f8fafc; margin-block: 24px; }
  .prose-post pre code { background: none; padding: 0; color: #e2e8f0; border: none; }
  .prose-post img { border-radius: var(--r-lg); border: 1.5px solid #e2e8f0; margin-block: 20px; max-width: 100%; height: auto; }
  .prose-post hr { border: 0; border-top: 1px solid #e2e8f0; margin-block: 40px; }
  .prose-post .callout { border: 1.5px solid rgba(0, 191, 165, 0.35); border-left: 4px solid #00bfa5; background: rgba(0, 191, 165, 0.06); border-radius: var(--r-sm); padding: 20px 24px; font-size: 16px; color: var(--ink); font-weight: 500; margin-block: 24px; }
  .prose-post table { width: 100%; border-collapse: collapse; font-size: 14.5px; display: block; overflow-x: auto; margin-block: 24px; border-radius: var(--r-sm); border: 1.5px solid #e2e8f0; background: #ffffff; }
  .prose-post th, .prose-post td { border: 1px solid #e2e8f0; padding: 12px 16px; text-align: left; }
  .prose-post th { background: #f8fafc; color: var(--ink); font-weight: 750; }
  .prose-post td { background: #ffffff; color: var(--ink-2); }

  /* FAQ Accordion / Details Dropdown in Teal/Greenish + Blue Logo Gradient */
  .prose-post details.faq-item {
    border: 1.5px solid #e2e8f0;
    border-left: 4px solid #cbd5e1;
    border-radius: 12px;
    background: #ffffff;
    padding: 16px 20px;
    margin-block: 14px;
    transition: all 0.22s ease;
    box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.03);
  }
  .prose-post details.faq-item:hover {
    border-color: rgba(0, 191, 165, 0.4);
    border-left-color: #00bfa5;
    background: linear-gradient(145deg, #ffffff 0%, rgba(0, 191, 165, 0.05) 40%, rgba(2, 132, 199, 0.06) 100%);
    box-shadow: 0 4px 16px -3px rgba(0, 191, 165, 0.15);
  }
  .prose-post details.faq-item[open] {
    border-color: rgba(2, 132, 199, 0.35);
    border-left: 4px solid #00bfa5;
    background: linear-gradient(145deg, #ffffff 0%, rgba(0, 191, 165, 0.06) 0%, rgba(2, 132, 199, 0.08) 100%);
    box-shadow: 0 6px 20px -4px rgba(0, 191, 165, 0.18);
  }
  .prose-post details.faq-item summary {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: color 0.18s ease;
  }
  .prose-post details.faq-item summary::-webkit-details-marker {
    display: none;
  }
  .prose-post details.faq-item summary::after {
    content: '';
    display: inline-block;
    width: 9px;
    height: 9px;
    border-right: 2.2px solid #00bfa5;
    border-bottom: 2.2px solid #0284c7;
    transform: rotate(-45deg);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
    margin-right: 4px;
  }
  .prose-post details.faq-item[open] summary::after {
    transform: rotate(45deg);
    border-right-color: #0284c7;
    border-bottom-color: #00bfa5;
  }
  .prose-post details.faq-item summary:hover {
    color: #0f766e;
  }
  .prose-post details.faq-item p,
  .prose-post details.faq-item > div {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 15.5px;
