---
import { FOOTER, SITE } from '../consts';
import BrandMark from './BrandMark.astro';
import { LANG_COUNT } from '../data/languages';
---
<footer class="footer">
  <div class="container--wide">
    <div class="footer__grid">
      <div>
        <a href="/" class="brand" aria-label="Ollasync home">
          <BrandMark size={28} class="brand__mark" />
          {SITE.name}
        </a>
        <p class="muted" style="margin-top:16px;font-size:14px;max-width:290px;line-height:1.6">
          An AI classroom for trainers, tutors and coaches — run live classes while AI translates
          your voice and writes the class notes.
        </p>
        <div class="footer__badges" style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px">
          <span class="badge-soft">{LANG_COUNT} languages</span>
          <span class="badge-soft">AI meeting notes</span>
          <span class="badge-soft">Runs in the browser</span>
        </div>
      </div>
      {FOOTER.map((col) => (
        <div>
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} {SITE.name}. Meetings with live translation and AI notes.</span>
      <span class="mono" style="font-size:12px">Live translation · AI meeting notes</span>
    </div>
  </div>
</footer>
