---
import { FOOTER, SITE } from '../consts';
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a href="/" class="brand" aria-label="Ollasync home">
          <span class="brand__mark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="4" y="10.5" width="16" height="10" rx="2.6" stroke="#fff" stroke-width="1.9"/><path d="M7.5 10.5V8a4.5 4.5 0 0 1 9 0v2.5" stroke="#fff" stroke-width="1.9"/></svg>
          </span>
          {SITE.name}
        </a>
        <p class="muted" style="margin-top:16px;font-size:14px;max-width:290px;line-height:1.6">
          End-to-end encrypted meetings, webinars and deal rooms — self-hostable and EU-hosted.
          Server-blind by design.
        </p>
        <div class="footer__badges" style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px">
          <span class="badge-soft">E2E encrypted</span>
          <span class="badge-soft">EU-hosted</span>
          <span class="badge-soft">Self-host ready</span>
        </div>
      </div>
      {FOOTER.map((col) => (
        <div>
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} {SITE.name}. Built for teams that can’t trust the cloud.</span>
      <span class="mono" style="font-size:12px">Encrypted in your browser · we only ever see ciphertext</span>
    </div>
  </div>
</footer>
