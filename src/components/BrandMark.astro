---
// The OllaSync mark: a camera inside a rounded-square frame, with a dot sitting in a notch cut out of
// the frame's top-right corner. Geometry measured off the master logo artwork (490-unit square box)
// rather than eyeballed. Same paths as public/favicon.svg — scripts/build-brand-icons.mjs rasterises
// that file into favicon.ico, apple-touch-icon.png and logo.png, so change both together.
// Replaces the blue ring, which belonged to the previous branding.
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
---
<svg
  width={size} height={size} viewBox="0 0 490 490" fill="#C51208"
  class={cls} aria-hidden="true" focusable="false"
>
  <path fill-rule="evenodd" d="M124 64H330A124 124 0 0 1 382.3 75.6A65 65 0 0 0 438 127A124 124 0 0 1 454 188V348A124 124 0 0 1 330 472H124A124 124 0 0 1 0 348V188A124 124 0 0 1 124 64ZM137 147H317A58 58 0 0 1 375 205V333A58 58 0 0 1 317 391H137A58 58 0 0 1 79 333V205A58 58 0 0 1 137 147Z" />
  <rect x="137" y="212" width="125" height="114" rx="20" />
  <path d="M260 249L313.8 215.4Q324 209 324 221V316Q324 328 313.8 321.6L260 288Z" />
  <circle cx="446" cy="62.5" r="44" />
</svg>
