---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  class?: string;
  width?: number;
  height?: number;
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, sizes = '100vw', widths = [320, 640, 960, 1200], loading = 'lazy', class: className, width, height, fetchpriority } = Astro.props;
// Blog frontmatter stores public URLs. Import those files as assets so Astro can transform them.
const images = import.meta.glob<{ default: ImageMetadata }>('../../public/*.{jpg,jpeg,png,webp}', { eager: true });
const image = images[`../../public${src}`]?.default;
const targetWidth = image ? Math.min(width ?? image.width, image.width) : undefined;
const responsiveWidths = image ? [...new Set(widths.filter((w) => w > 0 && w <= image.width).concat(targetWidth!))].sort((a, b) => a - b) : [];
---
{image ? (
  <Image
    src={image}
    alt={alt}
    widths={responsiveWidths}
    sizes={sizes}
    width={targetWidth}
    height={height && width ? Math.round(height * targetWidth! / width) : undefined}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
    format="webp"
    quality={80}
  />
) : (
  <img src={src} alt={alt} sizes={undefined} width={width} height={height} loading={loading} fetchpriority={fetchpriority} class={className} />
)}
