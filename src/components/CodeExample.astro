---
---

<section class="py-24 bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Deploy in Minutes
        </h2>
        <p class="text-slate-400 text-lg mb-8">
          Get started with Docker Compose. Complete monitoring stack included with Prometheus, Grafana, and Alertmanager.
        </p>
        <ul class="space-y-4">
          <li class="flex items-start">
            <svg class="w-6 h-6 text-primary-500 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-slate-300">4 microservices with health checks</span>
          </li>
          <li class="flex items-start">
            <svg class="w-6 h-6 text-primary-500 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-slate-300">TiKV, NATS, MinIO dependencies</span>
          </li>
          <li class="flex items-start">
            <svg class="w-6 h-6 text-primary-500 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-slate-300">Pre-configured Grafana dashboards</span>
          </li>
        </ul>
      </div>
      
      <div class="bg-slate-950 rounded-xl overflow-hidden border border-slate-800">
        <div class="flex items-center px-4 py-3 bg-slate-800 border-b border-slate-700">
          <div class="flex space-x-2">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <span class="ml-4 text-sm text-slate-400 font-mono">terminal</span>
        </div>
        <div class="p-4 overflow-x-auto">
          <pre class="text-sm font-mono text-slate-300"><code><span class="text-slate-500"># Clone and deploy</span>
<span class="text-primary-400">git</span> clone https://github.com/vikasswaminh/quick.git
<span class="text-primary-400">cd</span> quick

<span class="text-slate-500"># Generate certificates and secrets</span>
<span class="text-primary-400">./scripts/generate-certs.sh</span>
<span class="text-primary-400">./scripts/generate-secrets.sh</span> >> .env

<span class="text-slate-500"># Deploy with monitoring stack</span>
<span class="text-primary-400">docker-compose</span> up -d

<span class="text-slate-500"># Access Grafana dashboards</span>
<span class="text-slate-400">open http://localhost:3000</span></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
