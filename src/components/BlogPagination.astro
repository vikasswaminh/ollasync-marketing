---
interface Props {
  page: number;
  totalPages: number;
  baseUrl: string;
}
const { page, totalPages, baseUrl } = Astro.props;
const pageUrl = (n: number) => n === 1 ? baseUrl : `${baseUrl}page/${n}/`;
---
{totalPages > 1 && (
  <nav class="blog-pagination" aria-label="Article pages">
    {page > 1 ? <a rel="prev" href={pageUrl(page - 1)}>← Previous</a> : <span aria-hidden="true">← Previous</span>}
    <span class="blog-pagination__pages">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
        n === page ? <span aria-current="page">{n}</span> : <a href={pageUrl(n)} aria-label={`Page ${n}`}>{n}</a>
      ))}
    </span>
    {page < totalPages ? <a rel="next" href={pageUrl(page + 1)}>Next →</a> : <span aria-hidden="true">Next →</span>}
  </nav>
)}
<style>
  .blog-pagination { display:flex; align-items:center; justify-content:center; gap: 18px; flex-wrap:wrap; margin: 42px 0 0; }
  .blog-pagination__pages { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; }
  .blog-pagination a, .blog-pagination span { padding: 8px 10px; border-radius: 8px; }
  .blog-pagination a { color: var(--iris); }
  .blog-pagination a:hover { text-decoration: underline; }
  .blog-pagination [aria-current="page"] { background: var(--bg-2); font-weight:700; }
</style>
