---
// The floating "encrypted call" visual — 4 participant tiles with real faces.
import Icon from './Icon.astro';
const tiles = [
  { img: '/hero-face-jane.png', name: 'Jane D.', bg: 'linear-gradient(140deg,#3b2f66,#5b4b9e)', alt: 'Jane on an end-to-end encrypted Ollasync video call in 4K' },
  { img: '/hero-face-bob.png', name: 'Bob S.', bg: 'linear-gradient(140deg,#25405e,#3d6b8f)', alt: 'Bob on an end-to-end encrypted Ollasync video call in 4K' },
  { img: '/hero-face-aisha.png', name: 'Aïsha K.', bg: 'linear-gradient(140deg,#2f5a4c,#3d8f6f)', alt: 'Aïsha on an end-to-end encrypted Ollasync video call in 4K' },
  { img: '/hero-face-you.png', name: 'You', bg: 'linear-gradient(140deg,#4a3a2f,#8a6a4a)', alt: 'You on an end-to-end encrypted Ollasync video call in 4K', me: true },
];
---
<div class="callmock">
  <div class="callmock__glow" aria-hidden="true"></div>
  <div class="callmock__float">
    <div class="panel callmock__frame">
      <div class="callmock__bar">
        <span class="callmock__label mono"><Icon name="lock" size={13} stroke="#3ddc97" /> encrypted call · 4K · 4 here</span>
        <span class="callmock__live"><span class="callmock__dot"></span>live</span>
      </div>
      <div class="callmock__grid">
        {tiles.map((t) => (
          <div class="callmock__tile" style={`background:${t.bg}`}>
            <img src={t.img} alt={t.alt} width="360" height="248" loading="eager" decoding="async" />
            <span class="callmock__name">{t.name}</span>
            {t.me && <span class="callmock__pill mono">AI noise-cancel</span>}
          </div>
        ))}
      </div>
      <div class="callmock__footer">
        <span class="callmock__ctrl" aria-hidden="true"><Icon name="mic" size={15} /></span>
        <span class="callmock__ctrl" aria-hidden="true"><Icon name="video" size={15} /></span>
        <span class="callmock__ctrl callmock__ctrl--end" aria-hidden="true"><Icon name="video" size={15} /></span>
        <span class="callmock__meta mono">Opus 48 kHz · encrypted media</span>
      </div>
    </div>
  </div>
</div>

<style>
  .callmock { position: relative; }
  .callmock__glow { position: absolute; inset: -14% -8%; background: radial-gradient(circle at 60% 40%, rgba(124,92,255,.4), transparent 60%); filter: blur(30px); z-index: -1; animation: pulseGlow 6s ease-in-out infinite; }
  .callmock__float { animation: floaty 8s ease-in-out infinite; }
  .callmock__frame { overflow: hidden; }
  .callmock__bar { display: flex; align-items: center; gap: 10px; padding: 13px 17px; border-bottom: 1px solid var(--line); }
  .callmock__label { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: #cfc6ff; }
  .callmock__live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--teal); }
  .callmock__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); animation: pulseGlow 2s infinite; }
  .callmock__grid { padding: 13px; display: grid; grid-template-columns: 1fr 1fr; gap: 11px; }
  .callmock__tile { position: relative; aspect-ratio: 16/11; border-radius: 13px; overflow: hidden; }
  .callmock__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .callmock__name { position: absolute; left: 9px; bottom: 8px; font-size: 11.5px; background: rgba(0,0,0,.5); padding: 3px 8px; border-radius: 7px; backdrop-filter: blur(4px); color: #fff; }
  .callmock__pill { position: absolute; right: 8px; top: 8px; font-size: 10px; color: #a9f2d1; background: rgba(0,0,0,.45); border: 1px solid var(--teal-150); padding: 3px 7px; border-radius: 100px; }
  .callmock__footer { display: flex; align-items: center; gap: 10px; padding: 12px 17px; border-top: 1px solid var(--line); }
  .callmock__ctrl { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: rgba(255,255,255,.06); color: var(--ink-2); }
  .callmock__ctrl--end { background: rgba(255,80,90,.16); color: #ff8a92; }
  .callmock__meta { margin-left: auto; font-size: 11px; color: var(--muted); }
</style>
