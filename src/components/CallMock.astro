---
// The encrypted call & deal room cockpit visual
import Icon from './Icon.astro';
const tiles = [
  { img: '/hero-face-jane.png', name: 'Jane Doe', role: 'General Counsel', bg: '#0f172a', active: true, alt: 'Jane on an end-to-end encrypted Ollasync video call in 4K' },
  { img: '/hero-face-bob.png', name: 'Bob Sterling', role: 'Head of M&A', bg: '#0f172a', active: false, alt: 'Bob on an end-to-end encrypted Ollasync video call in 4K' },
  { img: '/hero-face-aisha.png', name: 'Aïsha Khan', role: 'Lead Architect', bg: '#0f172a', active: false, alt: 'Aïsha on an end-to-end encrypted Ollasync video call in 4K' },
  { img: '/hero-face-you.png', name: 'You', role: 'Managing Director', bg: '#0f172a', me: true, active: false, alt: 'You on an end-to-end encrypted Ollasync video call in 4K' },
];
---
<div class="cockpit">
  <div class="cockpit__frame">
    <!-- Top Cockpit Toolbar -->
    <div class="cockpit__header">
      <div class="cockpit__mode-tabs">
        <span class="mode-tab mode-tab--active">
          <span class="dot-live"></span>
          <span>4K Video Meeting</span>
        </span>
        <span class="mode-tab">
          <Icon name="file-lock" size={13} />
          <span>Deal Room Vault</span>
        </span>
        <span class="mode-tab">
          <Icon name="chat" size={13} />
          <span>Live AI Translate</span>
        </span>
      </div>

      <div class="cockpit__security-tag mono">
        <span class="lock-pulse"><Icon name="lock" size={11} stroke="currentColor" /></span>
        <span>IETF MLS 256-BIT</span>
      </div>
    </div>

    <!-- Video Stage Grid -->
    <div class="cockpit__stage">
      <div class="cockpit__watermark mono">CONFIDENTIAL · SESSION #8829-MLS</div>

      <div class="cockpit__grid">
        {tiles.map((t) => (
          <div class={`tile ${t.active ? 'tile--active' : ''}`} style={`background:${t.bg}`}>
            <img src={t.img} alt={t.alt} width="360" height="240" loading="eager" decoding="async" />
            
            <div class="tile__top">
              {t.active && (
                <span class="tile__badge tile__badge--active mono">
                  <span class="wave-bars"><span></span><span></span><span></span></span>
                  SPEAKING · 4K
                </span>
              )}
              {t.me && (
                <span class="tile__badge tile__badge--ai mono">
                  ✨ AI Filter ON
                </span>
              )}
            </div>

            <div class="tile__bottom">
              <div class="tile__user">
                <span class="tile__name">{t.name}</span>
                <span class="tile__role mono">{t.role}</span>
              </div>
              <div class="tile__signal">
                <span class="signal-bar"></span>
                <span class="signal-bar"></span>
                <span class="signal-bar"></span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Live Encrypted Telemetry Ticker -->
    <div class="cockpit__telemetry mono">
      <span class="telemetry__item"><span class="tele-dot"></span> Relayed via Frankfurt Node (Server-Blind)</span>
      <span class="telemetry__item">14.8 Mbps · 11ms Latency · 0% Loss</span>
    </div>

    <!-- Floating Dock Controls -->
    <div class="cockpit__dock">
      <div class="dock-buttons">
        <button type="button" class="dock-btn dock-btn--active" title="Microphone Active">
          <Icon name="mic" size={15} />
        </button>
        <button type="button" class="dock-btn dock-btn--active" title="4K Camera Active">
          <Icon name="video" size={15} />
        </button>
        <button type="button" class="dock-btn" title="Share Screen">
          <Icon name="layers" size={15} />
        </button>
        <button type="button" class="dock-btn" title="Open Deal Room Documents">
          <Icon name="file-lock" size={15} />
        </button>
        <button type="button" class="dock-btn dock-btn--end" title="Leave Session">
          <Icon name="phone" size={15} />
        </button>
      </div>
      <div class="dock-meta mono">
        Opus 48 kHz · MLS Keyed
      </div>
    </div>
  </div>
</div>

<style>
  .cockpit {
    position: relative;
    width: 100%;
    margin-inline: auto;
  }

  .cockpit__frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: var(--r-xl);
    box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(0, 191, 165, 0.15);
  }

  /* Header */
  .cockpit__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
  }

  .cockpit__mode-tabs {
    display: flex;
    gap: 6px;
  }

  .mode-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 650;
    color: var(--muted);
    background: #ffffff;
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  .mode-tab--active {
    color: #0f766e;
    background: rgba(0, 191, 165, 0.1);
    border-color: rgba(0, 191, 165, 0.4);
  }

  .dot-live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00bfa5;
    animation: live-pulse 1.8s infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .cockpit__security-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    color: #0f766e;
    background: rgba(0, 191, 165, 0.08);
    border: 1px solid rgba(0, 191, 165, 0.3);
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  /* Stage */
  .cockpit__stage {
    position: relative;
    padding: 10px;
    background: #090d16;
  }

  .cockpit__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-10deg);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.09);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    z-index: 5;
  }

  .cockpit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tile {
    position: relative;
    aspect-ratio: 16/11;
    border-radius: var(--r-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tile--active {
    border: 2px solid #00bfa5;
    box-shadow: 0 0 16px rgba(0, 191, 165, 0.4);
  }

  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile__top {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    display: flex;
    justify-content: space-between;
    z-index: 2;
  }

  .tile__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 9.5px;
    font-weight: 750;
    padding: 3px 8px;
    border-radius: var(--r-pill);
  }

  .tile__badge--active {
    background: rgba(0, 191, 165, 0.85);
    color: #ffffff;
  }

  .tile__badge--ai {
    background: rgba(124, 58, 237, 0.85);
    color: #ffffff;
    margin-left: auto;
  }

  .wave-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 8px;
  }

  .wave-bars span {
    width: 2px;
    background: #ffffff;
    border-radius: 1px;
    animation: wave-bounce 1s infinite ease-in-out;
  }

  .wave-bars span:nth-child(1) { height: 3px; animation-delay: 0.1s; }
  .wave-bars span:nth-child(2) { height: 8px; animation-delay: 0.3s; }
  .wave-bars span:nth-child(3) { height: 5px; animation-delay: 0.2s; }

  @keyframes wave-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1.4); }
  }

  .tile__bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, transparent 100%);
    z-index: 2;
  }

  .tile__user {
    display: flex;
    flex-direction: column;
  }

  .tile__name {
    font-size: 11.5px;
    font-weight: 700;
    color: #ffffff;
  }

  .tile__role {
    font-size: 9.5px;
    color: #5eead4;
  }

  .tile__signal {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .signal-bar {
    width: 2.5px;
    background: #00bfa5;
    border-radius: 1px;
  }
  .signal-bar:nth-child(1) { height: 3px; }
  .signal-bar:nth-child(2) { height: 6px; }
  .signal-bar:nth-child(3) { height: 10px; }

  /* Telemetry */
  .cockpit__telemetry {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 16px;
    background: #0f172a;
    font-size: 10.5px;
    color: #94a3b8;
  }

  .tele-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #10b981;
    margin-right: 4px;
  }

  /* Dock Controls */
  .cockpit__dock {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #f8fafc;
    border-top: 1px solid var(--border);
  }

  .dock-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dock-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--border);
    color: #334155;
    transition: all var(--dur) ease;
  }

  .dock-btn:hover {
    border-color: #00bfa5;
    color: #0f766e;
    transform: translateY(-1px);
  }

  .dock-btn--active {
    background: rgba(0, 191, 165, 0.12);
    border-color: rgba(0, 191, 165, 0.5);
    color: #0f766e;
  }

  .dock-btn--end {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }

  .dock-btn--end:hover {
    background: #dc2626;
    color: #ffffff;
  }

  .dock-meta {
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .cockpit__mode-tabs .mode-tab:not(.mode-tab--active) { display: none; }
    .cockpit__grid { grid-template-columns: 1fr; }
    .cockpit__telemetry { flex-direction: column; gap: 2px; }
  }
</style>


