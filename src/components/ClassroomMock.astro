---
// The live-classroom visual: trainer prioritised, learners secondary, with the three
// things that actually differentiate the product visible at once — voice translation,
// live captions and AI class notes. Reuses the existing hero faces and the CallMock
// visual language (dark chrome on the white page) rather than stock art or illustration.
//
// Pure CSS + Astro. No client JS, no animation library. Every message reads with
// animation disabled (see prefers-reduced-motion at the bottom).
import Icon from './Icon.astro';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

// Learner languages are REAL translate targets (XLATE_LANGS, server TRANSLATE_LANGS default).
const learners = [
  { img: '/hero-face-bob.png',   name: 'Mateo',  lang: 'Español',  tag: 'audio',    alt: 'A learner following the class with Spanish voice translation' },
  { img: '/hero-face-aisha.png', name: 'Chloé',  lang: 'Français', tag: 'captions', alt: 'A learner following the class with French live captions' },
  { img: '/hero-face-you.png',   name: 'Priya',  lang: 'हिन्दी',    tag: 'captions', alt: 'A learner following the class with Hindi live captions' },
];
---
<div class:list={['room', compact && 'room--compact']}>
  <div class="room__frame panel">
    <!-- class context -->
    <div class="room__bar">
      <span class="room__title">Advanced Excel · Session 4</span>
      <span class="room__live"><span class="room__dot"></span>LIVE</span>
    </div>

    <div class="room__stage">
      <!-- trainer: visually dominant -->
      <figure class="room__trainer">
        <img src="/hero-face-jane.png" alt="A trainer teaching a live class in English while AI translates for learners"
             width="560" height="380" loading="eager" decoding="async" />
        <figcaption class="room__badge">
          <span class="room__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          Trainer speaking: English
        </figcaption>
      </figure>

      <!-- learners: secondary -->
      <ul class="room__learners">
        {learners.map((l) => (
          <li class="room__learner">
            <img src={l.img} alt={l.alt} width="160" height="120" loading="lazy" decoding="async" />
            <span class="room__lname">{l.name}</span>
            <span class="room__lang">{l.lang}<i class="room__lt">{l.tag}</i></span>
          </li>
        ))}
      </ul>
    </div>

    <!-- live translated caption -->
    <p class="room__caption">
      <span class="room__cap-lang">Español · Live</span>
      <span class="room__cap-text">“Ahora vamos a crear una tabla dinámica…”</span>
    </p>
  </div>

  <!-- AI class notes, as a surface beside the room -->
  <aside class="room__notes" aria-label="AI class notes">
    <span class="room__notes-h"><Icon name="sparkles" size={13} stroke="var(--blue)" /> AI Class Notes</span>
    <p class="room__note"><span class="room__tick" aria-hidden="true"></span>Key concept captured — PivotTables</p>
    <p class="room__note room__note--2"><span class="room__tick" aria-hidden="true"></span>Summarising for 3 languages</p>
  </aside>
</div>

<style>
  .room { position: relative; }
  .room__frame {
    overflow: hidden;
    background: linear-gradient(180deg, #23252c, #16181d);
    border-color: rgba(31, 27, 77, .22);
  }

  .room__bar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 11px 15px; border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  .room__title { font-size: 13px; font-weight: 600; color: #eef0f5; }
  .room__live {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .1em;
    color: #ff8f86;
  }
  .room__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); animation: roomPulse 2s ease-in-out infinite; }

  .room__stage { display: grid; grid-template-columns: 1.85fr 1fr; gap: 10px; padding: 12px; }

  .room__trainer { position: relative; margin: 0; border-radius: 12px; overflow: hidden; background: #2a2d36; }
  .room__trainer img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 11; }
  .room__badge {
    position: absolute; left: 10px; bottom: 10px;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 11px; border-radius: 100px;
    background: rgba(12, 14, 18, .78); backdrop-filter: blur(6px);
    font-size: 12px; font-weight: 600; color: #eef0f5;
  }

  /* the trainer is speaking — a soft, slow waveform, not a decorative glow */
  .room__wave { display: inline-flex; align-items: flex-end; gap: 2px; height: 12px; }
  .room__wave i { width: 2px; border-radius: 1px; background: var(--teal); height: 4px; animation: roomWave 1.1s ease-in-out infinite; }
  .room__wave i:nth-child(2) { animation-delay: .14s } .room__wave i:nth-child(3) { animation-delay: .28s }
  .room__wave i:nth-child(4) { animation-delay: .42s } .room__wave i:nth-child(5) { animation-delay: .56s }

  .room__learners { list-style: none; display: grid; gap: 10px; margin: 0; padding: 0; }
  .room__learner { position: relative; border-radius: 10px; overflow: hidden; background: #2a2d36; }
  .room__learner img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .room__lname {
    position: absolute; left: 7px; bottom: 7px; font-size: 11px; font-weight: 600; color: #eef0f5;
    text-shadow: 0 1px 3px rgba(0, 0, 0, .6);
  }
  .room__lang {
    position: absolute; right: 7px; top: 7px;
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 7px; border-radius: 100px;
    background: rgba(12, 14, 18, .8); font-size: 10.5px; font-weight: 600; color: #d8ecff;
  }
  .room__lt { font-style: normal; font-family: var(--font-mono); font-size: 9px; letter-spacing: .04em; color: #93b7d8; }

  .room__caption {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    margin: 0 12px 12px; padding: 10px 13px; border-radius: 10px;
    background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .08);
  }
  .room__cap-lang {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .05em; color: #7fe3bd; flex: none;
  }
  .room__cap-text { font-size: 13.5px; color: #e7eaf1; animation: roomCap .5s ease-out both; }

  /* AI notes ride mostly OUTSIDE the frame so they read as a separate surface — and so they
     never cover a learner tile, which they did at bottom:-20px. */
  .room__notes {
    position: absolute; right: -18px; bottom: -62px; width: 236px;
    background: var(--panel); border: 1px solid var(--line-2); border-radius: var(--r);
    box-shadow: var(--sh-float); padding: 13px 14px;
  }
  .room__notes-h {
    display: flex; align-items: center; gap: 7px;
    font-size: 11.5px; font-weight: 700; letter-spacing: .02em; color: var(--ink);
    margin-bottom: 9px;
  }
  .room__note {
    display: flex; align-items: flex-start; gap: 8px;
    font-size: 12.5px; line-height: 1.45; color: var(--ink-2); margin-top: 7px;
    animation: roomNote .6s ease-out both;
  }
  .room__note--2 { animation-delay: 1.1s; color: var(--muted); }
  .room__tick {
    width: 14px; height: 14px; border-radius: 5px; flex: none; margin-top: 1px;
    background: var(--teal-150);
    position: relative;
  }
  .room__tick::after {
    content: ""; position: absolute; inset: 0;
    background: var(--teal);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='3.4' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>") center / 9px no-repeat;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='3.4' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>") center / 9px no-repeat;
  }

  @keyframes roomPulse { 0%, 100% { opacity: 1 } 50% { opacity: .35 } }
  @keyframes roomWave  { 0%, 100% { height: 4px } 50% { height: 12px } }
  @keyframes roomCap   { from { opacity: 0; transform: translateY(3px) } to { opacity: 1; transform: none } }
  @keyframes roomNote  { from { opacity: 0; transform: translateY(5px) } to { opacity: 1; transform: none } }

  /* Mobile: a simplified classroom, not a shrunken replica — learners go to a row,
     the notes surface comes inline so nothing overlaps or becomes unreadable. */
  @media (max-width: 720px) {
    .room__stage { grid-template-columns: 1fr; }
    .room__learners { grid-template-columns: repeat(3, 1fr); }
    .room__notes { position: static; width: auto; margin-top: 12px; }
    .room__caption { margin-inline: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .room__dot, .room__wave i, .room__cap-text, .room__note { animation: none !important; }
    .room__wave i { height: 8px; }
  }
</style>
