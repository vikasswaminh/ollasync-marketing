---
const features = [
  {
    title: "Signal Protocol",
    description: "X3DH key agreement and Double Ratchet algorithm for perfect forward secrecy and post-compromise security.",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
    color: "primary"
  },
  {
    title: "QUIC Transport",
    description: "Modern UDP-based transport with TLS 1.3 and mandatory mTLS for client authentication.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    color: "amber"
  },
  {
    title: "Android SDK",
    description: "Native Android library with hardware-backed keystore, EncryptedSharedPreferences, and Rust FFI.",
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
    color: "emerald"
  },
  {
    title: "Observability",
    description: "Prometheus metrics, 4 Grafana dashboards, structured logging, and Alertmanager integration.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    color: "cyan"
  },
  {
    title: "Production Ready",
    description: "Docker Compose, Kubernetes Helm charts, health checks, graceful shutdown, and resource limits.",
    icon: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 01-2 2v4a2 2 0 012 2h14a2 2 0 012-2v-4a2 2 0 01-2-2m-2-4h.01M17 16h.01",
    color: "violet"
  },
  {
    title: "Security Audited",
    description: "31 critical issues identified and remediated. Race conditions, auth bypasses, and secrets exposure fixed.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    color: "rose"
  }
];
---

<section class="py-24 bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Built for Security-First Teams
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Every feature designed with end-to-end encryption and zero server knowledge in mind.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group p-6 bg-slate-800/50 rounded-xl border border-slate-700 hover:border-primary-500/50 transition-all hover:bg-slate-800">
          <div class={`w-12 h-12 rounded-lg bg-${feature.color}-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}>
            <svg class={`w-6 h-6 text-${feature.color}-400`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon}></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">{feature.title}</h3>
          <p class="text-slate-400">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
