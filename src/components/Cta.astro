---
import { SITE } from '../consts';
interface Props {
  title?: string;
  sub?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  title = 'Meet in your language.',
  sub = 'Start a browser meeting with live translation, screen sharing, recordings and AI notes. Free to start.',
  primary = { label: 'Start free', href: SITE.appUrl },
  secondary = { label: 'Book a demo', href: '/contact' },
} = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band" data-reveal>
      <div class="cta-band__glow" aria-hidden="true"></div>
      <h2 class="h2" style="max-width:16ch">{title}</h2>
      <p class="lead" style="margin-top:14px;max-width:52ch">{sub}</p>
      <div style="margin-top:26px;display:flex;flex-wrap:wrap;gap:14px">
        <a href={primary.href} class="btn btn-primary">{primary.label} <span class="arrow">→</span></a>
        <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative; overflow: hidden;
    border: 1px solid var(--line-2); border-radius: var(--r-xl);
    padding: clamp(32px, 5vw, 60px);
    background: linear-gradient(140deg, var(--violet-150), var(--violet-050) 55%, var(--bg-2));
    box-shadow: var(--sh-card);
  }
  .cta-band__glow {
    position: absolute; top: -40%; right: -10%; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, var(--violet-300), transparent 60%); filter: blur(30px);
    animation: pulseGlow 7s ease-in-out infinite; pointer-events: none;
  }
</style>
