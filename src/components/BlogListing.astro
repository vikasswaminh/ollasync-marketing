---
import type { BlogEntry } from '../data/blogListing';
import BlogImage from './BlogImage.astro';
import BlogPagination from './BlogPagination.astro';

interface Props {
  posts: BlogEntry[];
  page: number;
  totalPages: number;
  baseUrl: string;
  featured?: BlogEntry;
}
const { posts, page, totalPages, baseUrl, featured } = Astro.props;
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---
{featured && (
  <a href={`/blog/${featured.slug}/`} class="feat card--hover">
    <div class="feat__media"><BlogImage src={featured.data.cover || featured.data.heroImage || '/og-ollasync.png'} alt={featured.data.title} sizes="(max-width: 900px) 100vw, 50vw" widths={[320, 480, 640, 960]} loading="eager" /></div>
    <div class="feat__body">
      <span class="chip cat">{featured.data.category}{featured.data.pillar && <> · Pillar guide</>}</span>
      <h2 class="h2" style="margin-top:14px;font-size:clamp(24px,3vw,32px)">{featured.data.title}</h2>
      <p class="lead" style="margin-top:12px">{featured.data.description}</p>
      <div class="post-meta">{fmt(featured.data.pubDate)} · {featured.data.readTime} min read</div>
      <span class="feat__more mono">Read the guide →</span>
    </div>
  </a>
)}
<div class="posts">
  {posts.filter((post) => post.slug !== featured?.slug).map((post) => (
    <a href={`/blog/${post.slug}/`} class="post-card card card--hover">
      <div class="post-card__media"><BlogImage src={post.data.cover || post.data.heroImage || '/og-ollasync.png'} alt={post.data.title} sizes="(max-width: 900px) 100vw, 33vw" widths={[320, 480, 640]} loading="lazy" /></div>
      <div class="post-card__body">
        <span class="chip cat">{post.data.category}</span>
        <h3>{post.data.title}</h3>
        <p class="muted">{post.data.description.slice(0, 120)}…</p>
        <div class="post-meta">{fmt(post.data.pubDate)} · {post.data.readTime} min</div>
      </div>
    </a>
  ))}
</div>
<BlogPagination page={page} totalPages={totalPages} baseUrl={baseUrl} />
<style>
  .cat { font-family:var(--font-mono); font-size:11px; color:var(--blue); border-color:var(--violet-300); background:var(--violet-050); }
  .post-meta { font-size:12.5px; color:var(--muted-2); margin-top:12px; font-family:var(--font-mono); }
  .feat { display:grid; grid-template-columns:1fr 1fr; overflow:hidden; background:linear-gradient(180deg,var(--panel),var(--bg-3)); margin-bottom:30px; border:1px solid var(--line); border-radius:var(--r-xl); }
  .feat__media :global(img) { width:100%; height:100%; object-fit:cover; min-height:280px; }
  .feat__body { padding:clamp(24px,3vw,40px); display:flex; flex-direction:column; justify-content:center; }
  .feat__more { display:inline-flex; margin-top:20px; color:var(--iris); font-size:13px; }
  .posts { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .post-card { padding:0; overflow:hidden; display:flex; flex-direction:column; }
  .post-card__media :global(img) { width:100%; aspect-ratio:16/9; object-fit:cover; border-bottom:1px solid var(--line); }
  .post-card__body { padding:20px; }
  .post-card__body h3 { font-size:18px; font-weight:600; margin-top:12px; }
  .post-card__body p { font-size:14px; margin-top:8px; }
  @media(max-width:900px) { .feat { grid-template-columns:1fr; } .feat__media :global(img) { min-height:200px; } .posts { grid-template-columns:1fr; } }
</style>
