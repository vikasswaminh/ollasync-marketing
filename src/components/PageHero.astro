---
import Breadcrumb from './Breadcrumb.astro';
import Icon from './Icon.astro';
interface Props {
  eyebrow?: string;
  eyebrowIcon?: string;
  title: string;
  titleAccent?: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  align?: 'left' | 'center';
}
const { eyebrow, eyebrowIcon, title, titleAccent, lead, crumbs, align = 'left' } = Astro.props;
---
<section class="section section-hero-page">
  <div class="container" style={align === 'center' ? 'max-width:820px;text-align:center' : ''}>
    {crumbs && <div style={align === 'center' ? 'display:flex;justify-content:center;margin-bottom:20px' : 'margin-bottom:20px'}><Breadcrumb items={crumbs} /></div>}
    {eyebrow && (
      <span class="eyebrow" data-reveal>
        {eyebrowIcon && <Icon name={eyebrowIcon} size={14} stroke="#0d9488" />}
        {eyebrow}
      </span>
    )}
    <h1 class="display" data-reveal style="margin-top:16px;font-size:clamp(34px,4.5vw,50px)">
      {title}{titleAccent && <> <span class="gradient-text">{titleAccent}</span></>}
    </h1>
    {lead && <p class="lead" data-reveal style={`margin-top:18px;max-width:64ch${align === 'center' ? ';margin-inline:auto' : ''}`}>{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .section-hero-page {
    padding-top: 48px;
    padding-bottom: 40px;
    background: linear-gradient(180deg, #f0fdfb 0%, #e0f2fe 35%, #f8f7f4 100%);
    border-bottom: 1px solid #eae7df;
    position: relative;
  }
</style>
