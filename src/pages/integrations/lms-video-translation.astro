---
import SeoPage from '../../layouts/SeoPage.astro';
const benefits = [
  {
    "title": "Seamless user experience",
    "body": "Learners join translated sessions directly from their LMS dashboard."
  },
  {
    "title": "Automated data sync",
    "body": "Attendance and engagement data flows automatically back to your LMS."
  },
  {
    "title": "Centralized content",
    "body": "Keep all your training materials and video sessions in one place."
  }
];
const faqs = [
  {
    "question": "Which LMS platforms do you support?",
    "answer": "We support major platforms via LTI standards, including Canvas, Blackboard, and Docebo."
  }
];
---
<SeoPage 
  title="LMS Integration with Live Translation Video" 
  description="Plug Ollasync into Canvas, Blackboard, or Docebo for seamless multilingual training." 
  category="Integrations" 
  intro="Your Learning Management System (LMS) is the hub of your training. Ollasync integrates directly to add live, translated virtual classrooms to your existing courses." 
  benefits={benefits} 
  faqs={faqs} 
/>
