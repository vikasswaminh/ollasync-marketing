---
import SeoPage from '../../layouts/SeoPage.astro';
const benefits = [
  {
    "title": "Seamless user experience",
    "body": "Learners open a meeting link from your course page and join in their browser."
  },
  {
    "title": "Live meeting tools",
    "body": "Lead the session with screen sharing, whiteboards, breakout rooms and polls."
  },
  {
    "title": "Centralized content",
    "body": "Keep course materials in your LMS and add meeting links where learners need them."
  }
];
const faqs = [
  {
    "question": "How do I add a meeting to my course?",
    "answer": "Create or schedule a meeting, copy its join link and add that link to your course page. Learners open it to join the meeting in their browser."
  }
];
---
<SeoPage 
  title="Share Translated Meeting Links in Your LMS" 
  description="Add an Ollasync meeting link to your course so learners can join live training with captions and translated audio." 
  category="Integrations" 
  intro="Your Learning Management System (LMS) is the hub of your training. Add an Ollasync meeting link to your course page to bring learners into live, translated training." 
  benefits={benefits} 
  faqs={faqs} 
/>
