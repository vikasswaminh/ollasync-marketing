---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';

const title = 'Book a demo — talk to Ollasync';
const description =
  'Book a demo or talk to sales about encrypted, self-hostable video meetings and deal rooms. Request the security whitepaper and DPA for your review.';

const channels = [
  { icon: 'users', title: 'Talk to sales', body: 'Demos, pricing and self-hosted deployments.', email: SITE.salesEmail },
  { icon: 'shield-check', title: 'Security & compliance', body: 'Whitepaper, DPA and security-review questions.', email: 'security@ollasync.com' },
  { icon: 'chat', title: 'General & support', body: 'Anything else — we read every message.', email: SITE.email },
];
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="Get in touch"
    eyebrowIcon="chat"
    crumbs={[{ label: 'Contact' }]}
    title="See it on your own"
    titleAccent="infrastructure"
    lead="Tell us about your team and what you need to keep confidential. We’ll set up a demo and, if you’re evaluating, share the security whitepaper and DPA."
  />

  <section class="section" style="padding-top:28px">
    <div class="container contact">
      <form class="contact__form panel" id="contactForm" data-reveal>
        <div class="frow">
          <label>Name<input name="name" type="text" required autocomplete="name" /></label>
          <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="frow">
          <label>Organisation<input name="org" type="text" autocomplete="organization" /></label>
          <label>Interested in
            <select name="topic">
              <option>A demo</option>
              <option>Self-hosting / on-premise</option>
              <option>Security whitepaper & DPA</option>
              <option>Pricing</option>
              <option>Something else</option>
            </select>
          </label>
        </div>
        <label>What are you trying to keep confidential?
          <textarea name="message" rows="4" placeholder="A few words on your team, industry and requirements…"></textarea>
        </label>
        <button type="submit" class="btn btn-primary" style="align-self:flex-start">Send message <span class="arrow">→</span></button>
        <p class="muted" style="font-size:12.5px;margin-top:2px">This opens your email client addressed to our sales team. Prefer to write directly? <a href={`mailto:${SITE.salesEmail}`} style="color:var(--iris)">{SITE.salesEmail}</a></p>
      </form>

      <aside class="contact__side" data-reveal>
        {channels.map((c) => (
          <a href={`mailto:${c.email}`} class="card card--hover contact__card">
            <div class="card__icon"><Icon name={c.icon} size={20} /></div>
            <h2 class="h3">{c.title}</h2>
            <p>{c.body}</p>
            <span class="mono contact__email">{c.email}</span>
          </a>
        ))}
      </aside>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ sales: SITE.salesEmail }}>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const subject = `Ollasync enquiry: ${f.get('topic') || 'Demo'}`;
    const body = `Name: ${f.get('name') || ''}\nEmail: ${f.get('email') || ''}\nOrganisation: ${f.get('org') || ''}\nInterested in: ${f.get('topic') || ''}\n\n${f.get('message') || ''}`;
    window.location.href = `mailto:${sales}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr .9fr; gap: 28px; align-items: start; }
  .contact__form { padding: clamp(24px,3vw,34px); display: flex; flex-direction: column; gap: 16px; }
  .frow { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 7px; font-size: 13.5px; color: var(--ink-2); }
  input, select, textarea { background: rgba(255,255,255,.03); border: 1px solid var(--line-2); border-radius: 9px; padding: 11px 13px; color: var(--ink); font: inherit; font-size: 15px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--iris); background: rgba(124,92,255,.06); }
  textarea { resize: vertical; }
  .contact__side { display: grid; gap: 14px; }
  .contact__card { display: block; }
  .contact__email { display: inline-block; margin-top: 12px; font-size: 13px; color: var(--iris); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } .frow { grid-template-columns: 1fr; } }
</style>
