---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../consts';

const title = 'Video Meeting Pricing — Live Translation, Per Seat';
const description =
  'Per-seat pricing for browser meetings with live translation, recordings and AI notes. Free to start, then Pro $5 and Business $19 per seat a month.';

const tiers = [
  {
    name: 'Free', price: '$0', unit: 'free forever', tag: '',
    blurb: 'For tutors getting started — free, no credit card.',
    cta: { label: 'Start free', href: SITE.appUrl }, primary: false,
    features: ['1 meeting at a time, up to 30 min', 'Up to 20 people', 'Captions & translated captions', 'Local recording & AI notes', '2 h translated voice a month'],
  },
  {
    name: 'Pro', price: '$5', unit: '/ seat · mo', tag: 'Most popular',
    blurb: 'For trainers and academies teaching at scale.',
    cta: { label: 'Start free', href: SITE.appUrl }, primary: true,
    features: ['Everything in Free', '1 meeting at a time, up to 8 h', 'Up to 100 people', 'Cloud recording & AI notes', '20 h translated voice a month'],
  },
  {
    name: 'Business', price: '$19', unit: '/ seat · mo', tag: '',
    blurb: 'For teams that need a seat for every host, with SSO.',
    cta: { label: 'Contact us', href: `mailto:${SITE.salesEmail}` }, primary: false,
    features: ['Everything in Pro', '1 meeting per seat, up to 8 h', 'Up to 100 people', 'Unlimited translated voice', 'Seats for your team', 'SSO (OIDC)'],
  },
];

const faq = [
  { q: 'Is there a free trial?', a: 'The Free plan is not a trial — it stays free, with no credit card. Upgrade to Pro or Business when you need more, and try everything before you commit.' },
  { q: 'Do you offer a dedicated deployment?', a: 'Yes — enterprises can run on dedicated / single-tenant cloud infrastructure with a DPA and a custom SLA. Tell us your scale and we’ll size it with you.' },
  { q: 'Are AI notes included?', a: 'Yes — AI transcripts, notes and action items are included on every plan. They run on the meetings you record; end-to-end-encrypted meetings are excluded by design.' },
  { q: 'Where is our data hosted?', a: 'On our hosted service, in private storage with access control and a DPA. Dedicated single-tenant deployments are available for enterprises.' },
];

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Ollasync',
  description: description,
  brand: { '@type': 'Brand', name: 'Ollasync' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '0',
    highPrice: '19',
    offerCount: '3',
    availability: 'https://schema.org/InStock',
  },
};
---
<Base title={title} description={description} schema={offerSchema}>
  <PageHero
    eyebrow="Pricing"
    eyebrowIcon="key"
    crumbs={[{ label: 'Pricing' }]}
    title="Simple pricing that"
    titleAccent="starts at free"
    lead="Free to start, no credit card. Pro is $5 and Business $19, per seat per month."
    align="center"
  />
  <section class="section" style="padding-top:24px">
    <div class="container">
      <div class="tiers" data-reveal>
        {tiers.map((t) => (
          <div class={`tier ${t.primary ? 'tier--pop' : ''}`}>
            {t.tag && <span class="tier__tag mono">{t.tag}</span>}
            <h2 class="h3">{t.name}</h2>
            <div class="tier__price"><span class="tier__amount">{t.price}</span>{t.unit && <span class="tier__unit">{t.unit}</span>}</div>
            <p class="muted" style="font-size:14px;min-height:40px">{t.blurb}</p>
            <a href={t.cta.href} class={`btn ${t.primary ? 'btn-primary' : 'btn-ghost'}`} style="width:100%;margin-block:6px 20px">{t.cta.label}</a>
            <ul class="check-list">
              {t.features.map((f) => <li><span class="tick"><Icon name="check" size={12} stroke="var(--teal)" /></span>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="center muted" style="margin-top:26px;font-size:14px">Every plan includes end-to-end encryption. Need dedicated cloud? <a href="/contact">Talk to sales</a>. Prices exclude tax.</p>
      <p class="center muted" style="margin-top:8px;font-size:14px"><a href="/vs/#translation-pricing">Compare what Zoom, Teams, Meet and Webex charge for translation →</a></p>
    </div>
  </section>
  <Faq items={faq} title="Pricing questions" />
  <Cta />
</Base>

<style>
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: start; }
  .tier { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 28px; background: linear-gradient(180deg, var(--panel), var(--bg-3)); position: relative; }
  .tier--pop { border-color: var(--violet-300); background: linear-gradient(180deg, var(--violet-150), var(--bg-3)); box-shadow: 0 24px 60px -34px var(--violet-300); }
  .tier__tag { position: absolute; top: -11px; left: 28px; font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: var(--grad-accent); padding: 4px 11px; border-radius: 100px; }
  .tier__price { margin: 12px 0 8px; display: flex; align-items: baseline; gap: 6px; }
  .tier__amount { font-size: 38px; font-weight: 660; letter-spacing: -.03em; }
  .tier__unit { color: var(--muted); font-size: 14px; }
  .tier .check-list li { font-size: 14px; }
  @media (max-width: 900px) { .tiers { grid-template-columns: 1fr; } }
</style>
