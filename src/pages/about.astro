---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';

const title = 'About Ollasync';
const description =
  'Ollasync is a platform for learning: live classes with real-time voice translation and AI class notes — private, and radically honesty about what our security does and doesn’t do.';

const principles = [
  { icon: 'shield-check', title: 'Private by design', body: 'End-to-end encrypted meetings are encrypted in the browser under a key we never receive — the service stores ciphertext it cannot read.' },
  { icon: 'globe', title: 'Any language', body: 'A trainer speaks once and every learner follows in their own language — live captions and spoken audio, per listener. No interpreter booth in the path.' },
  { icon: 'fingerprint', title: 'Radical honesty', body: 'We publish exactly what is protected, what isn’t yet, and what we don’t hold. A serious buyer rewards a vendor who draws the line clearly.' },
  { icon: 'sparkles', title: 'AI with a boundary', body: 'AI notes make meetings useful, and your workspace decides where they apply. End-to-end encrypted calls stay outside it entirely.' },
];
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="About"
    eyebrowIcon="spark"
    crumbs={[{ label: 'About' }]}
    title="Software for teams with"
    titleAccent="something to protect"
    lead="Most video tools bolt AI onto your meetings and put the recording on a US cloud. We built Ollasync so you get the AI notes — and keep control of what’s said, where it lives, and who can read it."
  />

  <section class="section" style="padding-top:28px">
    <div class="container" style="max-width:760px">
      <div class="prose" data-reveal style="font-size:17px;line-height:1.7">
        <p>Healthcare teams, law firms, banks and public bodies all share a problem: the tools everyone uses for meetings put their most confidential conversations on US-operated infrastructure, in jurisdictions they didn’t choose, operated by companies they can’t audit.</p>
        <p>Ollasync is our answer — an AI classroom where a trainer speaks once and every learner follows in their own language, with webinars, recordings and AI class notes in one workspace. You get automatic transcripts, notes and action items, and the calls that matter most stay end-to-end encrypted in your browser, under a key that never reaches us.</p>
        <p>We’re just as committed to being honest about the limits. Our security page describes precisely what each part of the product protects, what’s encrypted end-to-end and what’s encrypted in transit, and which certifications we don’t yet hold. We’d rather tell you than let a badge imply something untrue.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:12px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">What we believe</span>
        <h2 class="h2" style="margin-top:12px">The principles behind the product</h2>
      </div>
      <div class="grid grid-4" data-reveal>
        {principles.map((p) => (
          <div class="card card--hover">
            <div class="card__icon"><Icon name={p.icon} size={20} /></div>
            <h3 class="h3">{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>
