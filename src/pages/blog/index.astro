---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';

const title = 'Blog — encrypted, self-hosted video conferencing';
const description =
  'Guides and deep dives on end-to-end encryption, self-hosting, data residency and secure video conferencing — from the team building Ollasync.';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
const ALL_CATEGORIES = [
  "Self-Hosted",
  "Cryptography",
  "Comparisons",
  "Compliance",
  "Guides",
  "Security",
  "Infrastructure & Performance",
  "Enterprise Use Cases",
];
const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });

const postsJson = JSON.stringify(
  posts.map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    category: p.data.category,
    cover: p.data.cover || '/og-ollasync.png',
    pubDate: fmt(p.data.pubDate),
    readTime: p.data.readTime,
    pillar: p.data.pillar,
  }))
);
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="Blog"
    eyebrowIcon="doc"
    crumbs={[{ label: 'Blog' }]}
    title="On encryption, self-hosting"
    titleAccent="& data sovereignty"
    lead="Practical, honest writing about building — and buying — video conferencing you can actually trust."
  />

  <section class="section" style="padding-top:24px">
    <div class="container">
      <div class="cat-filter" data-reveal>
        <button class="chip is-active" data-cat="all">All</button>
        {ALL_CATEGORIES.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
      </div>

      {featured && (
        <a href={`/blog/${featured.slug}`} id="featuredHero" class="feat card--hover" data-reveal data-cat={featured.data.category} data-slug={featured.slug}>
          <div class="feat__media"><img id="featuredImg" src={featured.data.cover || '/og-ollasync.png'} alt={featured.data.title} width="640" height="420" loading="eager" /></div>
          <div class="feat__body">
            <span id="featuredCat" class="chip cat">{featured.data.category}{featured.data.pillar && <> · Pillar guide</>}</span>
            <h2 id="featuredTitle" class="h2" style="margin-top:14px;font-size:clamp(24px,3vw,32px)">{featured.data.title}</h2>
            <p id="featuredDesc" class="lead" style="margin-top:12px">{featured.data.description}</p>
            <div id="featuredMeta" class="post-meta">{fmt(featured.data.pubDate)} · {featured.data.readTime} min read</div>
            <span class="feat__more mono">Read the guide <Icon name="arrow" size={15} /></span>
          </div>
        </a>
      )}

      <div class="posts" id="postGrid" data-reveal>
        {posts.map((p) => (
          <a href={`/blog/${p.slug}`} class="post-card card card--hover" data-cat={p.data.category} data-slug={p.slug} style={p.slug === featured?.slug ? 'display:none' : ''}>
            <div class="post-card__media"><img src={p.data.cover || '/og-ollasync.png'} alt={p.data.title} width="420" height="240" loading="lazy" /></div>
            <div class="post-card__body">
              <span class="chip cat">{p.data.category}</span>
              <h3 style="font-size:18px;font-weight:600;margin-top:12px">{p.data.title}</h3>
              <p class="muted" style="font-size:14px;margin-top:8px">{p.data.description.slice(0, 120)}…</p>
              <div class="post-meta">{fmt(p.data.pubDate)} · {p.data.readTime} min</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</Base>

<script id="blog-data-script" type="application/json" set:html={postsJson}></script>

<script>
  const dataScript = document.getElementById('blog-data-script');
  const allPosts: Array<{
    slug: string;
    title: string;
    description: string;
    category: string;
    cover: string;
    pubDate: string;
    readTime: number;
    pillar?: boolean;
  }> = dataScript ? JSON.parse(dataScript.textContent || '[]') : [];

  const btns = document.querySelectorAll('.cat-filter .chip');
  const featuredHero = document.getElementById('featuredHero') as HTMLAnchorElement | null;
  const featuredImg = document.getElementById('featuredImg') as HTMLImageElement | null;
  const featuredCat = document.getElementById('featuredCat') as HTMLElement | null;
  const featuredTitle = document.getElementById('featuredTitle') as HTMLElement | null;
  const featuredDesc = document.getElementById('featuredDesc') as HTMLElement | null;
  const featuredMeta = document.getElementById('featuredMeta') as HTMLElement | null;
  const gridCards = document.querySelectorAll('#postGrid .post-card') as NodeListOf<HTMLElement>;

  function norm(str: string) {
    return (str || '').toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function matchesCategory(postCat: string, filterCat: string) {
    if (!filterCat || filterCat === 'all') return true;
    const nCard = norm(postCat);
    const nFilter = norm(filterCat);
    if (nFilter === 'selfhosted' && (nCard === 'selfhosted' || nCard === 'selfhosting')) return true;
    return nCard === nFilter;
  }

  function filterBy(cat: string) {
    btns.forEach((x) => x.classList.toggle('is-active', x.getAttribute('data-cat') === cat));

    const matched = allPosts.filter((p) => matchesCategory(p.category, cat));

    if (matched.length === 0) {
      if (featuredHero) featuredHero.style.display = 'none';
      gridCards.forEach((c) => (c.style.display = 'none'));
      return;
    }

    const top = matched[0];
    if (featuredHero && featuredImg && featuredCat && featuredTitle && featuredDesc && featuredMeta) {
      featuredHero.href = `/blog/${top.slug}`;
      featuredHero.setAttribute('data-cat', top.category);
      featuredHero.setAttribute('data-slug', top.slug);
      featuredImg.src = top.cover;
      featuredImg.alt = top.title;
      featuredCat.textContent = top.category + (top.pillar ? ' · Pillar guide' : '');
      featuredTitle.textContent = top.title;
      featuredDesc.textContent = top.description;
      featuredMeta.textContent = `${top.pubDate} · ${top.readTime} min read`;
      featuredHero.style.display = '';
    }

    const restSlugs = new Set(matched.slice(1).map((p) => p.slug));
    gridCards.forEach((card) => {
      const slug = card.getAttribute('data-slug');
      if (slug && restSlugs.has(slug)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  btns.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.getAttribute('data-cat') || 'all';
      filterBy(cat);
    })
  );

  // Check URL param on load
  const urlParam = new URLSearchParams(window.location.search).get('category');
  if (urlParam) {
    filterBy(urlParam);
  }
</script>

<style>
  .cat { font-family: var(--font-mono); font-size: 11px; color: #cfc6ff; border-color: var(--violet-300); background: var(--violet-050); }
  .cat-filter { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .cat-filter .chip { cursor: pointer; background: rgba(255,255,255,.03); }
  .cat-filter .chip.is-active { background: var(--grad-accent); color: #fff; border-color: transparent; }
  .post-meta { font-size: 12.5px; color: var(--muted-2); margin-top: 12px; font-family: var(--font-mono); }

  .feat { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--line); border-radius: var(--r-xl); overflow: hidden; background: linear-gradient(180deg, var(--panel), var(--bg-3)); margin-bottom: 30px; transition: border-color var(--dur) ease; min-height: 380px; }
  .feat:hover { border-color: var(--violet-300); }
  .feat__media { position: relative; width: 100%; height: 100%; overflow: hidden; min-height: 380px; }
  .feat__media img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .feat__body { padding: clamp(24px,3vw,36px); display: flex; flex-direction: column; justify-content: center; }
  .feat__body .h2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .feat__body .lead { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .feat__more { display: inline-flex; align-items: center; gap: 7px; margin-top: 20px; font-size: 13px; color: var(--iris); }

  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .post-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .post-card__media img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--line); }
  .post-card__body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
  .post-card__body h3 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card__body p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card__body .post-meta { margin-top: auto; padding-top: 12px; }
  @media (max-width: 900px) {
    .feat { grid-template-columns: 1fr; min-height: auto; }
    .feat__media { position: relative; min-height: 220px; height: 220px; }
    .feat__media img { position: relative; height: 220px; }
    .posts { grid-template-columns: 1fr; }
  }
</style>
