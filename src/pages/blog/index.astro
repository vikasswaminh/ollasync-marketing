---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';

const title = 'Blog — encrypted, self-hosted video conferencing';
const description =
  'Guides and deep dives on end-to-end encryption, self-hosting, data residency and secure video conferencing — from the team building Ollasync.';

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured / Important Guides for left sidebar (only 4)
const featuredLeftSlugs = [
  'compliance-governance-enterprise-guide',
  'self-hosting-piller',
  'end-to-end-encrypted-video-conferencing',
  'self-hosted-vs-cloud-video-meetings',
];
const featuredPosts = featuredLeftSlugs
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter(Boolean);

// Security & Architecture deep dives for right sidebar
const rightSidebarSlugs = [
  'are-cloud-ai-video-transcripts-safe',
  'end-to-end-encryption-vs-in-transit-encryption-in-video-calls',
  'how-mls-encryption-works',
  'what-a-server-can-see-on-an-encrypted-call',
  'per-frame-media-encryption-explained',
  'eu-data-residency-explained',
  'gdpr-compliant-video-conferencing',
  'hipaa-compliant-video-conferencing',
];
const rightSidebarPosts = rightSidebarSlugs
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter(Boolean);

// Hero / Newest article
const newestPost = allPosts[0];
// Rest of the articles (all remaining without images)
const remainingPosts = allPosts.slice(1);

const ALL_CATEGORIES = [
  "All",
  "Self-Hosting",
  "Cryptography",
  "Comparisons",
  "Enterprise Use Cases",
  "Compliance",
  "Security",
  "Infrastructure & Performance",
  "Guides",
];

const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });

const postsJson = JSON.stringify(
  allPosts.map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    category: p.data.category,
    cover: p.data.cover || '/og-ollasync.png',
    pubDate: fmt(p.data.pubDate),
    readTime: p.data.readTime,
    pillar: p.data.pillar,
  }))
);
---

<Base title={title} description={description}>
  <div class="blog-hub-page">
    <div class="container blog-hub-container">
      
      <!-- LEFT SIDEBAR: FEATURED ARTICLES & PRICING/CONTACT -->
      <aside class="blog-sidebar blog-sidebar--left">
        <div class="sidebar-sticky-wrap">
          <div class="sidebar-badge badge--teal">
            <Icon name="star" size={13} stroke="#0f766e" />
            <span>FEATURED GUIDES</span>
          </div>

          <div class="sidebar-featured-section">
            <nav class="sidebar-links-list">
              {featuredPosts.map((p) => p && (
                <a href={`/blog/${p.slug}`} class="sidebar-link-item">
                  <span class="sli-title">{p.data.title}</span>
                </a>
              ))}
            </nav>

            <a href="/self-hosted" class="sidebar-view-all">
              <span>Explore Self-Hosted Architecture &rarr;</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- CENTER / MAIN CONTENT -->
      <main class="blog-main-feed">
        <!-- Main Hub Header -->
        <header class="feed-header">
          <div class="cat-pill-row">
            <div class="section-label-chip">
              <Icon name="zap" size={13} stroke="#00bfa5" />
              <span>NEWEST ARTICLES</span>
            </div>
            <span class="label-subtext">Latest from our security engineering team</span>
          </div>
        </header>

        <!-- HIGHLIGHTED NEWEST HERO ARTICLE (WITH IMAGE) -->
        {newestPost && (
          <article class="hero-post-card" id="heroPostCard" data-slug={newestPost.slug} data-cat={newestPost.data.category}>
            <a href={`/blog/${newestPost.slug}`} class="hero-post-link">
              <div class="hero-post-image-wrap">
                <img id="heroCoverImg" src={newestPost.data.cover || '/og-ollasync.png'} alt={newestPost.data.title} width="680" height="380" loading="eager" />
              </div>
              <div class="hero-post-content">
                <div class="hero-post-top">
                  <span id="heroCatTag" class="badge-cat">{newestPost.data.category}{newestPost.data.pillar && ' · Pillar'}</span>
                  <span class="badge-new">NEW</span>
                </div>
                <h2 id="heroPostTitle" class="hero-post-title">{newestPost.data.title}</h2>
                <p id="heroPostDesc" class="hero-post-desc">{newestPost.data.description}</p>
                <div class="hero-post-footer">
                  <span id="heroPostMeta" class="meta-time">{newestPost.data.readTime} min read</span>
                  <span class="meta-dot">·</span>
                  <span class="read-action">Read article &rarr;</span>
                </div>
              </div>
            </a>
          </article>
        )}

        <!-- CATEGORY FILTER CHIPS -->
        <div class="category-filters" id="catFilterRow">
          {ALL_CATEGORIES.map((cat, idx) => (
            <button class={`filter-btn ${idx === 0 ? 'is-active' : ''}`} data-cat={cat.toLowerCase().replace(/[^a-z0-9]/g, '')}>
              {cat}
            </button>
          ))}
        </div>

        <!-- REMAINING ARTICLES (NO IMAGES, 3-COLUMN COMPACT CARDS) -->
        <div class="compact-posts-grid" id="compactPostGrid">
          {allPosts.map((p, idx) => (
            <a
              href={`/blog/${p.slug}`}
              class="compact-card"
              data-cat={p.data.category.toLowerCase().replace(/[^a-z0-9]/g, '')}
              data-slug={p.slug}
              style={idx === 0 ? 'display:none;' : ''}
            >
              <div class="compact-card-top">
                <span class="badge-cat">{p.data.category}</span>
              </div>
              <h3 class="compact-card-title">{p.data.title}</h3>
              <p class="compact-card-desc">{p.data.description}</p>
              <div class="compact-card-footer">
                <span class="compact-card-time">{p.data.readTime} min read</span>
                <span class="compact-card-arrow">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </main>

      <!-- RIGHT SIDEBAR: PRICING & CONTACT -->
      <aside class="blog-sidebar blog-sidebar--right">
        <div class="sidebar-sticky-wrap">
          <div class="sidebar-badge badge--blue">
            <Icon name="shield" size={13} stroke="#0284c7" />
            <span>SECURITY & ARCHITECTURE</span>
          </div>

          <!-- Pricing & Plans -->
          <div class="sidebar-pricing-section">
            <h4 class="action-box-title">Ready for Sovereign Video?</h4>
            <p class="action-box-desc">Transparent pricing and dedicated deployment support for regulated organizations.</p>
            <a href="/pricing" class="sidebar-pricing-item">
              <div class="pricing-item-icon">🏢</div>
              <div class="pricing-item-info">
                <span class="pricing-item-name">Business</span>
                <span class="pricing-item-desc">For growing teams</span>
              </div>
              <span class="pricing-item-arrow">&rarr;</span>
            </a>
            <a href="/pricing" class="sidebar-pricing-item">
              <div class="pricing-item-icon">🏛️</div>
              <div class="pricing-item-info">
                <span class="pricing-item-name">Enterprise</span>
                <span class="pricing-item-desc">On-prem & air-gapped</span>
              </div>
              <span class="pricing-item-arrow">&rarr;</span>
            </a>
            <a href="/pricing" class="sidebar-pricing-item">
              <div class="pricing-item-icon">🔒</div>
              <div class="pricing-item-info">
                <span class="pricing-item-name">Government</span>
                <span class="pricing-item-desc">FedRAMP & IL5 ready</span>
              </div>
              <span class="pricing-item-arrow">&rarr;</span>
            </a>
          </div>

          <a href="/pricing" class="sidebar-view-all">
            <span>Compare All Plans &rarr;</span>
          </a>

          <!-- Contact CTA Card -->
          <div class="sidebar-consult-card">
            <div class="consult-badge">
              <span class="pulse-dot"></span>
              <span>GET IN TOUCH</span>
            </div>
            <h4 class="consult-title">Need a custom deployment or have questions?</h4>
            <p class="consult-desc">Talk directly with our solutions engineering team.</p>
            <a href="/contact" class="btn-consult">
              <Icon name="message" size={15} />
              <span>Contact Team</span>
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>
  <Cta />
</Base>

<script id="blog-data-script" type="application/json" set:html={postsJson}></script>

<script>
  const dataScript = document.getElementById('blog-data-script');
  const allPosts: Array<{
    slug: string;
    title: string;
    description: string;
    category: string;
    cover: string;
    pubDate: string;
    readTime: number;
    pillar?: boolean;
  }> = dataScript ? JSON.parse(dataScript.textContent || '[]') : [];

  const filterButtons = document.querySelectorAll('.category-filters .filter-btn');
  const heroCard = document.getElementById('heroPostCard');
  const heroImg = document.getElementById('heroCoverImg') as HTMLImageElement | null;
  const heroCat = document.getElementById('heroCatTag');
  const heroTitle = document.getElementById('heroPostTitle');
  const heroDesc = document.getElementById('heroPostDesc');
  const heroMeta = document.getElementById('heroPostMeta');
  const compactCards = document.querySelectorAll('#compactPostGrid .compact-card') as NodeListOf<HTMLElement>;

  function norm(str: string) {
    return (str || '').toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function filterPosts(targetCat: string) {
    filterButtons.forEach((btn) => {
      btn.classList.toggle('is-active', btn.getAttribute('data-cat') === targetCat);
    });

    const isAll = targetCat === 'all' || !targetCat;

    if (isAll) {
      if (allPosts.length > 0) {
        const top = allPosts[0];
        updateHero(top);
        if (heroCard) heroCard.style.display = '';
      }
      compactCards.forEach((c, idx) => {
        c.style.display = idx === 0 ? 'none' : '';
      });
      return;
    }

    const matched = allPosts.filter((p) => {
      const nP = norm(p.category);
      if ((targetCat === 'selfhosted' || targetCat === 'selfhosting') && (nP === 'selfhosted' || nP === 'selfhosting')) return true;
      return nP === targetCat;
    });

    if (matched.length === 0) {
      if (heroCard) heroCard.style.display = 'none';
      compactCards.forEach((c) => (c.style.display = 'none'));
      return;
    }

    const top = matched[0];
    updateHero(top);
    if (heroCard) heroCard.style.display = '';

    const matchedSlugs = new Set(matched.map((p) => p.slug));
    const restSlugs = matched.length > 1 ? new Set(matched.slice(1).map((p) => p.slug)) : matchedSlugs;
    compactCards.forEach((card) => {
      const slug = card.getAttribute('data-slug');
      if (slug && restSlugs.has(slug)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function updateHero(post: any) {
    if (heroCard && heroImg && heroCat && heroTitle && heroDesc && heroMeta) {
      const link = heroCard.querySelector('.hero-post-link') as HTMLAnchorElement;
      if (link) link.href = `/blog/${post.slug}`;
      heroImg.src = post.cover || '/og-ollasync.png';
      heroImg.alt = post.title;
      heroCat.textContent = post.category + (post.pillar ? ' · Pillar' : '');
      heroTitle.textContent = post.title;
      heroDesc.textContent = post.description;
      heroMeta.textContent = `${post.readTime} min read`;
    }
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat') || 'all';
      filterPosts(cat);
    });
  });

  const urlParam = new URLSearchParams(window.location.search).get('category');
  if (urlParam) {
    filterPosts(norm(urlParam));
  }
</script>

<style>
  .blog-hub-page {
    background: #ffffff;
    padding-block: 12px 80px;
    border-bottom: 1px solid #eae7df;
  }

  .blog-hub-container {
    max-width: 1480px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 36px;
    align-items: start;
  }

  /* ---- SIDEBARS (LEFT & RIGHT) ---- */
  .blog-sidebar {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #c4d6e0 transparent;
    padding-right: 4px;
    -webkit-overflow-scrolling: touch;
  }
  .blog-sidebar::-webkit-scrollbar { width: 4px; }
  .blog-sidebar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 4px; }

  .sidebar-sticky-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    text-transform: uppercase;
    width: fit-content;
  }
  .badge--teal {
    color: #0ACEBE;
    background: linear-gradient(135deg, rgba(10, 206, 190, 0.14) 0%, rgba(108, 8, 251, 0.08) 100%);
    border: 1.5px solid rgba(10, 206, 190, 0.45);
  }
  .badge--blue {
    color: #6C08FB;
    background: linear-gradient(135deg, rgba(108, 8, 251, 0.08) 0%, rgba(10, 206, 190, 0.12) 100%);
    border: 1.5px solid rgba(108, 8, 251, 0.3);
  }

  /* Featured Guides (Left Sidebar) */
  .sidebar-featured-section,
  .sidebar-featured-guides {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border-radius: 14px;
    border: 2px solid transparent;
    background-image: linear-gradient(180deg, #f0f7ff 0%, #e6f2fe 100%), linear-gradient(45deg, #7128F5 0%, #03DDBE 100%);
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    box-shadow: 0 4px 18px -2px rgba(2, 132, 199, 0.12), 0 0 12px rgba(3, 221, 190, 0.08);
  }

  .sidebar-links-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sidebar-link-item {
    display: block;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.18s ease;
    border-left: 2px solid transparent;
  }
  .sidebar-link-item:hover {
    background: rgba(255, 255, 255, 0.85);
    border-left-color: #0284c7;
    box-shadow: 0 2px 6px rgba(2, 132, 199, 0.08);
  }
  .sli-title {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    line-height: 1.4;
    transition: color 0.18s ease;
  }
  .sidebar-link-item:hover .sli-title {
    color: #0284c7;
    font-weight: 700;
  }

  .sidebar-view-all {
    font-size: 12px;
    font-weight: 750;
    color: #6C08FB;
    text-decoration: none;
    padding-top: 10px;
    padding-left: 10px;
    border-top: 1px solid rgba(2, 132, 199, 0.15);
    margin-top: 4px;
    transition: all 0.18s ease;
    display: inline-block;
  }
  .sidebar-view-all:hover {
    color: #0ACEBE;
    transform: translateX(2px);
  }

  /* Action Box (now in right sidebar) */
  .action-box-title {
    font-size: 13.5px;
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .action-box-desc {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.45;
    margin-bottom: 12px;
  }

  /* Right Sidebar Pricing Section */
  .sidebar-pricing-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: 14px;
    border: 2px solid transparent;
    background-image: linear-gradient(180deg, #f0f7ff 0%, #e6f2fe 100%), linear-gradient(45deg, #7128F5 0%, #03DDBE 100%);
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    box-shadow: 0 4px 18px -2px rgba(2, 132, 199, 0.12), 0 0 12px rgba(3, 221, 190, 0.08);
  }
  .sidebar-pricing-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 10px;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.18s ease;
    border: 1.5px solid transparent;
  }
  .sidebar-pricing-item:hover {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(2, 132, 199, 0.3);
    box-shadow: 0 2px 6px rgba(2, 132, 199, 0.08);
  }
  .pricing-item-icon {
    font-size: 20px;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(108, 8, 251, 0.07), rgba(10, 206, 190, 0.07));
  }
  .pricing-item-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }
  .pricing-item-name {
    font-size: 13px;
    font-weight: 700;
    color: #334155;
  }
  .pricing-item-desc {
    font-size: 11px;
    color: var(--muted);
  }
  .pricing-item-arrow {
    font-size: 12px;
    color: #6C08FB;
    font-weight: 700;
    transition: transform 0.18s ease;
    flex-shrink: 0;
  }
  .sidebar-pricing-item:hover .pricing-item-arrow {
    transform: translateX(2px);
  }

  /* Right Sidebar Consultation Card */
  .sidebar-consult-card {
    margin-top: 12px;
    padding: 16px;
    border-radius: 14px;
    border: 2px solid transparent;
    background-image: linear-gradient(180deg, #f0f7ff 0%, #e6f2fe 100%), linear-gradient(45deg, #7128F5 0%, #03DDBE 100%);
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    box-shadow: 0 4px 18px -2px rgba(2, 132, 199, 0.12), 0 0 12px rgba(3, 221, 190, 0.08);
  }
  .consult-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 800;
    color: #6C08FB;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0ACEBE;
    box-shadow: 0 0 0 2px rgba(10, 206, 190, 0.3);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 0 2px rgba(10, 206, 190, 0.3); }
    50% { box-shadow: 0 0 0 5px rgba(108, 8, 251, 0.15); }
  }
  .consult-title {
    font-size: 13.5px;
    font-weight: 750;
    color: var(--ink);
    line-height: 1.35;
    margin-bottom: 6px;
  }
  .consult-desc {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.45;
    margin-bottom: 12px;
  }
  .btn-consult {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px 12px;
    border-radius: 8px;
    background: linear-gradient(45deg, #7128F5 0%, #03DDBE 100%);
    color: #ffffff;
    font-size: 12px;
    font-weight: 750;
    text-decoration: none;
    transition: all 0.18s ease;
    box-shadow: 0 3px 10px rgba(113, 40, 245, 0.25);
  }
  .btn-consult:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(3, 221, 190, 0.35);
  }

  /* ---- CENTER FEED ---- */
  .blog-main-feed {
    min-width: 0;
    padding-top: 0;
  }

  .feed-header {
    margin-bottom: 8px;
  }
  .feed-title {
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .feed-subtitle {
    font-size: 14.5px;
    color: var(--muted);
    margin-top: 6px;
    line-height: 1.5;
  }
  .cat-pill-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 0;
    flex-wrap: wrap;
  }
  .section-label-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #6C08FB 0%, #0ACEBE 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    padding: 5px 12px;
    border-radius: 100px;
    box-shadow: 0 2px 8px rgba(108, 8, 251, 0.2);
  }
  .label-subtext {
    font-size: 13px;
    color: var(--muted-2);
    font-weight: 500;
  }

  /* HIGHLIGHTED HERO ARTICLE (WITH IMAGE) */
  .hero-post-card {
    margin-bottom: 16px;
  }
  .hero-post-link {
    display: grid;
    grid-template-columns: 1fr 1fr;
    text-decoration: none;
    color: inherit;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
    overflow: hidden;
    position: relative;
    isolation: isolate;
    box-shadow: 0 4px 20px -2px rgba(108, 8, 251, 0.12);
    transition: all 0.22s ease;
  }
  .hero-post-link:hover {
    border-color: rgba(108, 8, 251, 0.4);
    background: linear-gradient(145deg, #ffffff 0%, rgba(108, 8, 251, 0.03) 50%, rgba(10, 206, 190, 0.04) 100%);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -4px rgba(108, 8, 251, 0.2);
  }
  .hero-post-image-wrap {
    position: relative;
    width: 100%;
    min-height: 260px;
    overflow: hidden;
    background: #0f172a;
    grid-row: 1;
    grid-column: 1;
  }
  .hero-post-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .hero-post-card:hover .hero-post-image-wrap img {
    transform: scale(1.03);
  }
  .hero-post-content {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    grid-row: 1;
    grid-column: 2;
