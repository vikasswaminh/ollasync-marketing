---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';

const title = 'Blog — encrypted, self-hosted video conferencing';
const description =
  'Guides and deep dives on end-to-end encryption, self-hosting, data residency and secure video conferencing — from the team building Ollasync.';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find((p) => p.data.pillar) || posts[0];
const rest = posts.filter((p) => p.slug !== featured?.slug);
const ALL_CATEGORIES = [
  "Self-Hosted",
  "Cryptography",
  "Comparisons",
  "Compliance",
  "Guides",
  "Security",
  "Infrastructure & Performance",
  "Enterprise Use Cases",
];
const fmt = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="Blog"
    eyebrowIcon="doc"
    crumbs={[{ label: 'Blog' }]}
    title="On encryption, self-hosting"
    titleAccent="& data sovereignty"
    lead="Practical, honest writing about building — and buying — video conferencing you can actually trust."
  />

  <section class="section" style="padding-top:24px">
    <div class="container">
      <div class="cat-filter" data-reveal>
        <button class="chip is-active" data-cat="all">All</button>
        {ALL_CATEGORIES.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
      </div>

      {featured && (
        <a href={`/blog/${featured.slug}`} class="feat card--hover" data-reveal data-cat={featured.data.category}>
          <div class="feat__media"><img src={featured.data.cover || '/og-ollasync.png'} alt={featured.data.title} width="640" height="420" loading="eager" /></div>
          <div class="feat__body">
            <span class="chip cat">{featured.data.category}{featured.data.pillar && <> · Pillar guide</>}</span>
            <h2 class="h2" style="margin-top:14px;font-size:clamp(24px,3vw,32px)">{featured.data.title}</h2>
            <p class="lead" style="margin-top:12px">{featured.data.description}</p>
            <div class="post-meta">{fmt(featured.data.pubDate)} · {featured.data.readTime} min read</div>
            <span class="feat__more mono">Read the guide <Icon name="arrow" size={15} /></span>
          </div>
        </a>
      )}

      <div class="posts" id="postGrid" data-reveal>
        {rest.map((p) => (
          <a href={`/blog/${p.slug}`} class="post-card card card--hover" data-cat={p.data.category}>
            <div class="post-card__media"><img src={p.data.cover || '/og-ollasync.png'} alt={p.data.title} width="420" height="240" loading="lazy" /></div>
            <div class="post-card__body">
              <span class="chip cat">{p.data.category}</span>
              <h3 style="font-size:18px;font-weight:600;margin-top:12px">{p.data.title}</h3>
              <p class="muted" style="font-size:14px;margin-top:8px">{p.data.description.slice(0, 120)}…</p>
              <div class="post-meta">{fmt(p.data.pubDate)} · {p.data.readTime} min</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</Base>

<script>
  const btns = document.querySelectorAll('.cat-filter .chip');
  const cards = document.querySelectorAll('[data-cat]');
  btns.forEach((b) => b.addEventListener('click', () => {
    const cat = b.getAttribute('data-cat');
    btns.forEach((x) => x.classList.toggle('is-active', x === b));
    cards.forEach((c) => {
      if (c.classList.contains('chip')) return;
      const cardCat = c.getAttribute('data-cat') || '';
      const normCard = cardCat.toLowerCase().replace(/[^a-z0-9]/g, '');
      const normFilter = (cat || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      const isSelfHost = normFilter === 'selfhosted' && (normCard === 'selfhosted' || normCard === 'selfhosting');
      const show = cat === 'all' || normCard === normFilter || isSelfHost;
      (c as HTMLElement).style.display = show ? '' : 'none';
    });
  }));
</script>

<style>
  .cat { font-family: var(--font-mono); font-size: 11px; color: #cfc6ff; border-color: var(--violet-300); background: var(--violet-050); }
  .cat-filter { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .cat-filter .chip { cursor: pointer; background: rgba(255,255,255,.03); }
  .cat-filter .chip.is-active { background: var(--grad-accent); color: #fff; border-color: transparent; }
  .post-meta { font-size: 12.5px; color: var(--muted-2); margin-top: 12px; font-family: var(--font-mono); }

  .feat { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--line); border-radius: var(--r-xl); overflow: hidden; background: linear-gradient(180deg, var(--panel), var(--bg-3)); margin-bottom: 30px; transition: border-color var(--dur) ease; }
  .feat:hover { border-color: var(--violet-300); }
  .feat__media img { width: 100%; height: 100%; object-fit: cover; min-height: 280px; }
  .feat__body { padding: clamp(24px,3vw,40px); display: flex; flex-direction: column; justify-content: center; }
  .feat__more { display: inline-flex; align-items: center; gap: 7px; margin-top: 20px; font-size: 13px; color: var(--iris); }

  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .post-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .post-card__media img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--line); }
  .post-card__body { padding: 20px; }
  @media (max-width: 900px) { .feat { grid-template-columns: 1fr; } .feat__media img { min-height: 200px; } .posts { grid-template-columns: 1fr; } }
</style>
