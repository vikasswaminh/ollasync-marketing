---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import BlogListing from '../../components/BlogListing.astro';
import Cta from '../../components/Cta.astro';
import { getBlogPage, getBlogPosts } from '../../data/blogListing';
import { topics } from '../../data/blogTopics';

const title = 'Blog — AI meetings, encryption & secure collaboration';
const description =
  'Guides and deep dives on AI meetings, end-to-end encryption, data residency and secure video conferencing — from the team building OllaSync.';

const posts = await getBlogPosts();
const { posts: pagePosts, totalPages } = getBlogPage(posts, 1);
const featured = pagePosts.find((p) => p.data.pillar) || pagePosts[0];
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="Blog"
    eyebrowIcon="doc"
    crumbs={[{ label: 'Blog' }]}
    title="On AI meetings & encryption"
    titleAccent="& data sovereignty"
    lead="Practical, honest writing about building — and buying — video conferencing you can actually trust."
  />

  <section class="section" style="padding-top:24px">
    <div class="container">
      <nav class="topic-nav" aria-label="Blog topics">
        <a href="/blog/" aria-current="page">All articles</a>
        {Object.entries(topics).map(([slug, topic]) => <a href={`/blog/topics/${slug}/`}>{topic.title}</a>)}
      </nav>
      <BlogListing posts={pagePosts} page={1} totalPages={totalPages} baseUrl="/blog/" featured={featured} />
    </div>
  </section>
  <Cta />
</Base>

<style>
  .topic-nav { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:28px; }
  .topic-nav a { border:1px solid var(--line); border-radius:var(--r-lg); padding:8px 12px; color:var(--ink); }
  .topic-nav a:hover, .topic-nav [aria-current="page"] { background:var(--bg-2); }
</style>
