---
import SeoPage from '../../layouts/SeoPage.astro';
const benefits = [
    { title: 'No localization overhead', body: 'Create one live session for every region. Ollasync avoids the cost and delay of translating, re-recording, and maintaining separate content.' },
    { title: '19+ languages in one session', body: 'Each participant chooses a language for translated audio or AI captions and can take part in the discussion.' },
    { title: 'Tools for everyday work', body: 'Use secure browser video, optional recording, attendance tracking, and AI notes in one workspace.' }
];
const faqs = [
    { question: 'How many languages does Ollasync support?', answer: 'Ollasync supports 19+ languages for live translation and captions, with each participant choosing their own language.' },
    { question: 'Does this eliminate localization costs?', answer: 'For live training and events, one source session can serve multilingual audiences without separate localized recordings or sessions.' }
];
---
<SeoPage title="Cvent Alternative for Multilingual Events" description="A Cvent alternative for interactive multilingual events, webinars, and training with zero localization costs." category="Alternatives" intro="Host global sessions with translated captions, audience interaction, and one shared workflow." benefits={benefits} faqs={faqs} />
