---
import SeoPage from '../../layouts/SeoPage.astro';
const benefits = [
  {
    "title": "Scale training programs",
    "body": "Deliver one curriculum globally without waiting for localization teams."
  },
  {
    "title": "Increase knowledge retention",
    "body": "Learners retain more information when taught in their primary language."
  },
  {
    "title": "Actionable analytics",
    "body": "Track engagement, attendance, and comprehension across your global programs."
  }
];
const faqs = [
  {
    "question": "How does this improve L&D metrics?",
