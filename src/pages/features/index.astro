---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { FEATURES } from '../../data/features';
import { LANG_COUNT } from '../../data/languages';

const title = 'AI Classroom Features — Translation, Webinars';
const description =
  `Everything Ollasync does: live translation in ${LANG_COUNT} languages, AI class notes, webinars, access-controlled recordings and confidential deal rooms.`;
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="One platform"
    eyebrowIcon="layers"
    crumbs={[{ label: 'Features' }]}
    title="Everything a meeting needs —"
    titleAccent="under one encryption model"
    lead="Live translation, AI meetings and class notes, webinars, recordings and deal rooms — one product, one hosted service, built to the same standard end to end."
  />
  <section class="section" style="padding-top:32px">
    <div class="container">
      <div class="feature-rows" data-reveal>
        {FEATURES.map((f) => (
          <a href={`/features/${f.slug}`} class="feature-row card card--hover">
            <div class="card__icon"><Icon name={f.icon} size={20} /></div>
            <div>
              <h2 class="h3" style="display:flex;align-items:center;gap:8px">{f.label} <span class="fr-arrow"><Icon name="arrow" size={16} /></span></h2>
              <p style="margin-top:6px">{f.lead}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</Base>
<style>
  .feature-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .feature-row { display: flex; gap: 16px; align-items: flex-start; }
  .feature-row .card__icon { margin-bottom: 0; flex: none; }
  .feature-row p { color: var(--muted); font-size: 14.5px; }
  .fr-arrow { color: var(--muted); opacity: 0; transform: translateX(-4px); transition: all var(--dur) ease; }
  .feature-row:hover .fr-arrow { opacity: 1; transform: none; color: var(--iris); }
  @media (max-width: 900px) { .feature-rows { grid-template-columns: 1fr; } }
</style>
