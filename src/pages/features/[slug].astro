---
// One feature, one true page: hero → how it works (a real sequence) → capabilities → deeper sections → how it's
// secured → works-with → FAQ (FAQPage JSON-LD via <Faq>) → CTA. Everything renders from data/features.ts.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { FEATURES } from '../../data/features';
import { USE_CASES } from '../../data/useCases';
import { SITE } from '../../consts';

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const others = FEATURES.filter((x) => x.slug !== f.slug);
// "Works with": resolve related slugs to real pages (feature, use case or the languages hub)
const related = (f.related || []).map((r) => {
  if (r === '/languages') return { href: '/languages', label: 'All languages', icon: 'globe' };
  if (r.startsWith('use-cases/')) { const u = USE_CASES.find((x) => x.slug === r.slice(10)); return u ? { href: `/use-cases/${u.slug}`, label: `For ${u.label.toLowerCase()}`, icon: u.icon } : null; }
  const o = FEATURES.find((x) => x.slug === r); return o ? { href: `/features/${o.slug}`, label: o.label, icon: o.icon } : null;
}).filter(Boolean) as { href: string; label: string; icon: string }[];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `Ollasync — ${f.label}`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web browser',
  description: f.metaDescription,
  url: new URL(`/features/${f.slug}/`, SITE.url).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Free to start; per-seat plans' },
};
---
<Base title={f.metaTitle} description={f.metaDescription} schema={schema}>
  <PageHero
    eyebrow={f.eyebrow}
    eyebrowIcon={f.icon}
    crumbs={[{ label: 'Features', href: '/features' }, { label: f.label }]}
    title={f.title}
    titleAccent={f.titleAccent}
    lead={f.lead}
  >
    <div class="hero__cta" data-reveal style="margin-top:28px;display:flex;flex-wrap:wrap;gap:14px">
      <a href={SITE.appUrl} class="btn btn-primary">Start free <span class="arrow">→</span></a>
      <a href="/contact" class="btn btn-ghost">Book a demo</a>
    </div>
  </PageHero>

  {f.steps && f.steps.length > 0 && (
    <section class="section" style="padding-top:34px">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow-label">How it works</span>
          <h2 class="h2" style="margin-top:12px">Three steps, no setup per learner</h2>
        </div>
        <ol class="steps" data-reveal>
          {f.steps.map((st, i) => (
            <li class="step card">
              <span class="step__n">{i + 1}</span>
              <h3 class="h3">{st.title}</h3>
              <p>{st.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- CAPABILITIES -->
  <section class="section" style="padding-top:12px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Capabilities</span>
        <h2 class="h2" style="margin-top:12px">What you get</h2>
      </div>
      <div class="grid grid-3" data-reveal>
        {f.capabilities.map((c) => (
          <div class="card card--hover">
            <div class="card__icon"><Icon name={c.icon} size={20} /></div>
            <h3 class="h3">{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {(f.sections || []).map((sec, i) => (
    <section class={"section" + (i % 2 === 0 ? ' band' : '')} style="padding-top:34px;padding-bottom:34px">
      <div class="container">
        <div class="deep" data-reveal>
          <div>
            <span class="eyebrow-label">{sec.eyebrow}</span>
            <h2 class="h2" style="margin-top:12px;max-width:22ch">{sec.title}</h2>
          </div>
          <div>
            <p class="lead" style="max-width:62ch">{sec.body}</p>
            {sec.bullets && (
              <ul class="deep__list">
                {sec.bullets.map((b) => <li><Icon name="check-circle" size={16} stroke="var(--teal)" /> {b}</li>)}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- SECURITY NOTE -->
  <section class="section" style="padding-top:34px">
    <div class="container">
      <div class="secnote panel" data-reveal>
        <div class="card__icon card__icon--teal" style="margin-bottom:0"><Icon name="shield-check" size={22} /></div>
        <div>
          <span class="eyebrow-label">How it’s secured</span>
          <p class="lead" style="margin-top:10px;max-width:70ch">{f.securityNote}</p>
          <a href="/security" class="btn btn-ghost" style="margin-top:18px">Read the full security model <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section" style="padding-top:12px">
      <div class="container">
        <div class="section-head" data-reveal><h2 class="h3">Works with</h2></div>
        <div class="explore" data-reveal>
          {related.map((r) => <a href={r.href} class="chip explore__chip"><Icon name={r.icon} size={15} /> {r.label}</a>)}
        </div>
      </div>
    </section>
  )}

  <Faq items={f.faq} title={`${f.label} — questions`} />

  <!-- EXPLORE MORE -->
  <section class="section" style="padding-top:12px">
    <div class="container">
      <div class="section-head" data-reveal><h2 class="h3">Explore the rest of the platform</h2></div>
      <div class="explore" data-reveal>
        {others.map((o) => (
          <a href={`/features/${o.slug}`} class="chip explore__chip"><Icon name={o.icon} size={15} /> {o.label}</a>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* Layout only — colours, radii, shadows and type from the tokens. Caps live on TEXT, never on containers. */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: step; }
  .step { position: relative; padding-top: 22px; }
  .step__n {
    position: absolute; top: -14px; left: 18px; width: 30px; height: 30px; border-radius: 50%;
    display: grid; place-items: center; background: var(--grad-accent); color: #fff; font-weight: 900; font-size: 13px; box-shadow: var(--sh-btn);
  }
  .deep { display: grid; grid-template-columns: 1fr 1.3fr; gap: 32px; align-items: start; }
  .deep__list { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }
  .deep__list li { display: flex; gap: 10px; align-items: flex-start; color: var(--ink-2); font-size: 15px; line-height: 1.5; }
  .deep__list li :global(svg) { flex: none; margin-top: 3px; }
  .band { background: var(--bg-2); border-block: 1px solid var(--line); }
  .secnote { display: flex; gap: 20px; align-items: flex-start; padding: clamp(24px,3vw,36px); }
  .secnote .card__icon { flex: none; }
  .explore { display: flex; flex-wrap: wrap; gap: 12px; }
  .explore__chip { padding: 10px 16px; font-size: 14px; }
  .explore__chip:hover { border-color: var(--violet-300); color: var(--ink); }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; } .deep { grid-template-columns: 1fr; gap: 16px; } }
  @media (max-width: 640px) { .secnote { flex-direction: column; } }
</style>
