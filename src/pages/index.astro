---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SecurityBadges from '../components/SecurityBadges.astro';
import CodeExample from '../components/CodeExample.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Quick - Sovereign Messaging">
  <Hero />
  <SecurityBadges />
  <FeatureGrid />
  <CodeExample />
  
  <!-- CTA Section -->
  <section class="py-24 bg-gradient-to-br from-primary-900/20 to-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Ready to deploy your own messaging infrastructure?
      </h2>
      <p class="text-slate-400 text-lg mb-8 max-w-2xl mx-auto">
        Complete source code available on GitHub. Deploy on your own servers with full control over your data.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/docs" class="w-full sm:w-auto px-8 py-4 bg-primary-600 hover:bg-primary-500 text-white font-semibold rounded-lg transition-all hover:scale-105">
          Read Documentation
        </a>
        <a href="https://github.com/vikasswaminh/quick" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg transition-all border border-slate-700">
          View on GitHub
        </a>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>
