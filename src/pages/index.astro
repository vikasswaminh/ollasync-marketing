    justify-content: center;
    flex-wrap: nowrap;
    gap: 14px;
    font-size: 14px;
    font-weight: 800;
    color: #082136;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .caption-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .caption-dot.dot--teal {
    background-color: #00bfa5;
  }

  .caption-dot.dot--purple {
    background-color: #7c3aed;
  }

  .caption-dot.dot--blue {
    background-color: #0284c7;
  }

  @media (max-width: 640px) {
    .hero-brand-caption {
      font-size: 10.5px;
      gap: 6px;
      letter-spacing: 0.08em;
    }
  }

  /* ---------- MARQUEE TRUST BAR (CONTIGUOUS TAN COLUMNS) ---------- */
  .section-trust {
    background: #f8f7f4;
    border-top: 1px solid #eae7df;
    border-bottom: 1px solid #eae7df;
    padding: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .marquee {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    user-select: none;
    width: 100%;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: max-content;
    animation: scroll-marquee 46s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  @keyframes scroll-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Contiguous Column Box: Tan background, hairline border divider, icon on top, text below */
  .trust-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    width: 205px;
    padding: 18px 16px;
    background: #f8f7f4;
    border-right: 1px solid #eae7df;
    border-radius: 0;
    box-shadow: none;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .trust-chip:hover {
    background: #ffffff;
  }

  .trust-chip__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(0, 191, 165, 0.1);
    border: 1px solid rgba(0, 191, 165, 0.22);
    color: #0c7c72;
    flex-shrink: 0;
  }

  .trust-chip__label {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink-2, #1e293b);
    line-height: 1.35;
    text-align: center;
    display: block;
  }

  /* ---------- BENTO GRID & GALLERY SECTION ---------- */
  .section-bento {
    background: transparent;
    border: none;
    padding-block: 48px 96px;
    position: relative;
    z-index: 2;
  }

  .eyebrow--blue {
    background: transparent;
    border: none;
    padding: 0;
    color: #0284c7;
  }

  .dot--blue {
    background: #0284c7;
    box-shadow: 0 0 8px #0284c7;
  }

  /* ---------- CAPABILITIES 3-COLUMN LAYOUT (EQUAL HEIGHT & PROPORTIONS) ---------- */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    align-items: stretch;
  }

  .cap-col {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cap-card {
    border-radius: 22px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    box-shadow: 0 20px 44px -10px rgba(15, 23, 42, 0.16), 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .cap-card:hover {
    transform: translateY(-8px) scale(1.015);
    box-shadow: 0 32px 64px -14px rgba(2, 132, 199, 0.3), 0 0 0 1.5px rgba(0, 191, 165, 0.45);
  }

  .cap-card--white {
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.9);
  }

  .cap-card--vibrant {
    background: linear-gradient(145deg, #00bfa5 0%, #0284c7 100%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 24px 50px -10px rgba(2, 132, 199, 0.4);
    color: #ffffff;
  }

  .cap-card--vibrant:hover {
    box-shadow: 0 38px 74px -12px rgba(2, 132, 199, 0.6), 0 0 0 2px #ffffff;
  }

  .cap-card__intro {
    display: flex;
    flex-direction: column;
    min-height: 154px;
  }

  .cap-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .center-header {
    justify-content: center;
  }

  .cap-tag {
    font-size: 11px;
    font-weight: 750;
    color: #0f766e;
    letter-spacing: 0.07em;
  }

  .cap-badge {
    font-size: 10.5px;
    font-weight: 700;
    color: #0f766e;
    background: rgba(0, 191, 165, 0.08);
    border: 1px solid rgba(0, 191, 165, 0.25);
    padding: 3px 9px;
    border-radius: var(--r-pill);
  }

  .cap-pill-badge {
    font-size: 11px;
    font-weight: 750;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 4px 12px;
    border-radius: var(--r-pill);
    letter-spacing: 0.06em;
  }

  .cap-card__title {
    font-size: 21px;
    font-weight: 750;
    color: #090d16;
    line-height: 1.28;
    margin-top: 12px;
    margin-bottom: 0;
  }

  .cap-card__desc {
    font-size: 13.5px;
    color: #475569;
    line-height: 1.5;
    margin-top: 10px;
    margin-bottom: 0;
  }

  .cap-visual-box {
    margin-top: 18px;
    margin-bottom: 0;
    width: 100%;
    height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Consistent video frame and sizing across all cards */
  .video-device-frame {
    background: #090d16;
    border: 1px solid rgba(0, 191, 165, 0.35);
    border-radius: 14px;
    padding: 6px;
    box-shadow: 0 14px 32px -6px rgba(0, 0, 0, 0.3);
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .video-device-top {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 6px 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 5px;
    flex-shrink: 0;
  }

  .video-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00bfa5;
    box-shadow: 0 0 6px #00bfa5;
    animation: pulse 2s infinite;
  }

  .video-status-text {
    font-size: 9px;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }

  .bento-video {
    width: 100%;
    height: 100%;
    flex: 1;
    min-height: 0;
    object-fit: cover;
    border-radius: 10px;
    display: block;
    background: #000;
  }

  /* Document Diligence Mock Graphic */
  .cap-document-preview {
    background: #f8fafc;
    border: 1.5px dashed rgba(124, 58, 237, 0.35);
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    gap: 8px;
  }

  /* Document skeleton lines for the deal rooms card */
  .doc-body-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 2px 0;
  }

  .doc-line {
    height: 6px;
    background: #e2e8f0;
    border-radius: 4px;
  }

  .doc-header {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .doc-name {
    font-size: 10.5px;
    font-weight: 700;
    color: #475569;
  }

  .doc-watermark-overlay {
    background: rgba(124, 58, 237, 0.06);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 8px;
    padding: 14px 10px;
    text-align: center;
    flex-shrink: 0;
  }

  .watermark-text {
    color: #7c3aed;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    display: block;
  }

  .watermark-sub {
    color: #64748b;
    font-size: 8.5px;
    margin-top: 3px;
    display: block;
  }

  .cap-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid #f1f5f9;
    padding-top: 14px;
    margin-top: auto;
  }

  .cap-footer-title {
    font-size: 10.5px;
    font-weight: 750;
    color: var(--ink-2);
    letter-spacing: 0.05em;
  }

  .cap-pill-price {
    font-size: 10.5px;
    font-weight: 750;
    color: #0f766e;
    background: rgba(0, 191, 165, 0.08);
    border: 1px solid rgba(0, 191, 165, 0.25);
    padding: 3px 8px;
    border-radius: var(--r-pill);
  }

  .cap-vibrant-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 14px;
    margin-top: auto;
  }

  /* Horizontal Banner */
  .cap-banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .cap-banner-headline {
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  /* Self-Host Strip */
  .cap-selfhost-strip {
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    padding: 16px 20px;
    box-shadow: 0 16px 36px -10px rgba(15, 23, 42, 0.1);
  }

  .selfhost-dock-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .dock-strip-img {
    width: 100%;
    max-width: 980px;
    height: auto;
    max-height: 80px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.18));
  }

  /* ---------- SCROLL FADE-IN ANIMATIONS FOR CAPABILITIES ---------- */
  [data-cap-reveal] {
    opacity: 0;
    transform: translateY(44px) scale(0.96);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--cap-delay, 0s);
    will-change: opacity, transform;
  }

  [data-cap-reveal].is-cap-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* ---------- BATTLE TABLE ---------- */
  .battle-table {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-card);
    background: #ffffff;
    overflow: hidden;
  }

  /* Seamless Floating Gradient Column Card (#7128F5 bottom-left to #03DDBE top-right) */
  .battle-ollasync-glow-card {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(27.06% + 8px);
    width: calc(38.82% - 16px);
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(3, 221, 190, 0.04) 0%, rgba(113, 40, 245, 0.03) 100%);
    border: 3.5px solid transparent;
    background-image: linear-gradient(#ffffff, #ffffff), linear-gradient(45deg, #7128F5 0%, #03DDBE 100%);
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    box-shadow: 0 12px 36px -6px rgba(113, 40, 245, 0.28), 0 0 24px rgba(3, 221, 190, 0.2);
    pointer-events: none;
    z-index: 1;
  }

  .battle-header {
    display: grid;
    grid-template-columns: 1.15fr 1.65fr 1.45fr;
    background: transparent;
    border-bottom: 1px solid var(--border);
    padding: 16px 22px;
    font-size: 13.5px;
    font-weight: 750;
    color: var(--ink-2);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .battle-header > .battle-col:not(.battle-col--ollasync) {
    color: var(--ink-2);
  }

  .battle-rows {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .battle-row {
    display: grid;
    grid-template-columns: 1.15fr 1.65fr 1.45fr;
    padding: 14px 22px;
    border-bottom: 1px solid var(--border-subtle);
    align-items: center;
    font-size: 14px;
    transition: background var(--dur) ease;
    background: transparent;
  }

  .battle-row:hover {
    background: rgba(248, 250, 252, 0.6);
  }

  .battle-row:last-child {
    border-bottom: none;
  }

  .battle-col {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .battle-col--ollasync {
    color: #0f766e;
    padding-inline: 14px;
  }

  .battle-status {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex: none;
    font-size: 10.5px;
    font-weight: bold;
  }

  .battle-status--win {
    background: rgba(0, 191, 165, 0.12);
    border: 1px solid rgba(0, 191, 165, 0.4);
    color: #0f766e;
  }

  .battle-status--lose {
    background: #fee2e2;
    border: 1px solid #fca5a5;
    color: #dc2626;
  }

  .battle-text {
    color: var(--ink);
    font-weight: 550;
  }

  .battle-text--muted {
    color: var(--muted);
    font-weight: 450;
  }

  /* ---------- CRYPTO FLOW SHOWCASE (SLIDING CODE TRANSIT) ---------- */
  .crypto-showcase {
    padding: 24px;
    background: #f8f7f4;
    border: 1px solid #e7e3da;
    border-radius: var(--r-card, 16px);
    box-shadow: 0 4px 20px -4px rgba(28, 25, 23, 0.05), 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .crypto-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 16px;
    align-items: center;
  }

  .crypto-node {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .crypto-node__badge {
    font-size: 10.5px;
    font-weight: 750;
    color: #0f766e;
    letter-spacing: 0.04em;
  }

  .crypto-node__badge--server {
    color: #dc2626;
  }

  .crypto-node__box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--r);
    padding: 16px 14px;
    text-align: center;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .crypto-node--server .crypto-node__box {
    border-color: #fecaca;
    background: #fef2f2;
  }

  .node-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
  }

  .crypto-input-box {
    overflow: hidden;
    position: relative;
    width: 100%;
    height: 34px;
    margin-top: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    display: flex;
    align-items: center;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  .crypto-input-box--server {
    border-color: #fca5a5;
    background: #ffffff;
  }

  .crypto-text-payload {
    position: absolute;
    left: 0;
    font-size: 11px;
    color: #0f766e;
    white-space: nowrap;
    will-change: transform, opacity;
    opacity: 0;
    pointer-events: none;
  }

  .crypto-text-payload--server {
    color: #b91c1c;
  }

  .crypto-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 9.5px;
    color: #0f766e;
    user-select: none;
    min-width: 120px;
  }

  .crypto-arrow__lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .crypto-arrow__text {
    color: var(--muted);
    font-weight: 550;
    font-size: 9px;
  }

  .crypto-arrow__line {
    color: #00bfa5;
    letter-spacing: -2px;
    font-weight: 700;
    font-size: 12px;
  }

  .crypto-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid #eae6dc;
  }

  .crypto-guarantee {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .badge-soft {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #0f766e;
    background: rgba(0, 191, 165, 0.08);
    border: 1px solid rgba(0, 191, 165, 0.25);
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  /* ---------- REGULATED VERTICALS (CRIMSON/RED GRADIENT & CAROUSEL) ---------- */
  .section-verticals {
    padding-block: 54px 44px;
  }

  .section--crimson {
    background: linear-gradient(140deg, #881337 0%, #9f1239 35%, #7f1d1d 70%, #450a0a 100%);
    border-block: 1px solid rgba(255, 255, 255, 0.15);
    position: relative;
    overflow: hidden;
  }

  .eyebrow--crimson {
    background: transparent;
    border: none;
    padding: 0;
    color: #ffffff;
  }

  .dot--white {
    background: #ffffff;
    box-shadow: 0 0 8px #ffffff;
  }

  .text-white {
    color: #ffffff !important;
  }

  .text-white-muted {
    color: rgba(255, 255, 255, 0.88) !important;
  }

  .usecase-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 24px), transparent 100%);
  }

  .usecase-carousel {
    display: flex;
    gap: 16px;
    padding-block: 6px 14px;
    padding-inline: 12px;
    will-change: transform;
    width: max-content;
  }

  .usecase-card {
    flex: 0 0 350px;
    min-width: 320px;
    max-width: 370px;
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 14px;
    padding: 16px 20px 14px;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .usecase-card:hover {
    transform: translateY(-3px);
    box-shadow: none;
  }

  .usecase-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 8px;
  }

  .usecase-card__tag {
    font-size: 10px;
    font-weight: 750;
    color: #b91c1c;
    letter-spacing: 0.05em;
  }

  .usecase-card__badge {
    font-size: 9px;
    font-weight: 700;
    color: #475569;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 2px 6px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }

  .usecase-card__title {
    font-size: 15.5px;
    font-weight: 750;
    color: #090d16;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .usecase-card__body {
    font-size: 12px;
    color: #475569;
    line-height: 1.45;
    margin-top: 6px;
  }

  .usecase-card__divider {
    border-top: 1px dashed #e2e8f0;
    margin-block: 10px;
  }

  .usecase-card__capabilities {
    display: flex;
    flex-direction: column;
    margin-bottom: 8px;
  }

  .cap-heading {
    font-size: 9.5px;
    font-weight: 750;
    color: #64748b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .cap-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cap-item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 11.5px;
    color: #1e293b;
    line-height: 1.35;
  }

  .cap-bullet {
    color: #b91c1c;
    font-weight: bold;
    flex: none;
    font-size: 12px;
    line-height: 1;
    margin-top: 2px;
  }

  .usecase-card__link {
    margin-top: auto;
    padding-top: 10px;
    font-size: 12px;
    font-weight: 650;
    color: #0f766e;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
  }

  .usecase-card__link:hover {
    color: #0d9488;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 16px;
  }

