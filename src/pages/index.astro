  <script>
    function initUseCaseCarousel() {
      const carousel = document.getElementById('useCaseCarousel');
      const wrapper = document.querySelector('.usecase-carousel-wrapper');
      const prevBtn = document.getElementById('carouselPrevBtn');
      const nextBtn = document.getElementById('carouselNextBtn');
      const dots = document.querySelectorAll('.indicator-dot');

      if (!carousel || !prevBtn || !nextBtn || !dots.length) return;

      let isAnimating = false;
      let autoPlayTimer: any = null;

      const updateActiveDot = () => {
        const firstCard = carousel.firstElementChild as HTMLElement;
        if (!firstCard) return;
        const activeIdx = parseInt(firstCard.getAttribute('data-index') || '0', 10);
        dots.forEach((d, i) => {
          if (i === activeIdx) {
            d.classList.add('is-active');
          } else {
            d.classList.remove('is-active');
          }
        });
      };

      const getStep = () => {
        const firstCard = carousel.firstElementChild as HTMLElement;
        return firstCard ? firstCard.offsetWidth + 16 : 366;
      };

      const slideNext = () => {
        if (isAnimating || carousel.children.length < 2) return;
        isAnimating = true;
        const step = getStep();
        const firstCard = carousel.firstElementChild as HTMLElement;

        carousel.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        carousel.style.transform = `translateX(-${step}px)`;

        const handleTransitionEnd = () => {
          carousel.removeEventListener('transitionend', handleTransitionEnd);
          carousel.style.transition = 'none';
          carousel.appendChild(firstCard); // Places starting card at the very end of the row
          carousel.style.transform = 'translateX(0)';
          void carousel.offsetHeight; // Force reflow
          updateActiveDot();
          isAnimating = false;
        };

        carousel.addEventListener('transitionend', handleTransitionEnd, { once: true });
      };

      const slidePrev = () => {
        if (isAnimating || carousel.children.length < 2) return;
        isAnimating = true;
        const step = getStep();
        const lastCard = carousel.lastElementChild as HTMLElement;

        carousel.style.transition = 'none';
        carousel.insertBefore(lastCard, carousel.firstElementChild); // Pulls last card to the front
        carousel.style.transform = `translateX(-${step}px)`;
        void carousel.offsetHeight; // Force reflow

        carousel.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        carousel.style.transform = 'translateX(0)';

        const handleTransitionEnd = () => {
          carousel.removeEventListener('transitionend', handleTransitionEnd);
          carousel.style.transition = 'none';
          updateActiveDot();
          isAnimating = false;
        };

        carousel.addEventListener('transitionend', handleTransitionEnd, { once: true });
      };

      const startAutoPlay = () => {
        stopAutoPlay();
        autoPlayTimer = setInterval(() => {
          slideNext();
        }, 2000);
      };

      const stopAutoPlay = () => {
        if (autoPlayTimer) {
          clearInterval(autoPlayTimer);
          autoPlayTimer = null;
        }
      };

      prevBtn.addEventListener('click', () => {
        slidePrev();
        startAutoPlay();
      });

      nextBtn.addEventListener('click', () => {
        slideNext();
        startAutoPlay();
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          if (isAnimating) return;
          const currentFirst = carousel.firstElementChild as HTMLElement;
          const currentIdx = parseInt(currentFirst?.getAttribute('data-index') || '0', 10);
          if (currentIdx === idx) return;

          const diff = (idx - currentIdx + dots.length) % dots.length;
          if (diff <= dots.length / 2) {
            slideNext();
          } else {
            slidePrev();
          }
          startAutoPlay();
        });
      });

      // Pause on hover or touch, resume when mouse leaves
      if (wrapper) {
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);
        wrapper.addEventListener('touchstart', stopAutoPlay, { passive: true });
        wrapper.addEventListener('touchend', startAutoPlay, { passive: true });
      }

      updateActiveDot();
      startAutoPlay();
    }

    function initCryptoFlowAnimation() {
      const s1 = document.getElementById('codeSnippet1');
      const s2 = document.getElementById('codeSnippet2');
      const s3 = document.getElementById('codeSnippet3');

      if (!s1 || !s2 || !s3) return;

      const DURATION_SLIDE = 2600; // ms to traverse across one box (slower, readable pace)
      const TRANSIT_GAP = 300;      // ms travel time between boxes

      const CIPHER_TEXT = '9f2a·c701·b83e·44da...';
      const DECRYPT_TEXT = 'MLS.decrypt(cipher, key)';
      const ENCRYPT_TEXT = 'MLS.encrypt(stream, key)';

      const chars = '0123456789abcdef!@#$%&*?';

      function scrambleDecrypt(element: HTMLElement, targetText: string, durationMs = 1100) {
        const length = targetText.length;
        const startTime = performance.now();
        
        const scrambleInterval = setInterval(() => {
          const elapsed = performance.now() - startTime;
          const progress = Math.min(1, elapsed / durationMs);
          
          const resolvedCount = Math.floor(progress * length);
          let output = targetText.slice(0, resolvedCount);
          
          for (let i = resolvedCount; i < length; i++) {
            const char = targetText[i];
            if (char === ' ' || char === '(' || char === ')' || char === ',' || char === '.') {
              output += char;
            } else {
              output += chars[Math.floor(Math.random() * chars.length)];
            }
          }
          
          element.textContent = output;
          
          if (progress >= 1) {
            clearInterval(scrambleInterval);
            element.textContent = targetText;
          }
        }, 35);
      }

      function slideThrough(el: HTMLElement, duration: number) {
        const boxWidth = el.parentElement?.clientWidth || 260;
        const textWidth = el.offsetWidth || 180;
        const centerX = (boxWidth - textWidth) / 2;
        
        // Start 100% outside on the left
        const startX = -(textWidth + 80);
        // End 100% outside on the right
        const endX = boxWidth + 80;

        el.style.opacity = '1';

        // Glides in smoothly, slows down noticeably in the center while fully visible, then glides out smoothly
        const animation = el.animate([
          { transform: `translateX(${startX}px)`, offset: 0, easing: 'cubic-bezier(0.25, 0.8, 0.35, 1)' },
          { transform: `translateX(${centerX - 8}px)`, offset: 0.32, easing: 'cubic-bezier(0.35, 0.1, 0.65, 0.9)' },
          { transform: `translateX(${centerX + 8}px)`, offset: 0.68, easing: 'cubic-bezier(0.65, 0.05, 0.8, 0.4)' },
          { transform: `translateX(${endX}px)`, offset: 1 }
        ], {
          duration: duration,
          fill: 'forwards'
        });

        return animation;
      }

      function resetOffscreen(el: HTMLElement) {
        el.style.opacity = '0';
        el.style.transform = 'translateX(-350px)';
      }

      function runContinuousLoop() {
        // Step 1: Box 1 (Sender) - MLS.encrypt slides across with butter-smooth center ease
        s1.textContent = ENCRYPT_TEXT;
        resetOffscreen(s2);
        resetOffscreen(s3);
        slideThrough(s1, DURATION_SLIDE);

        // Step 2: Transit -> Box 2 (Relay) - Encrypted ciphertext slides across
        setTimeout(() => {
          resetOffscreen(s1);
          s2.textContent = CIPHER_TEXT;
          slideThrough(s2, DURATION_SLIDE);

          // Step 3: Transit -> Box 3 (Recipient) - Enters encrypted and scrambles/deciphers in center
          setTimeout(() => {
            resetOffscreen(s2);
            s3.textContent = CIPHER_TEXT;
            slideThrough(s3, DURATION_SLIDE);

            // As it glides through center, smoothly unscramble text
            setTimeout(() => {
              scrambleDecrypt(s3, DECRYPT_TEXT, 1100);
            }, 650);

            // Step 4: Loop back to Box 1 continuously
            setTimeout(() => {
              resetOffscreen(s3);
              runContinuousLoop();
            }, DURATION_SLIDE + TRANSIT_GAP);

          }, DURATION_SLIDE + TRANSIT_GAP);
        }, DURATION_SLIDE + TRANSIT_GAP);
      }

      resetOffscreen(s1);
      resetOffscreen(s2);
      resetOffscreen(s3);
      setTimeout(runContinuousLoop, 100);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initUseCaseCarousel();
        initCryptoFlowAnimation();
      });
    } else {
      initUseCaseCarousel();
      initCryptoFlowAnimation();
    }
  </script>

