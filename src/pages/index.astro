---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroStage from '../components/HeroStage.astro';
import Customers from '../components/Customers.astro';
import FloatingCta from '../components/FloatingCta.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';
import { LANG_COUNT, LANGUAGES } from '../data/languages';

// Strategy rule: the homepage links the two newest blog pieces (internal-linking mesh).
const latestPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const fmtDate = (dt: Date) => dt.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });

const title = 'Video Meetings with Live Translation | Ollasync';
const description = SITE.description;

// Every language named on this page is a real translate target
// (XLATE_LANGS / the server TRANSLATE_LANGS default). Nothing here is aspirational.
const benefits = [
  {
    n: '01', theme: 'Understand', head: 'Every learner can follow you.',
    copy: 'Real-time voice translation lets students follow your class in the language that works for them.',
  },
  {
    n: '02', theme: 'Focus', head: 'Teach. Don’t take notes.',
    copy: 'Generate a transcript, summary and action items from your meeting recording.',
  },
  {
    n: '03', theme: 'Grow', head: 'Your expertise is no longer local.',
    copy: 'Deliver professional live training to learners across cities, countries and languages.',
  },
];

const capabilities = [
  { icon: 'globe',    title: 'Live translation', copy: 'Learners hear your class in their language.' },
  { icon: 'video',    title: 'AI meetings',      copy: 'Browser video with screen sharing and host controls.' },
  { icon: 'sparkles', title: 'AI meeting notes',   copy: 'Transcripts and action items from recorded meetings.' },
  { icon: 'doc',      title: 'Meeting summaries',  copy: 'A full session becomes a useful recap.' },
];

const audience = [
  { title: 'Tutors',                copy: 'Teach students anywhere without losing the live-class feel.' },
  { title: 'Professional trainers', copy: 'Deliver polished programmes across locations and languages.' },
  { title: 'Coaches',               copy: 'Stay in the conversation while AI handles the language and the notes.' },
  { title: 'Teams and academies',   copy: 'Bring colleagues and learners together in interactive browser meetings.' },
];

// Internal links to the comparison pages with keyword anchors (the pillar → /vs/* edge of the SEO cluster).
const switching = [
  { href: '/vs/zoom',            title: 'Zoom alternative for online classes',       copy: 'Same one-click browser meetings, plus live translation and class notes. A fair comparison.' },
  { href: '/vs/google-meet',     title: 'Google Meet alternative for tutors',         copy: 'Where Meet stops at captions, learners here hear your class in their own language.' },
  { href: '/vs/microsoft-teams', title: 'Microsoft Teams alternative for training',   copy: 'Focused live training without the suite — webinars, recordings and notes in one workspace.' },
];
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web browser',
  description,
  featureList: [
    'Browser video meetings',
    'Real-time AI voice translation',
    'AI live captions',
    'AI meeting notes',
    'Meeting summaries',
  ],
  url: SITE.url,
};
---
<Base title={title} description={description} schema={homeSchema}>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="section hero-s" id="product">
    <div class="container hero-copy">
      <span class="hero-pill" data-reveal><span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Live translate <span class="hero-pill__dot" aria-hidden="true"></span></span>
      <h1 class="display hero-h1" data-reveal>Multilingual <span class="gradient-text">Video Meeting Platform</span></h1>
      <p class="lead" data-reveal>Expand your Market to more than 99 Languages</p>
      <div class="hero-cta" data-reveal>
        <a href={SITE.appUrl} class="btn btn-primary">Start free <span class="arrow">→</span></a>
        <a href="/features/live-translation" class="btn btn-ghost">See how it works</a>
      </div>
      <p class="hero-aud" data-reveal>No credit card</p>
      {/* Every shipped language, in the banner — the list IS src/data/languages.ts, never a bigger number. */}
      <div class="ribbon" id="languages" data-reveal aria-label={`${LANG_COUNT} live translation languages`}>
        <span class="ribbon__badge"><Icon name="globe" size={16} stroke="var(--blue)" /><strong>{LANG_COUNT} languages</strong></span>
        <ul class="ribbon__list">
          {LANGUAGES.map((l) => <li><a class="chip ribbon__chip" lang={l.code} title={l.name} aria-label={`${l.name} — live translation`} href={l.code === 'en' ? '/languages' : `/languages/${l.code}`}><b>{l.native}</b></a></li>)}
        </ul>
      </div>
    </div>

    <div class="container hero-stage">
      <HeroStage />
    </div>

  </section>

  <!-- ── OUR CUSTOMERS ────────────────────────────────────── -->
  <Customers />

  <!-- ── GLOBAL TEACHING DEMO ─────────────────────────────── -->
  <section class="section band" id="translation">
    <div class="container">
      <div class="sec-head" data-reveal>
        <h2 class="h2">One trainer. A world of learners.</h2>
        <p class="lead">Teach naturally while learners follow in the language that works for them.</p>
      </div>

      <div class="flow" data-reveal>
        <div class="flow__src">
          <span class="flow__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          <strong>You, speaking English</strong>
          <span class="muted">“Now let’s build a pivot table…”</span>
        </div>
        <span class="flow__arrow" aria-hidden="true"></span>
        <ul class="flow__out">
          <li><span class="flow__lang">Español</span><span class="flow__mode">voice</span><span class="flow__line">“Ahora vamos a crear una tabla dinámica…”</span></li>
          <li><span class="flow__lang">Français</span><span class="flow__mode">live</span><span class="flow__line">« Créons maintenant un tableau croisé… »</span></li>
          <li><span class="flow__lang">हिन्दी</span><span class="flow__mode">live</span><span class="flow__line">“अब हम एक पिवट टेबल बनाएँगे…”</span></li>
        </ul>
      </div>

      <p class="flow__close" data-reveal>You teach. AI handles the language.</p>
    </div>
  </section>

  <!-- ── THREE BENEFITS ───────────────────────────────────── -->
  <section class="section">
    <div class="container ben">
      {benefits.map((b) => (
        <article class="card ben__item" data-reveal>
          <span class="ben__n mono">{b.n}</span>
          <span class="ben__theme">{b.theme}</span>
          <h3 class="h3">{b.head}</h3>
          <p class="muted">{b.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── CLASSROOM, NOT A MEETING ─────────────────────────── -->
  <section class="section band">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow-label">BUILT FOR MEETINGS</span>
        <h2 class="h2" style="margin-top:12px">Everything you need<br />for a better meeting.</h2>
        <p class="lead" style="margin-top:16px">
          Lead the discussion with screen sharing, whiteboards and breakout rooms. Keep everyone involved with chat, polls and live translation.
        </p>
      </div>
      {/* Deliberately text, not a second mock — the hero already carries the only image on this page. */}
      <ul class="classlist" data-reveal>
        <li>
          <span class="classlist__ic"><Icon name="users" size={18} /></span>
          <div><strong>You lead the meeting</strong><span>Waiting rooms, co-hosts and participant controls keep the session in your hands.</span></div>
        </li>
        <li>
          <span class="classlist__ic"><Icon name="doc" size={18} /></span>
          <div><strong>One link brings everyone together</strong><span>Start an instant meeting or schedule a session. Guests join in their browser.</span></div>
        </li>
        <li>
          <span class="classlist__ic"><Icon name="sparkles" size={18} /></span>
          <div><strong>Keep the context after the call</strong><span>Turn a meeting recording into a searchable transcript, summary and action items.</span></div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── AI SUPPORTS THE TRAINER ──────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="sec-head" data-reveal>
        <h2 class="h2">Meet, share and follow up.</h2>
        <p class="lead">Live translation during the meeting. AI notes from your recording afterwards.</p>
      </div>
      <div class="caps" data-reveal>
        {capabilities.map((c) => (
          <div class="card caps__i">
            <span class="card__icon"><Icon name={c.icon} size={19} /></span>
            <h3 class="h3" style="font-size:17px">{c.title}</h3>
            <p class="muted" style="font-size:14px">{c.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SWITCHING (keyword-anchored internal links to the comparison pages) ── -->
  <section class="section" id="switching">
    <div class="container">
      <div class="sec-head" data-reveal>
        <h2 class="h2">A Zoom alternative built for teaching.</h2>
        <p class="lead">Keep the one-click browser meeting. Add live translation and class notes. Compare fairly.</p>
      </div>
      <div class="caps" data-reveal>
        {switching.map((s) => (
          <a class="card caps__i" href={s.href} style="display:block;text-decoration:none;color:inherit">
            <h3 class="h3" style="font-size:17px">{s.title}</h3>
            <p class="muted" style="font-size:14px">{s.copy}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ASPIRATION ───────────────────────────────────────── -->
  <section class="section band">
    <div class="container borderless" data-reveal>
      <h2 class="h2">Bring every location into the conversation.</h2>
      <div class="borderless__side">
        <p class="lead">
          The right learner may live in another city, country or language.
          Your meeting should bring you together.
        </p>
        <a href={SITE.appUrl} class="btn btn-primary">Start free <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ── AUDIENCE ─────────────────────────────────────────── -->
  <section class="section" id="for-trainers">
    <div class="container">
      <div class="sec-head" data-reveal><h2 class="h2">Built for people who teach for a living.</h2></div>
      <div class="aud" data-reveal>
        {audience.map((a) => (
          <div class="card aud__i">
            <h3 class="h3" style="font-size:17px">{a.title}</h3>
            <p class="muted" style="font-size:14px">{a.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

<!-- FROM THE BLOG (two newest pieces; strategy internal-linking rule) -->
  <section class="section band">
    <div class="container">
      <div class="sec-head" data-reveal>
        <h2 class="h2">Fresh from the blog</h2>
      </div>
      <div class="grid grid-2" data-reveal>
        {latestPosts.map((p) => (
          <a href={`/blog/${p.slug}/`} class="card card--hover">
            <span class="mono" style="font-size:12px;color:var(--muted, #5a6377)">{p.data.category} · {fmtDate(p.data.pubDate)} · {p.data.readTime} min</span>
            <h3 class="h3" style="margin-top:8px">{p.data.title}</h3>
            <p class="muted" style="font-size:14px">{p.data.description}</p>
          </a>
        ))}
      </div>
      <div style="margin-top:18px" data-reveal><a href="/blog" class="mono" style="font-size:13px">All posts →</a></div>
    </div>
  </section>

    <!-- ── FINAL CTA ────────────────────────────────────────── -->
  <section class="section">
    <div class="container final" data-reveal>
      <h2 class="display" style="font-size:clamp(32px,4.6vw,50px)">Someone wants to learn what you know.</h2>
      <p class="lead">Give them a classroom without borders.</p>
      <a href={SITE.appUrl} class="btn btn-primary btn-lg">Start free <span class="arrow">→</span></a>
    </div>
  </section>
  <FloatingCta />
</Base>

<style>
  /* Layout only — every colour, radius, shadow and type step comes from the existing tokens. */
  /* extra bottom padding so the AI-notes card, which hangs below the classroom frame,
     has room instead of colliding with the next section */
  .hero-s { padding-top: 52px; padding-bottom: 88px; }
  /* One centred column of copy above one wide image — no split, no second visual. */
  .hero-copy { text-align: center; }
  /* eyebrow as a bordered pill, not loose grey text — it gives the hero a starting point */
  .hero-pill {
    display: inline-block; padding: 6px 14px; border-radius: var(--r-pill);
    border: 1.5px solid var(--red-150); background: var(--red-050); color: var(--red);
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 700; letter-spacing: .12em;
  }
  /* One line on a desktop so the headline spans the grid instead of stacking into a narrow block. */
  .hero-h1 { font-size: clamp(45px, 5.4vw, 84px); line-height: 1.08; }
  .hero-copy .display { margin-top: 22px; }
  /* Caps live on the TEXT, never on the container — a container cap is exactly what collapsed
     two sections downpage to 501px and 185px. */
  .hero-copy .lead { margin-top: 16px; max-width: 58ch; margin-inline: auto; text-wrap: balance; font-size: 17px; }
  .hero-cta { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .hero-strip {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 22px; margin-top: 36px;
    padding-top: 20px; border-top: 1px solid var(--line);
    margin-inline: auto;
    font-size: 13.5px; color: var(--ink-2);
  }
  .hero-strip span { display: inline-flex; align-items: center; gap: 7px; }
  .hero-strip span::before {
    content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--teal); flex: none;
  }
  .hero-strip strong { font-weight: 700; color: var(--ink); }
  .hero-aud { margin-top: 14px; font-size: 13.5px; color: var(--muted); }

  /* The hero visual is real HTML (HeroStage) — same container as the copy so edges line up. */
  .hero-stage { margin-top: 28px; }
  .hero-pill { display: inline-flex; align-items: center; gap: 8px; }
  .hero-pill__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }
  .hero-pill .wave { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
  .hero-pill .wave i { width: 2px; border-radius: 1px; background: var(--blue); height: 4px; animation: heroWave 1.1s ease-in-out infinite; }
  .hero-pill .wave i:nth-child(2) { animation-delay: .14s } .hero-pill .wave i:nth-child(3) { animation-delay: .28s } .hero-pill .wave i:nth-child(4) { animation-delay: .42s }
  @keyframes heroWave { 0%, 100% { height: 4px } 50% { height: 11px } }
  /* every shipped language, as chips — static wrap, no marquee (readable, crawlable, no motion) */
  .ribbon { margin-top: 18px; display: grid; gap: 10px; justify-items: center; }
  .ribbon__badge {
    display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: var(--r-pill);
    background: var(--tint-blue); border: 1px solid var(--violet-300); color: var(--ink); font-size: 13.5px; flex-wrap: wrap; justify-content: center; text-align: center;
  }
  .ribbon__badge strong { white-space: nowrap; }
  .ribbon__badge span { color: var(--muted); }
  .ribbon__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; max-width: 1280px; }
  .ribbon__chip { display: inline-flex; align-items: baseline; gap: 6px; padding: 4px 9px; font-size: 11.5px; text-decoration: none; }
  .ribbon__chip:hover { border-color: var(--violet-300); }
  .ribbon__chip b { font-weight: 700; color: var(--ink); }
  .ribbon__chip span { color: var(--muted-2); font-size: 11px; }
  .hero-strip span :global(svg) { flex: none; }
  .hero-strip span::before { display: none; }
  @media (prefers-reduced-motion: reduce) { .hero-pill .wave i { animation: none; height: 8px; } }

  .band { background: var(--bg-2); border-block: 1px solid var(--line); }
  /* No cap on the heading block itself — only on the running text under it. A capped block is what
     made every section read as a narrow column adrift in the middle of the page. */
  .sec-head { margin-bottom: 34px; }
  .sec-head .lead { max-width: 88ch; }
  .sec-head .lead { margin-top: 12px; }

  /* translation flow */
  .flow { display: grid; grid-template-columns: 1fr auto 1.15fr; gap: 26px; align-items: center; }
  .flow__src {
    display: grid; gap: 7px; padding: 24px; border-radius: var(--r-lg);
    background: var(--panel); border: 1px solid var(--line); box-shadow: var(--sh-card);
  }
  .flow__src strong { font-size: 16px; }
  .flow__src .muted { font-size: 14px; }
  .flow__wave { display: inline-flex; align-items: flex-end; gap: 3px; height: 20px; }
  .flow__wave i { width: 3px; border-radius: 2px; background: var(--blue); height: 6px; animation: fw 1.2s ease-in-out infinite; }
  .flow__wave i:nth-child(2){animation-delay:.1s} .flow__wave i:nth-child(3){animation-delay:.2s}
  .flow__wave i:nth-child(4){animation-delay:.3s} .flow__wave i:nth-child(5){animation-delay:.4s}
  .flow__wave i:nth-child(6){animation-delay:.5s} .flow__wave i:nth-child(7){animation-delay:.6s}
  .flow__arrow { width: 34px; height: 1px; background: var(--line-2); position: relative; }
  .flow__arrow::after {
    content: ""; position: absolute; right: 0; top: -3px;
    border-left: 6px solid var(--line-2); border-block: 3.5px solid transparent;
  }
  .flow__out { list-style: none; display: grid; gap: 10px; margin: 0; padding: 0; }
  .flow__out li {
    display: grid; grid-template-columns: auto auto 1fr; gap: 12px; align-items: center;
    padding: 15px 18px; border-radius: var(--r); background: var(--panel);
    border: 1px solid var(--line); box-shadow: var(--sh-card);
  }
  .flow__lang { font-weight: 700; font-size: 14.5px; }
  .flow__mode {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--blue); background: var(--violet-050); border: 1px solid var(--violet-300);
    padding: 3px 8px; border-radius: 100px;
  }
  .flow__line { font-size: 14px; color: var(--ink-2); }
  .flow__close { margin-top: 34px; font-size: clamp(19px, 2.2vw, 24px); font-weight: 700; letter-spacing: -.02em; }

  /* benefits */
  .ben { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .ben__item { display: grid; align-content: start; gap: 9px; padding: 30px; }
  .ben__n { font-size: 12px; color: var(--red); letter-spacing: .08em; }
  .ben__theme {
    font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted-2);
  }
  .ben__item .h3 { margin-top: 2px; }

  .split { display: grid; grid-template-columns: 1fr 1.1fr; gap: 52px; align-items: center; }

  /* replaces the second ClassroomMock — same column, no image */
  .classlist { list-style: none; display: grid; gap: 12px; margin: 0; padding: 0; }
  .classlist li {
    display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start;
    padding: 18px 20px; border-radius: var(--r); background: var(--panel);
    border: 1px solid var(--line); box-shadow: var(--sh-card);
  }
  .classlist__ic {
    display: grid; place-items: center; width: 34px; height: 34px; flex: none;
    border-radius: 10px; background: var(--ink); color: #fff;
  }
  .classlist strong { display: block; font-size: 15px; }
  .classlist span:not(.classlist__ic) { display: block; margin-top: 4px; font-size: 14px; color: var(--ink-2); }

  .caps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .caps__i { display: grid; align-content: start; gap: 8px; padding: 24px; }

  /* Was `max-width: 60ch` on the CONTAINER, which pinned this section to 501px while every other
     section ran 1224px. The cap belongs on the paragraph; the section spans the full grid. */
  .borderless { display: grid; grid-template-columns: 1fr 1.1fr; gap: 52px; align-items: center; }
  .borderless__side { display: grid; gap: 20px; justify-items: start; }
  .borderless__side .lead { max-width: 62ch; }

  .aud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .aud__i { display: grid; align-content: start; gap: 7px; padding: 24px; }

  /* Same bug as .borderless — `max-width: 26ch` on the container squeezed this to 185px.
     The container is full width; the cap moved onto the heading. */
  .final { display: grid; gap: 18px; justify-items: center; text-align: center; }
  .final .display { max-width: 34ch; }
  .final .lead { max-width: 62ch; }
  .btn-lg { padding: 15px 26px; font-size: 16px; }

  @keyframes fw { 0%, 100% { height: 6px } 50% { height: 20px } }

  @media (max-width: 1000px) {
    .split, .borderless { grid-template-columns: 1fr; gap: 36px; }
    .ben, .caps, .aud { grid-template-columns: 1fr 1fr; }
    .flow { grid-template-columns: 1fr; gap: 18px; }
    .flow__arrow { display: none; }
  }
  @media (max-width: 640px) {
    .ben, .caps, .aud { grid-template-columns: 1fr; }
    .flow__out li { grid-template-columns: auto auto; row-gap: 6px; }
    .flow__line { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow__wave i { animation: none; height: 12px; }
  }
</style>
