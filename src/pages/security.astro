---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const encryptionSpecs = [
  { name: "X3DH", desc: "Extended Triple Diffie-Hellman for initial key exchange", standard: "Signal Protocol" },
  { name: "Double Ratchet", desc: "Self-healing key derivation for ongoing sessions", standard: "Signal Protocol" },
  { name: "AEAD", desc: "Authenticated encryption for messages", algorithm: "ChaCha20-Poly1305" },
  { name: "Key Derivation", desc: "Domain-separated key derivation", algorithm: "HKDF-SHA256" },
  { name: "Signatures", desc: "Ed25519 for prekey signatures", standard: "RFC 8032" },
  { name: "Key Exchange", desc: "X25519 elliptic curve", standard: "RFC 7748" },
];

const securityFixes = [
  { issue: "TOCTOU Race in Prekey Consumption", severity: "Critical", fix: "Single write lock for atomic read+consume" },
  { issue: "Gateway Auth Bypass", severity: "Critical", fix: "Mandatory mTLS with client cert validation" },
  { issue: "Hardcoded Passwords in Scripts", severity: "Critical", fix: "Environment variable requirements" },
  { issue: "Router Race Condition", severity: "High", fix: "Single lock for GetOfflineMessages" },
  { issue: "Android Main Thread Blocking", severity: "High", fix: "@WorkerThread + async wrappers" },
  { issue: "CryptoBridge isValid Bug", severity: "Medium", fix: "AtomicBoolean closed state tracking" },
];

const compliance = [
  { name: "Signal Protocol", status: "Compatible", note: "Full X3DH + Double Ratchet implementation" },
  { name: "RFC 7748 (X25519)", status: "Compliant", note: "With proper clamping" },
  { name: "RFC 8032 (Ed25519)", status: "Compliant", note: "Using ed25519-dalek" },
  { name: "OWASP Top 10", status: "Addressed", note: "31 security issues remediated" },
  { name: "Docker Security", status: "CIS Compliant", note: "no-new-privileges, read-only" },
];
---

<Layout title="Security - Quick Messaging">
  <div class="py-24 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Security Overview
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          Honest security assessment based on codebase analysis. 31 issues identified and fixed.
        </p>
      </div>
      
      <!-- Security Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        <div class="text-center p-6 bg-slate-800 rounded-xl border border-slate-700">
          <div class="text-4xl font-bold text-emerald-400 mb-2">31</div>
          <div class="text-slate-400">Security Issues Fixed</div>
        </div>
        <div class="text-center p-6 bg-slate-800 rounded-xl border border-slate-700">
          <div class="text-4xl font-bold text-primary-400 mb-2">4</div>
          <div class="text-slate-400">Critical Fixes</div>
        </div>
        <div class="text-center p-6 bg-slate-800 rounded-xl border border-slate-700">
          <div class="text-4xl font-bold text-amber-400 mb-2">Phases</div>
          <div class="text-slate-400">1-4 Complete</div>
        </div>
        <div class="text-center p-6 bg-slate-800 rounded-xl border border-slate-700">
          <div class="text-4xl font-bold text-rose-400 mb-2">Audited</div>
          <div class="text-slate-400">Production Ready</div>
        </div>
      </div>
      
      <!-- Encryption Specs -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">Encryption Specifications</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-slate-700">
                <th class="pb-4 text-slate-300 font-medium">Component</th>
                <th class="pb-4 text-slate-300 font-medium">Description</th>
                <th class="pb-4 text-slate-300 font-medium">Standard/Algorithm</th>
              </tr>
            </thead>
            <tbody class="text-slate-400">
              {encryptionSpecs.map((spec) => (
                <tr class="border-b border-slate-800">
                  <td class="py-4 font-medium text-white">{spec.name}</td>
                  <td class="py-4">{spec.desc}</td>
                  <td class="py-4">
                    <span class="px-2 py-1 bg-primary-500/10 text-primary-400 rounded text-sm">
                      {spec.standard || spec.algorithm}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Security Fixes (Honest) -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">Security Audit Results</h2>
        <p class="text-slate-400 mb-6">
          Full transparency: These issues were identified in our security audit and have been remediated.
          <a href="https://raw.githubusercontent.com/vikasswaminh/quick/main/AUDIT_MASTER_REPORT.md" target="_blank" class="text-primary-400 hover:underline">View full audit report</a>.
        </p>
        <div class="space-y-4">
          {securityFixes.map((fix) => (
            <div class="p-4 bg-slate-800 rounded-lg border border-slate-700 flex items-start">
              <div class={`w-3 h-3 rounded-full mt-1.5 mr-4 ${
                fix.severity === 'Critical' ? 'bg-rose-500' : 
                fix.severity === 'High' ? 'bg-amber-500' : 'bg-yellow-500'
              }`}></div>
              <div class="flex-1">
                <div class="flex items-center mb-1">
                  <span class="font-medium text-white mr-3">{fix.issue}</span>
                  <span class={`text-xs px-2 py-0.5 rounded ${
                    fix.severity === 'Critical' ? 'bg-rose-500/20 text-rose-400' : 
                    fix.severity === 'High' ? 'bg-amber-500/20 text-amber-400' : 'bg-yellow-500/20 text-yellow-400'
                  }`}>
                    {fix.severity}
                  </span>
                </div>
                <p class="text-sm text-slate-400">Fix: {fix.fix}</p>
              </div>
              <svg class="w-5 h-5 text-emerald-400 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Compliance -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">Standards Compliance</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {compliance.map((item) => (
            <div class="p-4 bg-slate-800 rounded-lg border border-slate-700">
              <div class="flex items-center justify-between mb-2">
                <span class="font-medium text-white">{item.name}</span>
                <span class="text-xs px-2 py-1 bg-emerald-500/20 text-emerald-400 rounded">{item.status}</span>
              </div>
              <p class="text-sm text-slate-400">{item.note}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Architecture Security -->
      <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
        <h2 class="text-2xl font-bold text-white mb-6">Security Architecture</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-semibold text-white mb-3">Transport Security</h3>
            <ul class="space-y-2 text-slate-400">
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                TLS 1.3 minimum
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Mandatory mTLS (gateway)
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Certificate pinning (Android)
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                0-RTT disabled (replay protection)
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-3">Application Security</h3>
            <ul class="space-y-2 text-slate-400">
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                JWT authentication (HS256)
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Rate limiting (100 req/min)
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Path traversal protection
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Input validation & sanitization
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <Footer />
</Layout>
