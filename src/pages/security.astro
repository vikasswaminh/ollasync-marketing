---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';

const title = 'Security & Encryption — End-to-End Encrypted Meetings';
const description =
  'How Ollasync protects your meetings — end-to-end encryption for video, chat and screen share, encrypted transit on every call, role-based access control and a full audit trail.';

const matrix = [
  {
    icon: 'video', title: 'Live meeting video & audio',
    status: 'End-to-end encrypted · encrypted in transit', tone: 'violet',
    body: 'Every call travels over an encrypted transport. End-to-end encryption protects the media per frame under a key generated in your browser — the server relays ciphertext it cannot read.',
  },
  {
    icon: 'chat', title: 'In-meeting chat & DMs',
    status: 'End-to-end encrypted (in an E2EE meeting)', tone: 'teal',
    body: 'When a meeting is end-to-end encrypted, chat and 1:1 direct messages are encrypted in your browser with AES-GCM under a key that never reaches our servers — we store only ciphertext. In a standard meeting they’re encrypted in transit but server-readable.',
  },
  {
    icon: 'play', title: 'Recordings',
    status: 'Access-controlled · Private', tone: 'neutral',
    body: 'When enabled, recordings are written to private storage in your workspace and restricted to authorised viewers via short-lived links. Recording decodes media server-side, so end-to-end-encrypted meetings are excluded by design.',
  },
];

const serverSees = {
  cannot: [
    'The video, chat and messages of a meeting you end-to-end encrypt (AES-GCM, ciphertext only)',
    'The encryption key for an E2EE meeting — it stays in your browser (in the invite link); we keep only a hash of it',
    'A recording or transcript of an E2EE meeting — those can’t be produced without the key',
  ],
  can: [
    'Meeting metadata: who is connected, when, the room identifier, timing',
    'The media of a standard (non-E2EE) meeting — encrypted in transit, but readable server-side',
    'Meeting recordings you choose to store with us — encrypted at rest, access-controlled',
  ],
};

const access = [
  { icon: 'fingerprint', title: 'Strong identity', body: 'Sign-in with email + password, magic-link, TOTP two-factor and passkeys (WebAuthn/FIDO2). OIDC single sign-on to your own IdP — Okta, Entra ID, Google Workspace and more.' },
  { icon: 'lock', title: 'Rooms default-closed', body: 'A guest needs an invite or the meeting id, and the host admits them from a waiting room before anything flows. Room tokens are short-lived and scoped to a single room with a role.' },
];

const transparency = [
  { title: 'End-to-end encrypted meetings', body: 'Video, chat and screen share are encrypted in the browser, under a key held by the participants. The service stores ciphertext it cannot read.' },
  { title: 'Encrypted transit on every meeting', body: 'All meeting media travels over an encrypted transport, with per-session keys negotiated for the call.' },
  { title: 'Private hosting with a DPA', body: 'Meetings and recordings live on our hosted service under a data-processing agreement, in private storage.' },
];

const verify = [
  { icon: 'shield-check', title: 'The key stays with you', body: 'When you turn on end-to-end encryption, the meeting key is generated in your browser and rides only in the invite-link fragment — it never reaches our servers, which store only a SHA-256 hash of it.' },
  { icon: 'layers', title: 'Tenant isolation', body: 'An automated test asserts one organisation cannot read or even list another organisation’s data.' },
  { icon: 'gauge', title: 'Nightly end-to-end suites', body: 'Identity, workspace access and the full in-call feature set run every night against the live stack, with results reported on failure.' },
  { icon: 'route', title: 'Contract conformance', body: 'Every API route is checked against its documented contract on every build.' },
];

const faq = [
  { q: 'How is my meeting encrypted?', a: 'Every meeting is encrypted in transit. End-to-end encryption protects media, chat and messages in your browser with AES-GCM under a key we never receive — we store only ciphertext and a hash of the key.' },
  { q: 'How is meeting video protected?', a: 'Every call is encrypted in transit, and end-to-end encryption protects the media per frame under a key held only in the participants’ browsers.' },
  { q: 'Do you hold any of my keys?', a: 'For an end-to-end-encrypted meeting, no — the key is generated on your device and rides in the invite link; we keep only a hash of it. For a standard meeting, transport keys are negotiated per WebRTC session as normal.' },
  { q: 'Does the AI ever see my private meetings?', a: 'No. AI runs on the recordings you choose, and end-to-end-encrypted meetings are excluded — they hold no server-readable content to process.' },
  { q: 'What controls does a compliance programme get?', a: 'Encryption in transit with end-to-end encryption available, role-based access control, audit logging and a DPA.' },
  { q: 'Can a court compel you to hand over meeting content?', a: 'For an end-to-end-encrypted meeting we hold no key and store only ciphertext, so there is no readable content for us to produce — only routing metadata. For a standard meeting, media is in encrypted transit but not end-to-end encrypted.' },
];

const secSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Ollasync security & encryption model',
  description: description,
  about: ['End-to-end encryption', 'Optional E2EE video meetings', 'Access control', 'Encrypted video conferencing security'],
};
---
<Base title={title} description={description} schema={secSchema}>
  <PageHero
    eyebrow="Encryption model"
    eyebrowIcon="shield-check"
    crumbs={[{ label: 'Security' }]}
    title="Security you can"
    titleAccent="actually verify"
    lead="Exactly what each part of Ollasync protects, and how — written to survive a buyer’s security review."
  />

  <!-- ENCRYPTION MATRIX -->
  <section class="section" style="padding-top:32px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Encryption model</span>
        <h2 class="h2" style="margin-top:12px">Protection, data type by data type</h2>
      </div>
      <div class="grid grid-2" data-reveal>
        {matrix.map((m) => (
          <div class="card matrix">
            <div class="matrix__head">
              <div class={`card__icon ${m.tone === 'teal' ? 'card__icon--teal' : ''}`} style="margin-bottom:0"><Icon name={m.icon} size={20} /></div>
              <span class={`status status--${m.tone}`}>{m.status}</span>
            </div>
            <h3 class="h3" style="margin-top:16px">{m.title}</h3>
            <p style="margin-top:8px">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT THE SERVER SEES -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Trust boundary</span>
        <h2 class="h2" style="margin-top:12px">What the server can — and can’t — see</h2>
        <p class="kicker" style="margin-top:14px">For an end-to-end-encrypted meeting the claim is precise: we can’t read it. Routing metadata still has to move. Here’s the split.</p>
      </div>
      <div class="sees" data-reveal>
        <div class="sees__col sees__col--no">
          <h3 class="h3"><span class="sees__mark sees__mark--no"><Icon name="eye-off" size={16} stroke="var(--teal)" /></span>Can’t see (E2EE meeting)</h3>
          <ul class="check-list" style="margin-top:18px">
            {serverSees.cannot.map((i) => <li><span class="tick"><Icon name="check" size={12} stroke="var(--teal)" /></span>{i}</li>)}
          </ul>
        </div>
        <div class="sees__col sees__col--yes">
          <h3 class="h3"><span class="sees__mark sees__mark--yes"><Icon name="globe" size={16} stroke="var(--red)" /></span>Necessarily sees</h3>
          <ul class="plain-list" style="margin-top:18px">
            {serverSees.can.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCESS CONTROL -->
  <section class="section" style="padding-top:20px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Identity & access</span>
        <h2 class="h2" style="margin-top:12px">Who gets in, and to what</h2>
      </div>
      <div class="grid grid-4" data-reveal>
        {access.map((a) => (
          <div class="card">
            <div class="card__icon"><Icon name={a.icon} size={20} /></div>
            <h3 class="h3">{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY -->
  <section class="section">
    <div class="container">
      <div class="transp panel" data-reveal>
        <div class="transp__head">
          <span class="eyebrow eyebrow--teal"><Icon name="fingerprint" size={13} stroke="var(--teal)" /> How it protects you</span>
          <h2 class="h2" style="margin-top:16px;max-width:20ch">What every meeting gets</h2>
          <p class="lead" style="margin-top:14px;max-width:52ch">Encryption and access control built into the platform — not bolted on per plan.</p>
        </div>
        <div class="transp__grid">
          {transparency.map((t) => (
            <div class="transp__item">
              <span class="transp__dot"><Icon name="arrow" size={14} stroke="var(--blue)" /></span>
              <div>
                <h3 style="font-size:16px;font-weight:600">{t.title}</h3>
                <p class="muted" style="font-size:14px;margin-top:5px">{t.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- VERIFY -->
  <section class="section" style="padding-top:20px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Don’t take our word</span>
        <h2 class="h2" style="margin-top:12px">How a reviewer can check the claims</h2>
        <p class="kicker" style="margin-top:14px">The guarantees above are backed by how the system is built and by automated checks against the live stack.</p>
      </div>
      <div class="grid grid-4" data-reveal>
        {verify.map((v) => (
          <div class="card card--hover">
            <div class="card__icon card__icon--teal"><Icon name={v.icon} size={20} /></div>
            <h3 class="h3">{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
      <p class="muted center" style="margin-top:28px;font-size:14px">Building a compliance programme on this? See our <a href="/compliance" style="color:var(--iris)">compliance posture</a> and request the security whitepaper and DPA.</p>
    </div>
  </section>

  <Faq items={faq} title="Security questions" />
  <Cta
    title="Put it through your security review."
    sub="We wrote our security model to be defensible line by line. Request the whitepaper and DPA, or bring your questions to a call."
    primary={{ label: 'Request the whitepaper', href: '/contact' }}
    secondary={{ label: 'Compliance posture', href: '/compliance' }}
  />
</Base>

<style>
  .matrix__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .status { font-family: var(--font-mono); font-size: 11px; letter-spacing: .02em; padding: 5px 11px; border-radius: 100px; border: 1px solid; text-align: right; }
  .status--teal { color: var(--teal); background: var(--teal-050); border-color: var(--teal-150); }
  .status--violet { color: var(--blue); background: var(--violet-050); border-color: var(--violet-300); }
  .status--neutral { color: var(--ink-2); background: var(--bg-2); border-color: var(--line-2); }

  .sees { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .sees__col { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 28px; }
  .sees__col--no { background: linear-gradient(180deg, var(--teal-050), transparent); border-color: var(--teal-150); }
  .sees__col--yes { background: var(--bg-2); }
  .sees__col h3 { display: flex; align-items: center; gap: 11px; }
  .sees__mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; }
  .sees__mark--no { background: var(--teal-150); }
  .sees__mark--yes { background: rgba(255,120,120,.14); }
  .plain-list { list-style: none; display: grid; gap: 12px; }
  .plain-list li { position: relative; padding-left: 18px; color: var(--muted); font-size: 15px; }
  .plain-list li::before { content: "–"; position: absolute; left: 0; color: var(--muted-2); }

  .transp { padding: clamp(28px,4vw,44px); display: grid; grid-template-columns: .9fr 1.1fr; gap: 40px; }
  .transp__grid { display: grid; gap: 18px; }
  .transp__item { display: flex; gap: 13px; align-items: flex-start; }
  .transp__dot { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--violet-050); border: 1px solid var(--violet-300); flex: none; margin-top: 2px; }

  @media (max-width: 900px) {
    .sees, .transp { grid-template-columns: 1fr; }
  }
</style>
