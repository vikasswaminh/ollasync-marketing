---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';

const title = 'Compliance & data protection';
const description =
  'GDPR data-processor position with a DPA, and the encryption and access controls a compliance programme is built on.';

const have = [
  { icon: 'globe', title: 'Private by default', body: 'Recordings and documents live in private storage behind short-lived signed links, with access control you can point to in a review.' },
  { icon: 'lock', title: 'Encryption controls', body: 'End-to-end encryption for meetings (media + chat), encrypted transport everywhere, plus access control, NDA gating and audit logging.' },
  { icon: 'doc', title: 'GDPR & a DPA', body: 'We operate as a data processor for the metadata and content we handle, with a data-processing agreement covering sub-processors, residency, retention and breach notification.' },
  { icon: 'shield', title: 'Audit trails', body: 'Deal rooms and recordings carry access logs — who joined, who viewed, who downloaded — reviewable by design.' },
];

const roadmap = [
  { status: 'now', title: 'GDPR data-processor posture + DPA', body: 'Available today for the hosted service.' },
  { status: 'now', title: 'Security whitepaper', body: 'A review-ready document describing exactly what is protected and how — available on request.' },
  { status: 'next', title: 'Independent security audit', body: 'An independent third-party audit of our platform, deployment and the meeting end-to-end path is our top security investment as we bring on regulated customers.' },
  { status: 'next', title: 'SOC 2 Type 1', body: 'Our first formal certification target as we land regulated customers.' },
  { status: 'later', title: 'ISO 27001 & sector schemes', body: 'ISO 27001 and sector-specific schemes follow, prioritised by the industries we serve.' },
];

const faq = [
  { q: 'What does Ollasync provide for a compliance programme?', a: 'The technical controls and a DPA that a compliance programme is built on — encryption in transit with end-to-end encryption available, role-based access control and audit logging.' },
  { q: 'Can Ollasync support a HIPAA or GDPR programme?', a: 'Yes — as controls, not a certificate. Encryption, end-to-end encryption, access control, audit logging and a DPA give your programme what it needs.' },
  { q: 'Who are your sub-processors?', a: 'For the hosted service, sub-processors and their roles are listed in the DPA, available for your legal review.' },
  { q: 'Can we get the security whitepaper and DPA?', a: 'Yes. Both are available on request for your security and legal review — just contact us.' },
];
---
<Base title={title} description={description}>
  <PageHero
    eyebrow="Compliance & data protection"
    eyebrowIcon="shield-check"
    crumbs={[{ label: 'Compliance' }]}
    title="Built for your"
    titleAccent="compliance programme"
    lead="Serious buyers reward a vendor who draws the line clearly. Here’s exactly what we offer today for your compliance programme, and what’s on the roadmap"
  />

  <section class="section" style="padding-top:32px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Today</span>
        <h2 class="h2" style="margin-top:12px">What we give your programme now</h2>
      </div>
      <div class="grid grid-4" data-reveal>
        {have.map((h) => (
          <div class="card card--hover">
            <div class="card__icon card__icon--teal"><Icon name={h.icon} size={20} /></div>
            <h3 class="h3">{h.title}</h3>
            <p>{h.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:12px">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow-label">Certification roadmap</span>
        <h2 class="h2" style="margin-top:12px">Where we’re headed, in order</h2>
        <p class="kicker" style="margin-top:14px">We publish the roadmap rather than imply a status. Design partners move it forward.</p>
      </div>
      <div class="road" data-reveal>
        {roadmap.map((r) => (
          <div class={`road__item road__item--${r.status}`}>
            <span class="road__badge mono">{r.status === 'now' ? 'Available' : r.status === 'next' ? 'In progress' : 'Planned'}</span>
            <h3 style="font-size:17px;font-weight:600;margin-top:10px">{r.title}</h3>
            <p class="muted" style="font-size:14px;margin-top:6px">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq items={faq} title="Compliance questions" />
  <Cta
    title="Bring us your security review."
    sub="Request the security whitepaper and DPA for your legal and compliance teams, or bring your questions to a call."
    primary={{ label: 'Request whitepaper & DPA', href: '/contact' }}
    secondary={{ label: 'Read the security model', href: '/security' }}
  />
</Base>

<style>
  .road { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .road__item { border: 1px solid var(--line); border-radius: var(--r); padding: 20px; background: var(--bg-2); }
  .road__item--now { border-color: var(--teal-150); background: linear-gradient(180deg, var(--teal-050), transparent); }
  .road__badge { font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .road__item--now .road__badge { color: var(--teal); }
  @media (max-width: 1000px) { .road { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .road { grid-template-columns: 1fr; } }
</style>
