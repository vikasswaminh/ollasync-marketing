---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../consts';

const title = 'Developers — API, SDKs & webhooks';
const description =
  'Build meetings into your own product with the Ollasync REST API, official Go, Python and TypeScript SDKs, webhooks with a delivery log, and an OpenAPI spec.';

const blocks = [
  { icon: 'route', title: 'REST API', body: 'Create meetings, mint short-lived room tokens and manage your workspace over a clean, predictable HTTP API.' },
  { icon: 'doc', title: 'OpenAPI spec', body: 'A machine-readable OpenAPI description of every endpoint — generate your own client or explore it interactively.' },
  { icon: 'layers', title: 'Official SDKs', body: 'First-party clients for Go, Python and TypeScript, plus a Postman collection to get moving in minutes.' },
  { icon: 'broadcast', title: 'Webhooks', body: 'Subscribe to what happens — members joining, recordings finishing — with signed deliveries and a per-event delivery log you can replay.' },
  { icon: 'key', title: 'Scoped API keys', body: 'Issue keys scoped to exactly what an integration needs, shown once at creation, revocable any time.' },
  { icon: 'shield-check', title: 'Token-based join', body: 'Mint room tokens server-side and drop participants straight into a meeting from your own app.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: SITE.url + '/developers',
};
---
<Base title={title} description={description} schema={schema}>
  <section class="section" style="padding-top:64px;padding-bottom:24px">
    <div class="container" style="max-width:820px;text-align:center;margin-inline:auto">
      <span class="eyebrow" data-reveal style="justify-content:center"><Icon name="layers" size={13} stroke="var(--blue)" /> Developers</span>
      <h1 class="display" data-reveal style="margin-top:20px">Build meetings into <span class="gradient-text">your own product</span></h1>
      <p class="lead" data-reveal style="margin-top:20px;margin-inline:auto;max-width:60ch">
        Mint room tokens, spin up meetings and react to what happens with a clean REST API, official SDKs and
        webhooks — all documented with OpenAPI. Ship video into your app without running an SFU yourself.
      </p>
      <div class="hero__cta" data-reveal style="justify-content:center;margin-top:28px">
        <a href="/docs" class="btn btn-primary">Read the docs <span class="arrow">→</span></a>
        <a href={SITE.appUrl} class="btn btn-ghost">Get an API key</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:20px">
    <div class="container">
      <div class="grid grid-3" data-reveal>
        {blocks.map((b) => (
          <div class="card card--hover">
            <div class="card__icon"><Icon name={b.icon} size={20} /></div>
            <h3 class="h3">{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="container dev-split">
      <div data-reveal>
        <span class="eyebrow-label">Quick start</span>
        <h2 class="h2" style="margin-top:12px">Create a meeting, get a join link</h2>
        <p class="lead" style="margin-top:14px;max-width:46ch">Authenticate with a scoped API key, create a meeting and mint a token — your participant joins from any browser, no download.</p>
        <ul class="dev-list">
          <li><span class="tick"><Icon name="check" size={12} stroke="var(--teal)" /></span>Server-side token minting</li>
          <li><span class="tick"><Icon name="check" size={12} stroke="var(--teal)" /></span>Go · Python · TypeScript SDKs</li>
          <li><span class="tick"><Icon name="check" size={12} stroke="var(--teal)" /></span>Bulk token minting for large sessions</li>
        </ul>
      </div>
      <div class="panel code-panel" data-reveal aria-hidden="true">
        <div class="code-panel__bar mono">POST /v1/account/meetings</div>
        <pre class="code-panel__pre mono"><code>curl -X POST {SITE.appUrl}/v1/account/meetings \
  -H "X-API-Key: $OLLASYNC_API_KEY" \
  -H "Content-Type: application/json" \
  -d {'{'}"title":"Board review"{'}'}

{'{'}
  "room": "mtg-cddb48fea7",
  "join_url": "{SITE.appUrl}/j/mtg-cddb48fea7"
{'}'}</code></pre>
      </div>
    </div>
  </section>

  <Cta title="Start building" sub="Grab an API key from your workspace and create your first meeting in a few lines. Free to start." primary={{ label: 'Get an API key', href: SITE.appUrl }} secondary={{ label: 'Read the docs', href: '/docs' }} />
</Base>

<style>
  .dev-split { display: grid; grid-template-columns: 1fr 1.05fr; gap: 44px; align-items: center; }
  .dev-list { list-style: none; display: grid; gap: 13px; margin-top: 22px; }
  .dev-list li { display: flex; gap: 11px; align-items: center; color: var(--ink-2); font-size: 15px; }
  .dev-list .tick { display: grid; place-items: center; width: 19px; height: 19px; border-radius: 50%; background: var(--teal-150); flex: none; }
  .code-panel { padding: 0; overflow: hidden; }
  .code-panel__bar { padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--muted); background: var(--bg-2); }
  .code-panel__pre { margin: 0; padding: 18px; font-size: 12.5px; line-height: 1.7; color: var(--ink-2); overflow-x: auto; white-space: pre; }
  @media (max-width: 900px) { .dev-split { grid-template-columns: 1fr; gap: 30px; } }
</style>
