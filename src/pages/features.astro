---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const cryptoFeatures = [
  { name: "X3DH Key Agreement", status: "Complete", desc: "Signal Protocol X3DH with x25519-dalek (RFC 7748)" },
  { name: "Double Ratchet", status: "Complete", desc: "ChaCha20-Poly1305 AEAD with KDF chaining" },
  { name: "Ed25519 Signatures", status: "Complete", desc: "RFC 8032 compliant with ed25519-dalek" },
  { name: "HKDF-SHA256", status: "Complete", desc: "Domain-separated key derivation" },
  { name: "Memory Zeroization", status: "Complete", desc: "zeroize crate for secure memory wiping" },
  { name: "MAX_SKIP Protection", status: "Complete", desc: "DoS prevention with 1000 message limit" },
];

const backendFeatures = [
  { name: "QUIC Gateway", desc: "UDP port 4433 with mandatory mTLS and rate limiting" },
  { name: "Key Server", desc: "JWT auth, prekey upload/fetch, atomic consumption" },
  { name: "Message Router", desc: "NATS integration, offline storage, TTL cleanup" },
  { name: "Media Server", desc: "MinIO storage, path traversal protection, API key auth" },
];

const observabilityFeatures = [
  { name: "Prometheus Metrics", desc: "HTTP, message, crypto, security metrics" },
  { name: "Grafana Dashboards", desc: "4 pre-built dashboards for system, messages, security, crypto" },
  { name: "Alertmanager", desc: "10 alert rules for critical conditions" },
  { name: "Structured Logging", desc: "JSON format with request ID correlation" },
];
---

<Layout title="Features - Quick Messaging">
  <div class="py-24 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Feature Overview
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          Complete feature list based on actual codebase. 100+ features across cryptography, backend, and infrastructure.
        </p>
      </div>
      
      <!-- Cryptography Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <svg class="w-6 h-6 text-primary-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          Cryptographic Features (11)
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {cryptoFeatures.map((feature) => (
            <div class="p-4 bg-slate-800 rounded-lg border border-slate-700">
              <div class="flex items-center justify-between mb-2">
                <span class="font-medium text-white">{feature.name}</span>
                <span class="text-xs px-2 py-1 bg-emerald-500/20 text-emerald-400 rounded">{feature.status}</span>
              </div>
              <p class="text-sm text-slate-400">{feature.desc}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Backend Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <svg class="w-6 h-6 text-primary-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 01-2 2v4a2 2 0 012 2h14a2 2 0 012-2v-4a2 2 0 01-2-2m-2-4h.01M17 16h.01"></path>
          </svg>
          Backend Services (4)
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {backendFeatures.map((service) => (
            <div class="p-4 bg-slate-800 rounded-lg border border-slate-700">
              <h3 class="font-medium text-white mb-1">{service.name}</h3>
              <p class="text-sm text-slate-400">{service.desc}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Observability Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <svg class="w-6 h-6 text-primary-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          Observability (25+ features)
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {observabilityFeatures.map((item) => (
            <div class="p-4 bg-slate-800 rounded-lg border border-slate-700">
              <h3 class="font-medium text-white mb-1">{item.name}</h3>
              <p class="text-sm text-slate-400">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Architecture Diagram -->
      <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
        <h2 class="text-2xl font-bold text-white mb-6">Architecture Overview</h2>
        <pre class="text-sm font-mono text-slate-300 overflow-x-auto">
┌──────────┐     QUIC/UDP 4433      ┌──────────┐
│  Android  │◄──────────────────────►│  Gateway │
│   Client  │    (mTLS required)     │  Server  │
└──────────┘                        └─────┬────┘
                                          │
                    ┌─────────────────────┼─────────────────────┐
                    │                     │                     │
              ┌─────▼────┐          ┌─────▼────┐          ┌────▼───┐
              │ Key      │          │ Message  │          │ Media  │
              │ Server   │          │ Router   │          │ Server │
              └─────┬────┘          └─────┬────┘          └───┬────┘
                    │                     │                     │
              ┌─────▼─────────────────────▼─────────────────────▼────┐
              │                                                      │
              │   TiKV (Keys)    NATS (Messages)    MinIO (Files)   │
              │                                                      │
              └──────────────────────────────────────────────────────┘
        </pre>
      </div>
    </div>
  </div>
  
  <Footer />
</Layout>
